---
import Logo from './Logo.astro';
import Character from './Character.astro';
import { accountHref } from '@/lib/enroll';

const { site, locations, locationById } = Astro.locals.content;
const hq = locationById('hq') ?? locations[0];
const year = new Date().getFullYear();
// The email breaks before the @ when it must, never in the middle of a word.
const [emailUser, emailDomain] = site.contact.email.split('@');
---

<footer class="site-footer">
  <div class="curtain-call" aria-hidden="true">
    <Character name="professor" size={70} />
    <Character name="royal" size={78} />
    <Character name="dancer" size={66} />
    <Character name="magician" size={72} />
    <Character name="artist" size={68} />
  </div>

  <div class="wrap">
    <div class="site-footer__top">
      <div class="site-footer__brand stack">
        <Logo tone="light" />
        <p>Encouraging creative hearts through theater. Classes, camps and shows for ages 4 to 100, since {site.founded}.</p>
        <address class="site-footer__contact">
          <span class="site-footer__place">
            <strong>{hq.name}</strong>
            {hq.address.map((line) => <span>{line}</span>)}
          </span>
          <a href={site.contact.phoneHref}>{site.contact.phone}</a>
          <a class="site-footer__email" href={`mailto:${site.contact.email}`}>
            {emailUser}<wbr />@{emailDomain}
          </a>
        </address>
        <div class="socials">
          {site.social.instagram && <a href={site.social.instagram} rel="noopener">Instagram</a>}
          {site.social.facebook && <a href={site.social.facebook} rel="noopener">Facebook</a>}
        </div>
      </div>

      <nav class="site-footer__col" aria-labelledby="footer-programs">
        <h2 id="footer-programs">Programs</h2>
        <ul>
          <li><a href="/programs?kind=class">Weekly classes</a></li>
          <li><a href="/camps">Camps & workshops</a></li>
          <li><a href="/events">Shows & events</a></li>
          <li><a href="/programs/free-community-class">Free community class</a></li>
          <li><a href="/programs/parents-night-out">Parents’ Night Out</a></li>
          <li><a href="/programs/parties">Parties</a></li>
          <li><a href="/geode">Geode: tweens, teens & adults</a></li>
        </ul>
      </nav>

      <nav class="site-footer__col" aria-labelledby="footer-about">
        <h2 id="footer-about">About</h2>
        <ul>
          <li><a href="/about">Our story</a></li>
          <li><a href="/about/team">Team</a></li>
          <li><a href="/about/schools">Schools & partners</a></li>
          <li><a href="/faq">Parent FAQ</a></li>
          <li><a href="/contact">Contact</a></li>
        </ul>
      </nav>

      <nav class="site-footer__col" aria-labelledby="footer-families">
        <h2 id="footer-families">Families</h2>
        <ul>
          <li><a href={accountHref()}>Family login</a></li>
          <li><a href="/contact#parking">Parking & drop-off</a></li>
          <li><a href="/give">Give to the scholarship fund</a></li>
          <li><a href="/policies">Policies & privacy</a></li>
        </ul>
      </nav>
    </div>

    <div class="site-footer__bottom">
      <p>© {year} Little Characters Theater Troupe, LLC</p>
      <p>Scholarships are always available. <a href="/give">Help fund one.</a></p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--stage);
    color: var(--on-stage-mute);
    padding-bottom: var(--space-xl);
  }
  .curtain-call {
    display: flex;
    justify-content: center;
    align-items: flex-end;
    gap: clamp(0.5rem, 2vw, 1.5rem);
    padding-top: var(--space-2xl);
    border-bottom: 3px solid var(--stage-line);
    margin-bottom: var(--space-2xl);
    overflow: hidden;
  }
  .curtain-call :global(.character) { margin-bottom: -3px; }
  .site-footer__top {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) repeat(3, minmax(0, 1fr));
    gap: var(--space-xl);
  }
  .site-footer__brand p { max-width: 34ch; }
  .site-footer__contact {
    display: grid;
    gap: 0.4rem;
    justify-items: start;
    font-style: normal;
    font-size: 1.05rem;
    line-height: 1.45;
    color: var(--on-stage);
  }
  .site-footer__place { display: grid; margin-bottom: 0.3rem; }
  .site-footer__place strong { font-weight: 650; }
  .site-footer__place span { color: var(--on-stage-mute); }
  .site-footer .site-footer__email { overflow-wrap: normal; word-break: normal; }
  .site-footer h2 {
    font-size: 1rem;
    font-stretch: 90%;
    letter-spacing: 0.02em;
    color: var(--on-stage);
    margin-bottom: var(--space-m);
  }
  .site-footer ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.55rem; }
  .site-footer a { color: var(--on-stage); text-decoration-color: var(--stage-line); }
  .site-footer a:hover { color: var(--orange); }
  .socials { display: flex; gap: var(--space-m); }
  .site-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-s);
    margin-top: var(--space-2xl);
    padding-top: var(--space-l);
    border-top: 1px solid var(--stage-line);
    font-size: var(--step--1);
  }
  @media (max-width: 1100px) {
    .site-footer__top { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    /* The brand and contact block spans the row: logo, line and socials on the left, the address on the right. */
    .site-footer__brand {
      grid-column: 1 / -1;
      display: grid;
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
      grid-template-areas: 'logo contact' 'text contact' 'social contact';
      gap: var(--space-m) var(--space-xl);
      align-items: start;
    }
    .site-footer__brand > :global(*) { margin: 0; }
    .site-footer__brand > :global(:nth-child(1)) { grid-area: logo; }
    .site-footer__brand > :global(:nth-child(2)) { grid-area: text; }
    .site-footer__brand > :global(:nth-child(3)) { grid-area: contact; }
    .site-footer__brand > :global(:nth-child(4)) { grid-area: social; }
  }
  @media (max-width: 700px) {
    .site-footer__top { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
  }
  @media (max-width: 520px) {
    .site-footer__top { grid-template-columns: minmax(0, 1fr); }
    .site-footer__brand { grid-template-columns: minmax(0, 1fr); grid-template-areas: 'logo' 'text' 'contact' 'social'; }
  }
</style>
