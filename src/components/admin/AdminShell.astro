---
/**
 * Frame for the staff pages (docs/back-office.md → The staff shell): sign-in
 * for staff who aren't signed in, a "not here" for everyone else, and the
 * staff navigation.
 *
 * Computer: a top bar with the sections, a search box and Sign out.
 * Phone: the page title (with an optional back link) at the top, a short menu,
 * and a tab bar at the bottom: Today, Classes, Search, Alerts. The installed
 * app has no browser back button, so pages below a list pass `back`.
 */
import Base from '@/layouts/Base.astro';
import SignInPanel from '@/components/portal/SignInPanel.astro';
import * as links from '@/lib/admin-links';
import '@/styles/admin.css';

export type StaffSection = 'today' | 'classes' | 'families' | 'payments' | 'leads' | 'content';

interface Props {
  title: string;
  /** Which staff section this page belongs to. */
  section?: StaffSection;
  /** The page wants every bit of width (the editor). */
  wide?: boolean;
  /** Phones: a link back up, like { href: links.classes(), label: 'Classes' }. */
  back?: { href: string; label: string };
  /** The sign-in shown to signed-out visitors, when the page needs other words. */
  signIn?: { heading: string; intro: string };
}
const { title, section = 'content', wide = false, back, signIn = { heading: 'Staff sign-in', intro: 'Enter your staff email and we’ll send you a 6-digit code.' } } = Astro.props;
const { user, isAdmin } = Astro.locals;
const path = Astro.url.pathname;
const here = path + Astro.url.search;
const q = path.startsWith('/admin/search') ? (Astro.url.searchParams.get('q') ?? '') : '';

const sections: { key: StaffSection; label: string; href: string }[] = [
  { key: 'today', label: 'Today', href: links.today() },
  { key: 'classes', label: 'Classes', href: links.classes() },
  { key: 'families', label: 'Families', href: links.search() },
  { key: 'payments', label: 'Payments', href: links.payments() },
  { key: 'leads', label: 'Messages & sign-ups', href: links.leads() },
  { key: 'content', label: 'Website', href: links.content() },
];

// Phone tab bar. The current tab follows the address, so Search stays lit on a family's page.
const tab = path.startsWith('/admin/attention')
  ? 'alerts'
  : path.startsWith('/admin/search') || path.startsWith('/admin/families')
    ? 'search'
    : path.startsWith('/admin/classes')
      ? 'classes'
      : path === '/admin' || path === '/admin/'
        ? 'today'
        : null;
const tabs = [
  { key: 'today', label: 'Today', href: links.today(), icon: 'M4 11.5 12 5l8 6.5V20h-5v-5h-6v5H4z' },
  { key: 'classes', label: 'Classes', href: links.classes(), icon: 'M4 6h16M4 12h16M4 18h10' },
  { key: 'search', label: 'Search', href: links.search(), icon: 'M10.5 17a6.5 6.5 0 1 1 0-13 6.5 6.5 0 0 1 0 13zM15.5 15.5 20 20' },
  { key: 'alerts', label: 'Alerts', href: links.attention(), icon: 'M12 4a5 5 0 0 0-5 5v3.5L5 16h14l-2-3.5V9a5 5 0 0 0-5-5zM10 19a2 2 0 0 0 4 0' },
];
const more = [
  { key: 'families', label: 'Families', href: links.search() },
  { key: 'payments', label: 'Payments', href: links.payments() },
  { key: 'leads', label: 'Messages & sign-ups', href: links.leads() },
  { key: 'content', label: 'Website', href: links.content() },
];
---

<Base title={title} noindex staffBar={false} chrome={false} themeColor="#1c1826">
  <Fragment slot="head">
    <link rel="manifest" href="/admin/app.webmanifest" />
    <link rel="apple-touch-icon" href="/admin/icons/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="LC Staff" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
  </Fragment>
  {
    !isAdmin ? (
      <>
        <header class="staff-top staff-top--gate">
          <div class="staff-top__row">
            <a class="staff-brand" href="/">
              <img src="/admin/icons/icon-192.png" width="32" height="32" alt="" />
              <span>Little Characters <span class="staff-brand__sub">Staff</span></span>
            </a>
          </div>
        </header>
        <section class="wrap wrap--narrow gate">
          {user ? (
            <div class="stack">
              <h1>Staff only</h1>
              <p>You’re signed in as {user.email}, which isn’t a staff account. Sign out, then sign in with your staff email.</p>
              <form method="post" action="/account/sign-out">
                <button class="btn btn--outline" type="submit">
                  Sign out
                </button>
              </form>
            </div>
          ) : (
            <SignInPanel heading={signIn.heading} intro={signIn.intro} next={here} />
          )}
        </section>
      </>
    ) : (
      <div class:list={['admin-shell', { 'admin-shell--wide': wide }]} data-staff-shell>
        <header class="staff-top">
          <div class="staff-top__row">
            <a class="staff-brand" href={links.today()}>
              <img src="/admin/icons/icon-192.png" width="32" height="32" alt="" />
              <span>Little Characters <span class="staff-brand__sub">Staff</span></span>
            </a>
            <form class="staff-search" role="search" action="/admin/search" method="get" data-staff-search>
              <label class="sr-only" for="staff-q">Search families, children and classes</label>
              <input id="staff-q" name="q" type="search" value={q} placeholder="Search families, children, classes" autocomplete="off" />
              <button type="submit">Search</button>
            </form>
            <div class="staff-account">
              <span class="staff-account__email">{user!.email}</span>
              <form method="post" action="/account/sign-out">
                <button type="submit" class="staff-signout">Sign out</button>
              </form>
            </div>
          </div>
          <nav class="staff-sections" aria-label="Staff">
            <ul>
              {sections.map((s) => (
                <li>
                  <a href={s.href} aria-current={s.key === section ? 'page' : undefined}>
                    {s.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
          {/* Phones: the page title, a way back, and the short menu. */}
          <div class="staff-phonebar">
            {back ? (
              <a class="staff-phonebar__back" href={back.href} data-staff-back>
                <span aria-hidden="true">‹</span> {back.label}
              </a>
            ) : (
              <img class="staff-phonebar__mark" src="/admin/icons/icon-192.png" width="28" height="28" alt="" />
            )}
            <p class="staff-phonebar__title" aria-hidden="true">{title}</p>
            <details class="staff-menu" data-staff-menu>
              <summary>Menu</summary>
              <div class="staff-menu__panel">
                <ul>
                  {more.map((m) => (
                    <li>
                      <a href={m.href} aria-current={m.key === section ? 'page' : undefined}>
                        {m.label}
                      </a>
                    </li>
                  ))}
                  <li>
                    <a href={links.install()}>Put the app on your phone</a>
                  </li>
                </ul>
                <p class="staff-menu__who">Signed in as {user!.email}</p>
                <form method="post" action="/account/sign-out">
                  <button type="submit" class="btn btn--outline btn--block">Sign out</button>
                </form>
              </div>
            </details>
          </div>
        </header>
        {section === 'content' && <p class="staff-hint" role="note">The website editor works best on a computer.</p>}
        <slot />
        <nav class="staff-tabs" aria-label="Staff, on a phone">
          <ul>
            {tabs.map((t) => (
              <li>
                <a href={t.href} aria-current={t.key === tab ? 'page' : undefined}>
                  <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d={t.icon} />
                  </svg>
                  <span>{t.label}</span>
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    )
  }
</Base>

<script>
  // The phone menu closes when you tap outside it or press Escape.
  for (const menu of document.querySelectorAll<HTMLDetailsElement>('[data-staff-menu]')) {
    document.addEventListener('click', (e) => {
      if (menu.open && !menu.contains(e.target as Node)) menu.open = false;
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && menu.open) {
        menu.open = false;
        menu.querySelector('summary')?.focus();
      }
    });
  }
</script>

<style>
  .gate { padding-block: var(--space-2xl) var(--space-3xl); }
  .admin-shell { --admin-max: 1100px; }
  .admin-shell--wide { --admin-max: 1280px; }
</style>
