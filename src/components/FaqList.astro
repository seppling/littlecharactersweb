---
import type { Faq } from '@/data/types';

interface Props {
  items: Faq[];
}
const { items } = Astro.props;
---

<div class="faqs">
  {
    items.map((f) => (
      <details class="faq">
        <summary>
          <span>{f.q}</span>
          <span class="faq__icon" aria-hidden="true" />
        </summary>
        <p>{f.a}</p>
      </details>
    ))
  }
</div>

<style>
  .faqs { border-top: 2px solid var(--ink); }
  .faq { border-bottom: 1.5px solid var(--line-strong); }
  summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 1.1rem 0.25rem;
    cursor: pointer;
    list-style: none;
    font-family: var(--font-display);
    font-weight: 700;
    font-stretch: 92%;
    font-size: var(--step-1);
    line-height: 1.25;
  }
  summary::-webkit-details-marker { display: none; }
  summary:hover span:first-child { text-decoration: underline; text-decoration-color: var(--orange); text-decoration-thickness: 3px; }
  .faq__icon {
    flex: none;
    position: relative;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--hall);
  }
  .faq__icon::before, .faq__icon::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 12px;
    height: 2.5px;
    background: var(--ink);
    border-radius: 2px;
    transform: translate(-50%, -50%);
    transition: transform 180ms var(--ease);
  }
  .faq__icon::after { transform: translate(-50%, -50%) rotate(90deg); }
  .faq[open] .faq__icon { background: var(--orange); }
  .faq[open] .faq__icon::after { transform: translate(-50%, -50%) rotate(0deg); }
  .faq p { padding: 0 0.25rem 1.3rem; color: var(--ink-soft); max-width: var(--measure); }
</style>
