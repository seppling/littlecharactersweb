---
/**
 * The "little characters": a small cast of shape-people in gel colors, each
 * with a costume prop. Used where a photo isn't needed (or doesn't exist yet)
 * and as the brand's illustration system.
 */
import type { CharacterName, Gel } from '@/data/types';

interface Props {
  name: CharacterName;
  gel?: Gel;
  size?: number | string;
  class?: string;
  style?: string;
}

const defaults: Record<CharacterName, Gel> = {
  royal: 'red',
  magician: 'teal',
  artist: 'orange',
  professor: 'yellow',
  dancer: 'purple',
};

const { name, gel = defaults[name], size = 120, class: className = '', style } = Astro.props;
const fill = `var(--${gel})`;
const ink = gel === 'purple' ? 'var(--paper)' : 'var(--ink)';
---

<svg
  class:list={['character', `character--${name}`, className]}
  style={style}
  width={size}
  viewBox="0 0 120 150"
  aria-hidden="true"
  focusable="false"
>
  {
    name === 'royal' && (
      <g>
        <circle cx="60" cy="95" r="45" fill={fill} />
        <polygon points="36,56 42,32 52,47 60,26 68,47 78,32 84,56" fill="var(--orange)" />
        <circle cx="60" cy="27" r="3.5" fill="var(--red-ink)" />
        <circle cx="46" cy="88" r="5" fill={ink} />
        <circle cx="74" cy="88" r="5" fill={ink} />
        <circle cx="37" cy="100" r="5.5" fill="var(--paper)" opacity="0.35" />
        <circle cx="83" cy="100" r="5.5" fill="var(--paper)" opacity="0.35" />
        <path d="M50 102 Q60 112 70 102" stroke={ink} stroke-width="4" stroke-linecap="round" fill="none" />
      </g>
    )
  }
  {
    name === 'magician' && (
      <g>
        <rect x="34" y="40" width="52" height="100" rx="26" fill={fill} />
        <rect x="38" y="4" width="44" height="32" rx="3" fill={ink} />
        <rect x="38" y="25" width="44" height="6" fill="var(--red)" />
        <rect x="24" y="33" width="72" height="8" rx="4" fill={ink} />
        <circle cx="50" cy="72" r="4.5" fill={ink} />
        <circle cx="70" cy="72" r="4.5" fill={ink} />
        <path d="M52 85 Q60 92 68 85" stroke={ink} stroke-width="3.5" stroke-linecap="round" fill="none" />
      </g>
    )
  }
  {
    name === 'artist' && (
      <g>
        <polygon points="60,46 104,136 16,136" fill={fill} stroke={fill} stroke-width="10" stroke-linejoin="round" />
        <g transform="rotate(-14 60 40)">
          <ellipse cx="60" cy="40" rx="23" ry="8" fill={ink} />
          <circle cx="60" cy="31" r="3.5" fill={ink} />
        </g>
        <circle cx="50" cy="102" r="4.5" fill={ink} />
        <circle cx="70" cy="102" r="4.5" fill={ink} />
        <ellipse cx="60" cy="118" rx="6" ry="5" fill={ink} />
      </g>
    )
  }
  {
    name === 'professor' && (
      <g>
        <rect x="16" y="56" width="88" height="84" rx="20" fill={fill} />
        <circle cx="46" cy="90" r="4.5" fill={ink} />
        <circle cx="74" cy="90" r="4.5" fill={ink} />
        <circle cx="46" cy="90" r="11" stroke={ink} stroke-width="3.5" fill="none" />
        <circle cx="74" cy="90" r="11" stroke={ink} stroke-width="3.5" fill="none" />
        <path d="M57 89 Q60 86 63 89" stroke={ink} stroke-width="3.5" fill="none" stroke-linecap="round" />
        <path d="M50 112 Q60 119 70 112" stroke={ink} stroke-width="4" stroke-linecap="round" fill="none" />
        <path d="M44 140 L60 128 L76 140 Z" fill="var(--red)" />
      </g>
    )
  }
  {
    name === 'dancer' && (
      <g>
        <path d="M14 140 A46 46 0 0 1 106 140 Z" fill={fill} />
        <path d="M60 94 L42 82 L42 106 Z" fill="var(--red)" />
        <path d="M60 94 L78 82 L78 106 Z" fill="var(--red)" />
        <circle cx="60" cy="94" r="5" fill="var(--red-ink)" />
        <path d="M44 118 Q48 114 52 118" stroke={ink} stroke-width="3.5" stroke-linecap="round" fill="none" />
        <path d="M68 118 Q72 114 76 118" stroke={ink} stroke-width="3.5" stroke-linecap="round" fill="none" />
        <path d="M53 127 Q60 134 67 127" stroke={ink} stroke-width="3.5" stroke-linecap="round" fill="none" />
      </g>
    )
  }
</svg>

<style>
  .character {
    height: auto;
    overflow: visible;
    transform-origin: 50% 100%;
  }
</style>
