---
/**
 * The Little Characters logo. On light backgrounds we use the full lockup
 * (its wordmark is black); on the dark footer we pair the four-color mark
 * with live text so it stays readable.
 */
import { Image } from 'astro:assets';
import lockup from '@/assets/brand/logo-horizontal.webp';
import mark from '@/assets/brand/logo-mark.png';

interface Props {
  tone?: 'ink' | 'light';
}
const { tone = 'ink' } = Astro.props;
---

<a href="/" class:list={['logo', `logo--${tone}`]} aria-label="Little Characters Theater Troupe, home">
  {
    tone === 'ink' ? (
      <Image src={lockup} alt="" class="logo__lockup" widths={[190, 380, 570]} sizes="190px" loading="eager" />
    ) : (
      <>
        <Image src={mark} alt="" class="logo__mark" widths={[48, 96, 144]} sizes="48px" />
        <span class="logo__text">
          <span class="logo__name">Little Characters</span>
          <span class="logo__sub">Theater Troupe</span>
        </span>
      </>
    )
  }
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    color: var(--ink);
    flex: none;
  }
  .logo__lockup { width: 190px; height: auto; }
  .logo--light { color: var(--on-stage); }
  .logo__mark { width: 48px; height: 48px; transition: transform 200ms var(--ease); }
  .logo:hover .logo__mark { transform: rotate(-8deg); }
  .logo__text { display: grid; line-height: 1; }
  .logo__name {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.1rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .logo__sub {
    font-size: 0.72rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    margin-top: 0.35rem;
    opacity: 0.8;
  }
  @media (max-width: 480px) {
    .logo__lockup { width: 150px; }
  }
</style>
