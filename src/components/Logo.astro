---
/**
 * The Little Characters logo. On light backgrounds we use the full lockup
 * (its wordmark is black); on the dark footer we pair the four-color mark
 * with live text so it stays readable.
 */
import { resolveImage } from '@/lib/media';

interface Props {
  tone?: 'ink' | 'light';
}
const { tone = 'ink' } = Astro.props;
// Resized at build time, like the other built-in photos (src/lib/media.ts).
const lockup = resolveImage({ src: 'builtin:brand/logo-horizontal' }, new Map(), 380)!;
const mark = resolveImage({ src: 'builtin:brand/logo-mark' }, new Map(), 96)!;
---

<a href="/" class:list={['logo', `logo--${tone}`]} aria-label="Little Characters Theater Troupe, home">
  {
    tone === 'ink' ? (
      <img src={lockup.src} srcset={lockup.srcset} sizes="190px" width={lockup.width} height={lockup.height} alt="" class="logo__lockup" />
    ) : (
      <>
        <img src={mark.src} srcset={mark.srcset} sizes="48px" width={mark.width} height={mark.height} alt="" class="logo__mark" loading="lazy" />
        <span class="logo__text">
          <span class="logo__name">Little Characters</span>
          <span class="logo__sub">Theater Troupe</span>
        </span>
      </>
    )
  }
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    color: var(--ink);
    flex: none;
  }
  .logo__lockup { width: 190px; height: auto; }
  .logo--light { color: var(--on-stage); }
  .logo__mark { width: 48px; height: 48px; transition: transform 200ms var(--ease); }
  .logo:hover .logo__mark { transform: rotate(-8deg); }
  .logo__text { display: grid; line-height: 1; }
  .logo__name {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.1rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .logo__sub {
    font-size: 0.72rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    margin-top: 0.35rem;
    opacity: 0.8;
  }
  @media (max-width: 480px) {
    .logo__lockup { width: 150px; }
  }
</style>
