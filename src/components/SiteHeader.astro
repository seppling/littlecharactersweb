---
import Logo from './Logo.astro';
import AccountLink from './AccountLink.astro';
import { nav } from '@/config/site';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => {
  const base = href.split('?')[0];
  if (base === '/programs') return path.startsWith('/programs');
  return path === base || path.startsWith(`${base}/`);
};
/** A link in a dropdown is the current page only on that exact page. */
const isPage = (href: string) => path === href;
/** A dropdown is marked when you're on any page in it. */
const inGroup = (children: { href: string }[]) => children.some((c) => isCurrent(c.href));
const menuId = (label: string) => `nav-${label.toLowerCase().replace(/[^a-z]+/g, '-')}`;
---

<header class="site-header">
  <div class="wrap site-header__inner">
    <Logo />

    <nav class="site-nav" aria-label="Main">
      <ul>
        {
          nav.map((item) =>
            item.children ? (
              <li class="site-nav__group" data-nav-group>
                <button type="button" class="site-nav__toggle" aria-expanded="false" aria-controls={menuId(item.label)} aria-current={inGroup(item.children) ? 'true' : undefined}>
                  {item.label}
                  <svg class="site-nav__chevron" viewBox="0 0 12 8" width="12" height="8" aria-hidden="true">
                    <path d="M1 1.5l5 5 5-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </button>
                <ul class="site-nav__menu" id={menuId(item.label)} hidden>
                  {item.children.map((c) => (
                    <li>
                      <a href={c.href} aria-current={isPage(c.href) ? 'page' : undefined}>
                        {c.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </li>
            ) : (
              <li>
                <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ),
          )
        }
      </ul>
    </nav>

    <div class="site-header__actions">
      <AccountLink />
      <a class="btn btn--primary btn--sm site-header__cta" href="/programs">Find a class</a>
    </div>

    <details class="mobile-nav">
      <summary aria-label="Menu">
        <span class="burger" aria-hidden="true"><span></span><span></span><span></span></span>
        <span class="mobile-nav__label">Menu</span>
      </summary>
      <div class="mobile-nav__panel">
        <ul>
          <li><a href="/programs">Find a class</a></li>
          {
            nav.map((item) =>
              item.children ? (
                <li class="mobile-nav__group">
                  <span class="mobile-nav__group-label" id={`${menuId(item.label)}-m`}>{item.label}</span>
                  <ul aria-labelledby={`${menuId(item.label)}-m`}>
                    {item.children.map((c) => (
                      <li>
                        <a href={c.href} aria-current={isPage(c.href) ? 'page' : undefined}>
                          {c.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                </li>
              ) : (
                <li>
                  <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                    {item.label}
                    {item.note && <small>{item.note}</small>}
                  </a>
                </li>
              ),
            )
          }
        </ul>
        <div class="mobile-nav__account"><AccountLink block /></div>
      </div>
    </details>
  </div>
</header>

<script>
  // The About dropdown: a button that shows and hides a list of links. Escape
  // closes it and puts focus back on the button; so does clicking or tabbing
  // anywhere else. Nothing opens on hover, so it works the same by touch.
  for (const group of document.querySelectorAll<HTMLElement>('[data-nav-group]')) {
    const button = group.querySelector<HTMLButtonElement>('button[aria-controls]')!;
    const menu = document.getElementById(button.getAttribute('aria-controls')!)!;
    const setOpen = (open: boolean) => {
      button.setAttribute('aria-expanded', String(open));
      menu.hidden = !open;
    };
    const isOpen = () => button.getAttribute('aria-expanded') === 'true';
    button.addEventListener('click', () => setOpen(!isOpen()));
    group.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && isOpen()) {
        event.preventDefault();
        setOpen(false);
        button.focus();
      }
    });
    group.addEventListener('focusout', (event) => {
      const next = event.relatedTarget as Node | null;
      if (next && !group.contains(next)) setOpen(false);
    });
    document.addEventListener('click', (event) => {
      if (isOpen() && !group.contains(event.target as Node)) setOpen(false);
    });
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--paper) 94%, transparent);
    backdrop-filter: saturate(1.4) blur(10px);
    border-bottom: 1.5px solid var(--line);
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    gap: var(--space-l);
    min-height: 76px;
  }
  .site-nav { margin-left: auto; }
  .site-nav ul {
    display: flex;
    gap: 0.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .site-nav a {
    display: block;
    padding: 0.55rem 0.8rem;
    border-radius: 999px;
    font-family: var(--font-display);
    font-weight: 650;
    font-stretch: 90%;
    font-size: 1.02rem;
    color: var(--ink);
    text-decoration: none;
    white-space: nowrap;
  }
  .site-nav a:hover { background: var(--hall); }
  .site-nav a[aria-current='page'] {
    background: var(--orange);
  }
  .site-nav__group { position: relative; }
  .site-nav__toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.55rem 0.8rem;
    border: 0;
    border-radius: 999px;
    background: none;
    font-family: var(--font-display);
    font-weight: 650;
    font-stretch: 90%;
    font-size: 1.02rem;
    line-height: inherit;
    color: var(--ink);
    white-space: nowrap;
    cursor: pointer;
  }
  .site-nav__toggle:hover, .site-nav__toggle[aria-expanded='true'] { background: var(--hall); }
  .site-nav__toggle[aria-current] { background: var(--orange); }
  .site-nav__chevron { flex: none; transition: transform 160ms var(--ease); }
  .site-nav__toggle[aria-expanded='true'] .site-nav__chevron { transform: rotate(180deg); }
  .site-nav ul.site-nav__menu {
    position: absolute;
    top: calc(100% + 10px);
    left: 0;
    z-index: 60;
    display: grid;
    gap: 0.15rem;
    min-width: 15rem;
    padding: 0.5rem;
    background: var(--paper);
    border: 1.5px solid var(--line);
    border-radius: var(--r-md);
    box-shadow: var(--shadow-lift);
  }
  .site-nav ul.site-nav__menu[hidden] { display: none; }
  .site-nav__menu a { border-radius: var(--r-sm, 10px); white-space: nowrap; }
  .site-header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-s);
  }

  .mobile-nav { display: none; margin-left: auto; position: relative; }
  .mobile-nav summary {
    list-style: none;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    padding: 0 0.9rem;
    border: 2px solid var(--ink);
    border-radius: 999px;
    cursor: pointer;
    font-family: var(--font-display);
    font-weight: 700;
  }
  .mobile-nav summary::-webkit-details-marker { display: none; }
  .burger { display: grid; gap: 4px; }
  .burger span { display: block; width: 18px; height: 2.5px; background: var(--ink); border-radius: 2px; }
  .mobile-nav[open] .burger span:nth-child(2) { opacity: 0; }
  .mobile-nav__panel {
    position: absolute;
    right: 0;
    top: calc(100% + 12px);
    width: min(92vw, 360px);
    background: var(--paper);
    border: 1.5px solid var(--line);
    border-radius: var(--r-lg);
    box-shadow: var(--shadow-lift);
    padding: var(--space-m);
    max-height: calc(100dvh - 110px);
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  .mobile-nav__panel ul { list-style: none; margin: 0; padding: 0; display: grid; }
  .mobile-nav__panel a {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 0.8rem 0.6rem;
    border-bottom: 1px solid var(--line);
    color: var(--ink);
    text-decoration: none;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.2rem;
    font-stretch: 90%;
  }
  .mobile-nav__group-label {
    display: block;
    padding: 0.9rem 0.6rem 0.2rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-mute);
  }
  .mobile-nav__group ul { list-style: none; margin: 0 0 0 0.6rem; padding: 0 0 0 0.6rem; border-left: 3px solid var(--orange); }
  .mobile-nav__panel .mobile-nav__group a { padding-block: 0.6rem; font-size: 1.08rem; }
  .mobile-nav__panel a[aria-current='page'] { text-decoration: underline; text-decoration-color: var(--orange); text-decoration-thickness: 3px; text-underline-offset: 5px; }
  .mobile-nav__panel small { font-family: var(--font-script); font-weight: 400; font-size: 0.8rem; color: var(--ink-mute); }
  .mobile-nav__account { padding-top: var(--space-m); }

  .site-header__actions { flex: none; }
  @media (max-width: 1180px) {
    /* Seven menu items, the login and the button: tighten the spacing so it all
       stays on one line down to the phone menu at 1000px. */
    .site-header__inner { gap: var(--space-m); }
    .site-nav ul { gap: 0; }
    .site-nav a, .site-nav__toggle { padding-inline: 0.5rem; font-size: 0.98rem; }
    .site-nav__menu a { padding-inline: 0.8rem; }
  }
  @media (max-width: 1000px) {
    .site-nav, .site-header__actions { display: none; }
    .mobile-nav { display: block; }
  }
</style>
