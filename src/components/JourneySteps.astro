---
/**
 * "How enrollment works": the Discovery → Selection → Enrollment → Payment →
 * Confirmation journey, told to parents in plain words. The copy describes the
 * Phase 2 flow; until then the Enroll step hands off to Studio Director.
 */
interface Props {
  current?: 1 | 2 | 3 | 4;
}
const { current } = Astro.props;

const steps = [
  { title: 'Find', body: 'Pick your child’s age and see every class, camp and workshop that fits.' },
  { title: 'Pick a time', body: 'Choose the day and place that work. Spots left are shown up front.' },
  { title: 'Enroll & pay', body: 'Add your student’s details once. Sibling and multi-class discounts apply automatically.' },
  { title: 'You’re in', body: 'Get a confirmation with dates for your calendar, what to bring, and showcase details.' },
];
---

<ol class="journey">
  {
    steps.map((s, i) => (
      <li class="journey__step" aria-current={current === i + 1 ? 'step' : undefined}>
        <span class="journey__num">{i + 1}</span>
        <div>
          <h3>{s.title}</h3>
          <p>{s.body}</p>
        </div>
      </li>
    ))
  }
</ol>

<style>
  .journey {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-l);
    counter-reset: step;
  }
  .journey__step {
    position: relative;
    display: grid;
    gap: 0.75rem;
    align-content: start;
  }
  .journey__step:not(:last-child)::after {
    content: '';
    position: absolute;
    top: 1.35rem;
    left: 3.4rem;
    right: calc(-1 * var(--space-l) + 0.5rem);
    border-top: 2.5px dashed var(--line-strong);
  }
  .journey__num {
    display: grid;
    place-items: center;
    width: 2.7rem;
    height: 2.7rem;
    border-radius: 50%;
    background: var(--paper);
    border: 2.5px solid var(--ink);
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.2rem;
  }
  .journey__step[aria-current='step'] .journey__num { background: var(--amber); }
  h3 { font-size: var(--step-1); font-stretch: 90%; margin-bottom: 0.25rem; }
  p { color: var(--ink-soft); font-size: var(--step--1); line-height: 1.5; }

  @media (max-width: 820px) {
    .journey { grid-template-columns: 1fr 1fr; }
    .journey__step::after { display: none; }
  }
  @media (max-width: 460px) {
    .journey { grid-template-columns: 1fr; }
    .journey__step { grid-template-columns: auto 1fr; gap: 1rem; }
  }
</style>
