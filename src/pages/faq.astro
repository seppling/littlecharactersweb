---
import Base from '@/layouts/Base.astro';
import FaqList from '@/components/FaqList.astro';
import Character from '@/components/Character.astro';
import { faqs } from '@/data/faqs';
import { site } from '@/config/site';

const groups = [...new Set(faqs.map((f) => f.group))];
const slug = (g: string) => g.toLowerCase().replace(/[^a-z]+/g, '-');
---

<Base title="Parent FAQ" description="Answers to common questions about Little Characters classes, camps, payments, discounts and performances.">
  <section class="faq-head">
    <div class="wrap faq-head__inner">
      <div class="stack">
        <p class="eyebrow">Parent handbook</p>
        <h1>Questions parents ask</h1>
        <p class="lede">Can’t find it here? Email <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a> or call <a href={site.contact.phoneHref}>{site.contact.phone}</a>.</p>
      </div>
      <Character name="professor" size={110} />
    </div>
  </section>

  <div class="wrap faq-body">
    <nav class="faq-toc" aria-label="FAQ sections">
      <ul>
        {groups.map((g) => <li><a href={`#${slug(g)}`}>{g}</a></li>)}
      </ul>
    </nav>
    <div class="faq-groups">
      {
        groups.map((g) => (
          <section id={slug(g)} aria-labelledby={`${slug(g)}-title`}>
            <h2 id={`${slug(g)}-title`}>{g}</h2>
            <FaqList items={faqs.filter((f) => f.group === g)} />
          </section>
        ))
      }
    </div>
  </div>
</Base>

<style>
  .faq-head { padding-block: var(--space-2xl); background: var(--hall); }
  .faq-head__inner { display: flex; justify-content: space-between; align-items: end; gap: var(--space-xl); }
  .faq-body { display: grid; grid-template-columns: 14rem minmax(0, 1fr); gap: var(--space-2xl); padding-block: var(--space-2xl) var(--space-3xl); }
  .faq-toc ul { position: sticky; top: 100px; list-style: none; margin: 0; padding: 0; display: grid; gap: 0.3rem; }
  .faq-toc a { display: block; padding: 0.45rem 0.8rem; border-radius: 999px; color: var(--ink); text-decoration: none; font-weight: 600; }
  .faq-toc a:hover { background: var(--amber-tint); }
  .faq-groups { display: grid; gap: var(--space-2xl); max-width: 50rem; }
  .faq-groups h2 { font-size: var(--step-3); margin-bottom: var(--space-m); }
  @media (max-width: 820px) {
    .faq-body { grid-template-columns: 1fr; }
    .faq-toc ul { position: static; display: flex; flex-wrap: wrap; }
    .faq-toc a { border: 1.5px solid var(--line-strong); }
    .faq-head :global(.character) { display: none; }
  }
</style>
