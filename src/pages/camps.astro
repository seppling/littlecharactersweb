---
import LeadFormFields from '@/components/LeadFormFields.astro';
import Base from '@/layouts/Base.astro';
import ProgramCard from '@/components/ProgramCard.astro';
import PhotoFrame from '@/components/PhotoFrame.astro';
import FaqList from '@/components/FaqList.astro';
import Character from '@/components/Character.astro';
import { ageBands } from '@/content/catalog';
import { rich } from '@/content/rich';
import { ageLabel, dateRange } from '@/lib/format';

const { programs, faqs, programBySlug, locationById, vars, pages } = Astro.locals.content;
const page = pages.camps;
const camps = programs.filter((p) => p.kind === 'camp' || p.kind === 'workshop');

// Week-by-week summer grid. It fills itself in once summer sessions labeled
// "Week 1", "Week 2"… are added to a camp in the editor.
type Slot = { program: (typeof camps)[number]; locationId: string };
const weeks = new Map<string, { label: string; start: string; end: string; slots: Slot[] }>();
for (const program of camps) {
  for (const s of program.sessions) {
    if (!s.term.startsWith('Summer') || !s.label?.startsWith('Week')) continue;
    const week = weeks.get(s.label) ?? { label: s.label, start: s.startDate, end: s.endDate, slots: [] };
    week.slots.push({ program, locationId: s.locationId });
    weeks.set(s.label, week);
  }
}
const weekList = [...weeks.values()].sort((a, b) => a.start.localeCompare(b.start));

const campFaqs = faqs.filter((f) => f.group === 'Camps & parties' || f.q.includes('discounts') || f.q.includes('scholarships'));

const summer = programBySlug('summer-camp');
const mini = programBySlug('mini-camps-and-workshops');
const free = programBySlug('free-community-class');
---

<Base
  title="Camps & workshops"
  description="Summer theater camp for ages 4 to 17, holiday mini camps and weekend workshops from Little Characters in Athens, GA."
  seo={page.seo}
  edit="/admin/content/pages/camps"
>
  <section class="camp-hero">
    <div class="wrap camp-hero__grid">
      <div class="stack" style="--stack: var(--space-l)">
        {page.hero.eyebrow && <p class="eyebrow">{page.hero.eyebrow}</p>}
        <h1 set:html={rich(page.hero.headline, vars, { spotlight: 'u' })} />
        <p class="lede" set:html={rich(page.hero.intro, vars)} />
        {
          page.hero.facts.length > 0 && (
            <dl class="camp-facts">
              {page.hero.facts.map((f) => (
                <div>
                  <dt>{f.label}</dt>
                  <dd>{f.value}</dd>
                </div>
              ))}
            </dl>
          )
        }
        <div class="camp-hero__ctas">
          <a class="btn btn--primary" href="#summer">{page.hero.summerButton} <span class="arrow" aria-hidden="true">→</span></a>
          <a class="btn btn--outline" href="#mini">{page.hero.miniButton}</a>
        </div>
      </div>
      <PhotoFrame shape="arch" ratio="4 / 5" gel="teal" class="camp-hero__photo" eager sizes="(max-width: 960px) 70vw, 420px" image={page.hero.photo} />
    </div>
  </section>

  <section class="section section--hall" id="summer" aria-labelledby="summer-title">
    <div class="wrap">
      {
        weekList.length > 0 ? (
          <>
            <div class="section-head section-head--split">
              <div class="stack">
                <span class="tape" data-gel="teal">{page.summer.openTape}</span>
                <h2 id="summer-title">{page.summer.openHeading}</h2>
                <p class="lede">{page.summer.openLede}</p>
              </div>
              <div class="age-filter" role="group" aria-label="Highlight camps for age">
                <button class="chip" type="button" data-age="" aria-pressed="true">All ages</button>
                {ageBands.slice(0, 4).map((b) => (
                  <button class="chip" type="button" data-age={b.id} data-min={b.min} data-max={b.max} aria-pressed="false">{b.label}</button>
                ))}
              </div>
            </div>
            <div class="weeks">
              {weekList.map((w) => (
                <div class="week">
                  <div class="week__when">
                    <strong>{w.label}</strong>
                    <span class="script">{dateRange(w.start, w.end)}</span>
                  </div>
                  <ul class="week__camps">
                    {w.slots.map((slot) => (
                      <li data-gel={slot.program.gel} data-min={slot.program.ages.min} data-max={slot.program.ages.max ?? 120}>
                        <a href={`/programs/${slot.program.slug}`}>
                          <span class="week__name">{slot.program.title}</span>
                          <span class="week__meta script">
                            {ageLabel(slot.program.ages, slot.program.agesLabel)} · {locationById(slot.locationId)?.shortName}
                          </span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          </>
        ) : (
          <div class="soon">
            <div class="soon__text stack" style="--stack: var(--space-l)">
              <span class="tape" data-gel="purple">{page.summer.soonTape}</span>
              <h2 id="summer-title">{page.summer.soonHeading}</h2>
              {summer && <p class="lede">{summer.summary}</p>}
              <ul class="formats">
                {page.summer.formats.map((f) => (
                  <li data-gel={f.gel}>
                    <strong>{f.title}</strong>
                    <span set:html={rich(f.body, vars)} />
                  </li>
                ))}
              </ul>
            </div>
            <form
              class="notify-card"
              action="/api/leads"
              method="post"
              data-lead-form
              data-success-title="You’re on the summer list!"
              data-success-body={page.summer.notifyBody}
            >
              <LeadFormFields kind="camps" />
              <Character name="artist" size={72} />
              <h3>{page.summer.notifyHeading}</h3>
              <p>{page.summer.notifyBody}</p>
              <label class="sr-only" for="summer-email">Email address</label>
              <input class="input" id="summer-email" type="email" name="email" autocomplete="email" placeholder="you@example.com" required />
              <button class="btn btn--primary btn--block" type="submit">Notify me</button>
              {page.summer.notifyNote && <p class="notify-card__small" set:html={rich(page.summer.notifyNote, vars)} />}
            </form>
          </div>
        )
      }
    </div>
  </section>

  <section class="section" id="mini" aria-labelledby="mini-title">
    <div class="wrap mini">
      <div class="stack" style="--stack: var(--space-l)">
        {page.mini.eyebrow && <p class="eyebrow">{page.mini.eyebrow}</p>}
        <h2 id="mini-title">{page.mini.heading}</h2>
        <p class="lede">{[mini?.summary, page.mini.lede].filter(Boolean).join(' ')}</p>
        <div class="mini__cards">
          {mini && <ProgramCard program={mini} />}
          {free && <ProgramCard program={free} />}
        </div>
      </div>
      {
        page.mini.recent.length > 0 && (
          <aside class="recent" aria-labelledby="recent-title">
            <h3 id="recent-title">{page.mini.recentHeading}</h3>
            <ul>
              {page.mini.recent.map((r) => (
                <li data-gel={r.gel}>
                  <span class="script">{r.when}</span>
                  <strong>{r.title}</strong>
                </li>
              ))}
            </ul>
          </aside>
        )
      }
    </div>
  </section>

  <section class="section section--stage" aria-labelledby="day-title">
    <div class="wrap day">
      <div class="stack day__intro">
        {page.day.eyebrow && <p class="eyebrow">{page.day.eyebrow}</p>}
        <h2 id="day-title">{page.day.heading}</h2>
        {page.day.lede && <p class="lede" set:html={rich(page.day.lede, vars)} />}
        <div class="day__cast" aria-hidden="true">
          <Character name="artist" size={80} />
          <Character name="professor" size={76} />
        </div>
      </div>
      <ol class="timeline">
        {
          page.day.steps.map((d) => (
            <li>
              <span class="timeline__time script">{d.time}</span>
              <div>
                <strong>{d.what}</strong>
                <p>{d.detail}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section" aria-labelledby="camp-faq-title">
    <div class="wrap wrap--narrow stack" style="--stack: var(--space-xl)">
      <h2 id="camp-faq-title">{page.faq.heading}</h2>
      <FaqList items={campFaqs} />
    </div>
  </section>
</Base>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.age-filter [data-age]');
  const items = document.querySelectorAll<HTMLElement>('.week__camps li');
  buttons.forEach((btn) =>
    btn.addEventListener('click', () => {
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      const min = Number(btn.dataset.min ?? 0);
      const max = Number(btn.dataset.max ?? 200);
      items.forEach((li) => {
        const fits = !btn.dataset.age || (Number(li.dataset.min) <= max && Number(li.dataset.max) >= min);
        li.classList.toggle('is-dim', !fits);
      });
    }),
  );
</script>

<style>
  .camp-hero { padding-block: var(--space-2xl); overflow: hidden; }
  .camp-hero__grid { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr); gap: var(--space-2xl); align-items: center; }
  .camp-hero h1 { font-size: var(--step-5); }
  /* Underlined words come from editable text (set:html), so they're styled with :global. */
  h1 :global(.u) { background: linear-gradient(transparent 62%, var(--teal) 62% 90%, transparent 90%); }
  .camp-hero :global(.camp-hero__photo) { width: 100%; max-width: 420px; justify-self: end; }
  .camp-facts {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
    margin: 0;
    padding-top: var(--space-m);
    border-top: 2px solid var(--ink);
  }
  .camp-facts dt { font-family: var(--font-script); font-weight: 700; font-size: var(--step--1); text-transform: uppercase; color: var(--teal-ink); }
  .camp-facts dd { margin: 0.2rem 0 0; font-family: var(--font-display); font-weight: 700; font-size: 1.1rem; font-stretch: 92%; }
  .camp-hero__ctas { display: flex; flex-wrap: wrap; gap: 0.75rem; }

  .soon { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr); gap: var(--space-2xl); align-items: start; }
  .soon h2 { font-size: var(--step-4); }
  .formats { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-m); }
  .formats li { display: grid; gap: 0.3rem; padding: 1.1rem 1.3rem; background: var(--paper); border-radius: var(--r-md); border-left: 6px solid var(--gel); }
  .formats strong { font-family: var(--font-display); font-size: 1.2rem; font-stretch: 92%; }
  .formats span { color: var(--ink-soft); }
  .notify-card {
    display: grid;
    gap: var(--space-m);
    justify-items: start;
    padding: var(--space-xl);
    background: var(--paper);
    border: 2px solid var(--ink);
    border-radius: var(--r-lg);
    box-shadow: 8px 8px 0 var(--orange);
  }
  .notify-card h3 { font-size: var(--step-2); }
  .notify-card p { color: var(--ink-soft); }
  .notify-card .input { width: 100%; }
  .notify-card__small { font-size: var(--step--1); }

  .age-filter { display: flex; flex-wrap: wrap; gap: 0.45rem; }
  .age-filter .chip { min-height: 40px; font-size: 0.95rem; }
  .weeks { border-top: 2px solid var(--ink); }
  .week { display: grid; grid-template-columns: 11rem 1fr; gap: var(--space-l); padding-block: var(--space-l); border-bottom: 1.5px solid var(--line-strong); }
  .week__when { display: grid; gap: 0.2rem; align-content: start; }
  .week__when strong { font-family: var(--font-display); font-size: var(--step-2); font-stretch: 85%; line-height: 1; }
  .week__when .script { color: var(--ink-soft); }
  .week__camps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr)); gap: 0.75rem; }
  .week__camps li { transition: opacity 180ms; }
  .week__camps li.is-dim { opacity: 0.28; }
  .week__camps a { display: grid; gap: 0.2rem; height: 100%; padding: 0.8rem 1rem; background: var(--gel-tint); border-left: 6px solid var(--gel); border-radius: var(--r-sm) var(--r-md) var(--r-md) var(--r-sm); color: var(--ink); text-decoration: none; }
  .week__name { font-family: var(--font-display); font-weight: 750; font-size: 1.1rem; font-stretch: 90%; }
  .week__meta { font-size: var(--step--1); color: var(--ink-soft); }

  .mini { display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(0, 0.7fr); gap: var(--space-2xl); align-items: start; }
  .mini h2 { font-size: var(--step-4); }
  .mini__cards { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-l); }
  .recent { padding: var(--space-l); background: var(--hall); border-radius: var(--r-lg); }
  .recent h3 { font-size: var(--step-1); margin-bottom: var(--space-m); }
  .recent ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.6rem; }
  .recent li { display: grid; gap: 0.1rem; padding-left: 0.9rem; border-left: 4px solid var(--gel); }
  .recent .script { font-size: var(--step--1); color: var(--ink-mute); }
  .recent strong { font-family: var(--font-display); font-stretch: 92%; font-weight: 700; line-height: 1.25; }

  .day { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); gap: var(--space-2xl); align-items: start; }
  .day h2 { color: var(--on-stage); }
  .day__cast { display: flex; align-items: flex-end; gap: 0.5rem; padding-top: var(--space-l); }
  .timeline { list-style: none; margin: 0; padding: 0; display: grid; }
  .timeline li { display: grid; grid-template-columns: 5.5rem 1fr; gap: var(--space-m); padding-block: 0.9rem; border-bottom: 1.5px dashed var(--stage-line); }
  .timeline__time { color: var(--yellow); font-weight: 700; font-size: 1.05rem; }
  .timeline strong { color: var(--on-stage); font-family: var(--font-display); font-size: 1.15rem; font-stretch: 92%; }
  .timeline p { color: var(--on-stage-mute); font-size: var(--step--1); }

  @media (max-width: 960px) {
    .camp-hero__grid, .day, .soon, .mini { grid-template-columns: 1fr; }
    .camp-hero :global(.camp-hero__photo) { justify-self: start; max-width: 320px; order: -1; }
    .camp-facts { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 640px) {
    .week { grid-template-columns: 1fr; gap: 0.75rem; }
    .mini__cards { grid-template-columns: 1fr; }
  }
</style>
