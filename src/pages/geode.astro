---
import Base from '@/layouts/Base.astro';
import ProgramRow from '@/components/ProgramRow.astro';
import EventTicket from '@/components/EventTicket.astro';
import PhotoFrame from '@/components/PhotoFrame.astro';
import { rich } from '@/content/rich';

const { programs, events, programBySlug, vars, pages } = Astro.locals.content;
const page = pages.geode;
const geodePrograms = programs.filter((p) => p.brand === 'geode');
const geodeEvents = events.filter((e) => e.brand === 'geode').slice(0, 3);
// The Performance Troupe is a Little Characters class for ages 9–17, listed here for teens too.
const troupe = programBySlug('performance-troupe');
const rows = [geodePrograms[0], troupe, ...geodePrograms.slice(1)].filter((p) => p !== undefined);
---

<Base
  title="Geode: theater for tweens, teens & adults"
  description="Geode is Little Characters’ sister company for tweens, teens and adults: acting classes, a performance troupe, improv nights and workshops."
  seo={page.seo}
  edit="/admin/content/pages/geode"
>
  <div class="geode" data-gel="purple">
    <section class="geode-hero">
      <div class="crystals" aria-hidden="true">
        <span></span><span></span><span></span><span></span>
      </div>
      <div class="wrap geode-hero__inner">
        {page.hero.eyebrow && <p class="eyebrow">{page.hero.eyebrow}</p>}
        <h1>{page.hero.headline}</h1>
        <p class="geode-hero__line">{page.hero.line}</p>
        <p class="lede" set:html={rich(page.hero.intro, vars)} />
        <div class="geode-hero__ctas">
          <a class="btn btn--primary" href="#geode-programs">{page.hero.classesButton} <span class="arrow" aria-hidden="true">→</span></a>
          <a class="btn btn--outline" href="#improv-nights">{page.hero.improvButton}</a>
        </div>
      </div>
    </section>

    <section class="section section--tight" aria-labelledby="growing-title">
      <div class="wrap growing">
        <h2 id="growing-title">{page.growing.heading}</h2>
        <div class="prose">
          {page.growing.paragraphs.map((para) => <p set:html={rich(para, vars)} />)}
        </div>
      </div>
    </section>

    <section class="section section--hall" id="geode-programs" aria-labelledby="gp-title">
      <div class="wrap">
        <h2 id="gp-title" class="geode__h2">{page.classes.heading}</h2>
        <div class="rows">
          {rows.map((p) => <ProgramRow program={p} />)}
        </div>
        {page.classes.note && <p class="geode__lessons" set:html={rich(page.classes.note, vars)} />}
      </div>
    </section>

    <section class="section section--stage" id="improv-nights" aria-labelledby="fi-title">
      <div class="wrap">
        <div class="section-head">
          {page.improv.eyebrow && <p class="eyebrow">{page.improv.eyebrow}</p>}
          <h2 id="fi-title">{page.improv.heading}</h2>
          {page.improv.lede && <p class="lede" set:html={rich(page.improv.lede, vars)} />}
        </div>
        <div class="tickets">
          {geodeEvents.map((e) => <EventTicket event={e} />)}
        </div>
      </div>
    </section>

    {
      page.past.items.length > 0 && (
        <section class="section" aria-labelledby="past-title">
          <div class="wrap">
            <h2 id="past-title" class="geode__h2">
              {page.past.heading}
            </h2>
            <div class="past">
              {page.past.items.map((item) => (
                <figure>
                  <PhotoFrame image={item.photo} gel="purple" ratio="4 / 3" sizes="(max-width: 860px) 100vw, 380px" />
                  <figcaption set:html={rich(item.caption, vars)} />
                </figure>
              ))}
            </div>
          </div>
        </section>
      )
    }
  </div>
</Base>

<style>
  .geode-hero {
    position: relative;
    overflow: hidden;
    padding-block: var(--space-3xl);
    background: linear-gradient(160deg, var(--purple-tint), var(--paper) 70%);
  }
  .geode-hero__inner { position: relative; display: grid; gap: var(--space-l); }
  .geode-hero__inner > * { max-width: 760px; }
  .geode-hero h1 {
    font-size: clamp(4rem, 2rem + 10vw, 10rem);
    font-stretch: 75%;
    letter-spacing: -0.04em;
    line-height: 0.85;
    color: var(--purple);
  }
  .geode-hero__line { font-family: var(--font-display); font-weight: 700; font-size: var(--step-2); font-stretch: 90%; }
  .geode-hero__ctas { display: flex; flex-wrap: wrap; gap: 0.75rem; }

  /* Faceted crystal shapes, a nod to the name */
  .crystals { position: absolute; inset: 0; pointer-events: none; }
  .crystals span {
    position: absolute;
    background: linear-gradient(135deg, var(--purple), color-mix(in srgb, var(--teal) 70%, var(--purple)));
    opacity: 0.85;
    clip-path: polygon(50% 0, 100% 30%, 85% 100%, 15% 100%, 0 30%);
  }
  .crystals span:nth-child(1) { width: 220px; height: 300px; right: 6%; top: 12%; transform: rotate(8deg); }
  .crystals span:nth-child(2) { width: 130px; height: 190px; right: 22%; top: 42%; transform: rotate(-14deg); opacity: 0.6; background: linear-gradient(135deg, var(--red), var(--purple)); }
  .crystals span:nth-child(3) { width: 90px; height: 130px; right: 3%; top: 64%; transform: rotate(22deg); opacity: 0.55; background: var(--teal); }
  .crystals span:nth-child(4) { width: 60px; height: 90px; right: 30%; top: 10%; transform: rotate(-4deg); opacity: 0.5; background: var(--orange); }

  .growing { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: var(--space-2xl); align-items: start; }
  .growing h2 { font-size: var(--step-3); }
  .geode__h2 { font-size: var(--step-3); margin-bottom: var(--space-xl); }
  .rows { display: grid; gap: var(--space-l); }
  .geode__lessons { margin-top: var(--space-xl); color: var(--ink-soft); max-width: 70ch; }
  .tickets { display: grid; gap: var(--space-m); }
  .past { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-l); }
  .past figure { margin: 0; display: grid; gap: 0.6rem; }
  .past figcaption { color: var(--ink-soft); font-size: var(--step--1); }

  @media (max-width: 860px) {
    .crystals { opacity: 0.35; }
    .growing, .past { grid-template-columns: 1fr; }
  }
</style>
