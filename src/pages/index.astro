---
import Base from '@/layouts/Base.astro';
import AgePicker from '@/components/AgePicker.astro';
import Character from '@/components/Character.astro';
import PhotoFrame from '@/components/PhotoFrame.astro';
import ProgramCard from '@/components/ProgramCard.astro';
import EventTicket from '@/components/EventTicket.astro';
import { programs, programBySlug } from '@/data/programs';
import { events, sortKey } from '@/data/events';
import { locations, parking } from '@/data/locations';
import { testimonials } from '@/data/testimonials';
import { team } from '@/data/team';
import { site } from '@/config/site';

import castSillyFaces from '@/assets/photos/cast-silly-faces.webp';
import teacherWithStudents from '@/assets/photos/teacher-with-students.webp';
import rehearsingOnStage from '@/assets/photos/rehearsing-on-stage.webp';
import carnivalShow from '@/assets/photos/carnival-show.webp';

const featured = programs.filter((p) => p.featured);
const upcoming = [...events]
  .filter((e) => e.brand === 'lc' && e.times.length)
  .sort((a, b) => sortKey(a).localeCompare(sortKey(b)))
  .slice(0, 3);
const hq = locations.find((l) => l.id === 'hq')!;
const hannah = team[0];

// The pathway is a real progression: where most students start, and where they go next.
const pathway = [
  { age: '4–6', title: 'First steps', cast: 'professor', gel: 'yellow', slugs: ['stories-and-songs'] },
  { age: '7–10', title: 'Find your voice', cast: 'magician', gel: 'teal', slugs: ['intro-to-theater', 'yes-and-improv'] },
  { age: '7+', title: 'Make your own', cast: 'artist', gel: 'orange', slugs: ['produce-a-show', 'film-creation'] },
  { age: '9–17', title: 'Take the stage', cast: 'dancer', gel: 'purple', slugs: ['performance-troupe', 'geode-acting-studio'] },
] as const;

// "Our Approach", from the current home page.
const approach = [
  {
    title: 'Meet you where you’re at',
    body: 'We are all born beautiful individuals with differing gifts. We meet students where they are, whether nervous or excited, first-timers or masters of the stage, and help each little character feel comfortable and curious to learn.',
    image: { src: teacherWithStudents, alt: 'A teacher with a group of young students' },
    gel: 'yellow',
  },
  {
    title: 'Learn and rehearse',
    body: 'We build a team through games, exercises and trust experiences. Then we build confidence, express emotions and grow communication skills by working on scenes, scripts and character development.',
    image: { src: rehearsingOnStage, alt: 'Students rehearsing a scene on stage', position: '50% 60%' },
    gel: 'teal',
  },
  {
    title: 'Encourage and perform!',
    body: 'Performing can be intimidating! We share affirmations with each other and give one-on-one prep time with teachers. It’s a gift to showcase our hard work for our loved ones.',
    image: { src: carnivalShow, alt: 'Students performing a carnival-themed show on stage', position: '60% 50%' },
    gel: 'red',
  },
] as const;

const extras = [
  { href: '/programs/parents-night-out', title: 'Parents’ Night Out', body: 'Once a month, 5–8 pm. Games, crafts and snacks while you head downtown. $30 for the first child.', cast: 'royal', geode: false },
  { href: '/programs/parties', title: 'Parties', body: 'Two hours on our stage for any occasion, with your own teacher/party coordinator.', cast: 'artist', geode: false },
  { href: '/programs/private-lessons', title: 'Private lessons', body: 'Audition help, playwriting, one-on-one acting and singing, by the hour.', cast: 'professor', geode: false },
  { href: '/programs/free-community-class', title: 'Free community class', body: 'A free theater class once a month, open to all ages.', cast: 'magician', geode: false },
  { href: '/about#schools', title: 'At your school', body: 'We’re a verified CCSD school vendor, running after-school programs around the county.', cast: 'royal', geode: false },
  { href: '/geode', title: 'Geode: tweens, teens & adults', body: 'Acting Studio, Performance Troupe and Third Thursday Improv Nights for 11 and up.', cast: 'dancer', geode: true },
] as const;
---

<Base>
  <!-- ───────────── Hero ───────────── -->
  <section class="hero">
    <div class="wrap hero__grid">
      <div class="hero__copy">
        <p class="eyebrow">Encouraging creative hearts through theater · Athens, GA</p>
        <h1>Every person has a <span class="lit">story</span> worth telling.</h1>
        <p class="lede">
          Through dramatic play, improv, storytelling and script writing, we help children, teens and adults discover confidence, creativity, and a place where they belong.
        </p>
        <AgePicker />
        <ul class="hero__promises" aria-label="Why families choose us">
          <li><span class="tape" data-gel="yellow">First class free</span></li>
          <li><span class="tape" data-gel="teal" data-tilt="right">Classes of 8–12 kids</span></li>
          <li><span class="tape" data-gel="orange">Pay-what-you-can available</span></li>
        </ul>
      </div>

      <div class="hero__stage">
        <div class="pool pool--red" aria-hidden="true"></div>
        <div class="pool pool--teal" aria-hidden="true"></div>
        <div class="pool pool--orange" aria-hidden="true"></div>
        <PhotoFrame
          shape="arch"
          ratio="5 / 6"
          gel="orange"
          eager
          class="hero__photo"
          sizes="(max-width: 960px) 80vw, 440px"
          image={{ src: castSillyFaces, alt: 'A cast of Little Characters students and teachers making silly faces on stage', position: '42% 35%' }}
        />
        <div class="hero__cast" aria-hidden="true">
          <Character name="royal" size={84} />
          <Character name="magician" size={64} />
          <Character name="artist" size={76} />
        </div>
      </div>
    </div>
  </section>

  <!-- ───────────── Now (call sheet) ───────────── -->
  <section class="now" aria-labelledby="now-title">
    <div class="wrap">
      <div class="now__sheet">
        <h2 id="now-title" class="now__title">On the call sheet</h2>
        <ul class="now__list">
          <li>
            <a href="/programs?kind=class">
              <span class="now__when script">Fall 2026 · Aug 17 – Dec 18</span>
              <strong>Registration is open for all classes</strong>
              <span>New to Little Characters? Your first class is free.</span>
            </a>
          </li>
          <li>
            <a href="/events#jack-and-the-beanstalk">
              <span class="now__when script">Sun, Sep 27 · 1:30 pm</span>
              <strong>Jack and the Beanstalk</strong>
              <span>Our Performance Troupe at the Botanical Garden’s Insectival.</span>
            </a>
          </li>
          <li>
            <a href="/programs/stories-and-songs">
              <span class="now__when script">Starts Tue, Oct 20 · 8 weeks</span>
              <strong>Stories and Songs & Acting Studio</strong>
              <span>New 8-week classes for ages 4–6 and 11–17.</span>
            </a>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <!-- ───────────── Pathway ───────────── -->
  <section class="section" aria-labelledby="path-title">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Where does my kid start?</p>
        <h2 id="path-title">A class for every age, and a next step when they’re ready.</h2>
        <p class="lede">Classes are grouped by age, from pretend play for 4-year-olds to writing and staging an original show. Not sure which fits? <a href="/contact?topic=class">Ask us</a> and we’ll help you pick.</p>
      </div>

      <ol class="risers">
        {
          pathway.map((step, i) => (
            <li class="riser" data-gel={step.gel} style={`--rise: ${i}`}>
              <div class="riser__cast" aria-hidden="true">
                <Character name={step.cast} size={72} />
              </div>
              <div class="riser__block">
                <span class="riser__age">Ages {step.age}</span>
                <h3>{step.title}</h3>
                <ul>
                  {step.slugs.map((slug) => {
                    const p = programBySlug(slug)!;
                    return (
                      <li>
                        <a href={`/programs/${slug}`}>{p.title}</a>
                      </li>
                    );
                  })}
                </ul>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ───────────── Approach ───────────── -->
  <section class="section section--hall" aria-labelledby="approach-title">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Our approach</p>
        <h2 id="approach-title">From “I’m nervous” to a bow on stage.</h2>
      </div>
      <ol class="approach">
        {
          approach.map((a, i) => (
            <li class="approach__step" data-gel={a.gel}>
              <PhotoFrame image={a.image} gel={a.gel} ratio="4 / 3" sizes="(max-width: 960px) 100vw, 380px" />
              <span class="approach__num">{i + 1}</span>
              <h3>{a.title}</h3>
              <p>{a.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ───────────── Featured programs ───────────── -->
  <section class="section" aria-labelledby="featured-title">
    <div class="wrap">
      <div class="section-head section-head--split">
        <div class="stack">
          <p class="eyebrow">Fall 2026 · registration open</p>
          <h2 id="featured-title">This semester’s classes</h2>
        </div>
        <a class="btn btn--outline" href="/programs">See everything <span class="arrow" aria-hidden="true">→</span></a>
      </div>
      <div class="grid" style="--min: 300px">
        {featured.map((p) => <ProgramCard program={p} />)}
      </div>
    </div>
  </section>

  <!-- ───────────── Why families choose us ───────────── -->
  <section class="section section--hall" aria-labelledby="why-title">
    <div class="wrap why">
      <div class="why__facts">
        <p class="eyebrow">Why families choose Little Characters</p>
        <h2 id="why-title">Small groups. Big confidence.</h2>
        <dl class="facts">
          <div data-gel="teal">
            <dt>8–12</dt>
            <dd>Kids in a typical class, with about 7 students per teacher. We add teachers when friends need extra attention.</dd>
          </div>
          <div data-gel="orange">
            <dt>Free</dt>
            <dd>A new student’s first class is always free, so your child can try it before you commit.</dd>
          </div>
          <div data-gel="red">
            <dt>15% off</dt>
            <dd>For multiple students or multiple classes. Pay the semester up front and save 10%.</dd>
          </div>
          <div data-gel="purple">
            <dt>1 : 1</dt>
            <dd>Class buddies for students with higher needs, through the UGA Speech and Hearing Clinic, at no cost to parents.</dd>
          </div>
        </dl>
      </div>
      <figure class="quote">
        <blockquote>
          <p>“{testimonials[0].quote}”</p>
        </blockquote>
        <figcaption>{testimonials[0].attribution}</figcaption>
        <div class="quote__cast" aria-hidden="true"><Character name="royal" size={82} /></div>
      </figure>
    </div>
  </section>

  <!-- ───────────── More ways to play ───────────── -->
  <section class="section section--tight" aria-labelledby="extras-title">
    <div class="wrap">
      <h2 id="extras-title" class="extras__title">More ways to play</h2>
      <ul class="extras">
        {
          extras.map((x) => (
            <li>
              <a href={x.href} class:list={['extra', { 'extra--geode': x.geode }]}>
                <span class="extra__cast" aria-hidden="true">
                  <Character name={x.cast} size={54} />
                </span>
                <span class="extra__text">
                  <strong>{x.title}</strong>
                  <span>{x.body}</span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ───────────── Shows (house lights down) ───────────── -->
  <section class="section section--stage shows" aria-labelledby="shows-title">
    <div class="shows__lights" aria-hidden="true"></div>
    <div class="wrap">
      <div class="section-head section-head--split">
        <div class="stack">
          <p class="eyebrow">House lights down</p>
          <h2 id="shows-title">Shows & events</h2>
        </div>
        <a class="btn btn--ghost-light" href="/events">Full calendar <span class="arrow" aria-hidden="true">→</span></a>
      </div>
      <div class="shows__list">
        {upcoming.map((e) => <EventTicket event={e} />)}
      </div>
    </div>
  </section>

  <!-- ───────────── Founder ───────────── -->
  <section class="section" aria-labelledby="founder-title">
    <div class="wrap founder">
      <PhotoFrame shape="arch" ratio="4 / 5" gel="red" class="founder__photo" image={hannah.image} sizes="(max-width: 960px) 70vw, 420px" />
      <div class="founder__text stack" style="--stack: var(--space-l)">
        <p class="eyebrow">Our story</p>
        <h2 id="founder-title">It started with a Pre‑K moms’ group text.</h2>
        <div class="prose">
          <p>
            A few years ago, Athens lost several of its historic kids’ theater companies. Hannah Eppling, a local mom and theater educator who has taught theater to 3- to 50-year-olds, started Little Characters in {site.founded} to keep the joy and connection of theater going for students of all ages and abilities, beginning with summer camps.
          </p>
          <p>“I have a yearning to encourage the hearts of others, and my favorite way to do so is through theater.”</p>
        </div>
        <div class="founder__links">
          <a class="btn btn--outline" href="/about">Meet the whole team <span class="arrow" aria-hidden="true">→</span></a>
        </div>
      </div>
    </div>
  </section>

  <!-- ───────────── Visit ───────────── -->
  <section class="section section--tight section--hall" aria-labelledby="visit-title">
    <div class="wrap visit">
      <div class="visit__place stack">
        <p class="eyebrow">Visit HQ</p>
        <h2 id="visit-title">Come see our space</h2>
        <p class="script">{hq.address.join(', ')}</p>
        <p>{hq.notes}</p>
        <a class="link-arrow" href={hq.mapUrl} rel="noopener">Get directions</a>
      </div>
      <dl class="visit__parking">
        <div data-gel="teal"><dt>Walk in</dt><dd>{parking.walkIn}</dd></div>
        <div data-gel="orange"><dt>Drop off (after 5 pm)</dt><dd>{parking.dropOff}</dd></div>
        <div data-gel="red"><dt>Running late?</dt><dd>{parking.late}</dd></div>
      </dl>
    </div>
  </section>

  <!-- ───────────── Give + list ───────────── -->
  <section class="section section--tight" aria-labelledby="give-title">
    <div class="wrap signup">
      <div class="signup__give">
        <h2 id="give-title">Help a kid take the stage.</h2>
        <p>Gifts to our scholarship fund let us invite anyone to our programs without cost getting in the way. You can also volunteer, donate costumes and props, or shop our wish list.</p>
        <a class="btn btn--primary" href="/give">Ways to support LC</a>
      </div>
      <form class="signup__list" action={site.forms.newsletterAction || undefined} method="post">
        <h2>Be first to hear about camps.</h2>
        <p>Mini camps, workshops and summer camp fill fast. Get dates, new classes and show announcements by email.</p>
        <div class="signup__row">
          <label class="sr-only" for="signup-email">Email address</label>
          <input class="input" id="signup-email" name="email" type="email" autocomplete="email" placeholder="you@example.com" required />
          <button class="btn" type="submit">Sign up</button>
        </div>
      </form>
    </div>
  </section>
</Base>

<style>
  /* ── Hero ── */
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: var(--space-2xl) 0;
  }
  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.12fr) minmax(0, 0.88fr);
    gap: var(--space-2xl);
    align-items: end;
  }
  .hero__copy {
    display: grid;
    gap: var(--space-l);
    padding-bottom: var(--space-2xl);
    align-self: center;
  }
  .hero h1 { max-width: 12ch; }
  .lit {
    position: relative;
    white-space: nowrap;
    z-index: 0;
  }
  .lit::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: 12% -10% -2%;
    border-radius: 50%;
    background: radial-gradient(closest-side, var(--yellow) 0 62%, color-mix(in srgb, var(--yellow) 40%, transparent) 78%, transparent);
  }
  .hero__promises {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1rem;
  }

  .hero__stage {
    position: relative;
    display: grid;
    justify-items: center;
    padding-top: var(--space-l);
  }
  .hero__stage :global(.hero__photo) { width: min(100%, 440px); z-index: 1; }
  .pool {
    position: absolute;
    border-radius: 50%;
    mix-blend-mode: multiply;
    filter: blur(2px);
    z-index: 0;
  }
  .pool--red { width: 58%; aspect-ratio: 1; background: radial-gradient(closest-side, var(--red-tint), color-mix(in srgb, var(--red) 50%, transparent) 70%, transparent); top: 4%; left: -6%; }
  .pool--teal { width: 64%; aspect-ratio: 1; background: radial-gradient(closest-side, var(--teal-tint), color-mix(in srgb, var(--teal) 50%, transparent) 70%, transparent); top: -4%; right: -10%; }
  .pool--orange { width: 70%; aspect-ratio: 1; background: radial-gradient(closest-side, var(--orange-tint), color-mix(in srgb, var(--orange) 55%, transparent) 70%, transparent); bottom: 2%; left: 18%; }

  .hero__cast {
    position: absolute;
    z-index: 2;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: min(118%, 560px);
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    pointer-events: none;
  }
  .hero__cast :global(.character) {
    animation: bob 3.2s var(--ease) infinite alternate;
    margin-bottom: -2px;
  }
  .hero__cast :global(.character:nth-child(2)) { animation-delay: -1.1s; margin-right: auto; margin-left: 4%; }
  .hero__cast :global(.character:nth-child(3)) { animation-delay: -2.1s; }
  @keyframes bob {
    from { transform: translateY(0) rotate(-1.5deg); }
    to { transform: translateY(-6px) rotate(1.5deg); }
  }

  /* ── Call sheet ── */
  .now { background: var(--ink); color: var(--on-stage); padding-bottom: var(--space-xl); }
  .now__sheet {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-l);
    align-items: center;
    padding-top: var(--space-l);
  }
  .now__title {
    font-family: var(--font-script);
    font-size: var(--step--1);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--yellow);
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    align-self: stretch;
    text-align: center;
  }
  .now__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-m);
  }
  .now__list a {
    display: grid;
    gap: 0.2rem;
    height: 100%;
    padding: 1rem 1.2rem;
    border: 1.5px solid var(--stage-line);
    border-radius: var(--r-md);
    color: var(--on-stage-mute);
    text-decoration: none;
    transition: border-color 150ms, background 150ms;
  }
  .now__list a:hover { border-color: var(--yellow); background: var(--stage-raise); }
  .now__when { color: var(--yellow); font-size: var(--step--1); }
  .now__list strong { font-family: var(--font-display); font-size: var(--step-1); font-stretch: 90%; color: var(--on-stage); }

  /* ── Risers ── */
  .risers {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    align-items: end;
  }
  .riser { display: grid; justify-items: start; }
  .riser__cast { padding-left: 1.2rem; }
  .riser__cast :global(.character) { margin-bottom: -2px; }
  .riser__block {
    width: 100%;
    min-height: calc(10rem + var(--rise) * 3rem);
    padding: 1.2rem 1.2rem 1.4rem;
    background: var(--gel-tint);
    border-top: 6px solid var(--gel);
    display: grid;
    align-content: start;
    gap: 0.4rem;
  }
  .riser:first-child .riser__block { border-radius: var(--r-md) 0 0 var(--r-md); }
  .riser:last-child .riser__block { border-radius: 0 var(--r-md) var(--r-md) 0; }
  .riser__age { font-family: var(--font-script); font-weight: 700; color: var(--gel-ink); }
  .riser h3 { font-size: var(--step-2); }
  .riser ul { list-style: none; margin: 0.3rem 0 0; padding: 0; display: grid; gap: 0.3rem; }
  .riser ul a { color: var(--ink); font-weight: 600; text-decoration-color: var(--gel); }

  /* ── Approach ── */
  .approach {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-l);
  }
  .approach__step { position: relative; display: grid; gap: 0.7rem; align-content: start; }
  .approach__num {
    position: absolute;
    top: 0.8rem;
    left: 0.8rem;
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 50%;
    background: var(--gel);
    color: var(--gel-on);
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.2rem;
  }
  .approach h3 { font-size: var(--step-2); margin-top: 0.3rem; }
  .approach p { color: var(--ink-soft); }

  /* ── Why ── */
  .why {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
    gap: var(--space-2xl);
    align-items: center;
  }
  .why__facts { display: grid; gap: var(--space-m); }
  .facts {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-l) var(--space-xl);
    margin: var(--space-l) 0 0;
  }
  .facts div { display: grid; gap: 0.35rem; align-content: start; }
  .facts dt {
    font-family: var(--font-display);
    font-weight: 800;
    font-stretch: 75%;
    font-size: var(--step-4);
    line-height: 0.95;
    color: var(--gel-ink);
  }
  .facts dd { margin: 0; color: var(--ink-soft); }
  .quote {
    position: relative;
    margin: 0;
    padding: var(--space-xl) var(--space-xl) var(--space-2xl);
    background: var(--paper);
    border: 2px solid var(--ink);
    border-radius: var(--r-lg);
    box-shadow: 8px 8px 0 var(--yellow);
  }
  .quote blockquote { margin: 0; }
  .quote p {
    font-family: var(--font-display);
    font-weight: 550;
    font-size: var(--step-1);
    line-height: 1.4;
  }
  .quote figcaption { margin-top: var(--space-m); font-family: var(--font-script); font-weight: 700; color: var(--purple); }
  .quote__cast { position: absolute; right: 1.2rem; bottom: -1.2rem; }

  /* ── Extras ── */
  .extras__title { font-size: var(--step-3); margin-bottom: var(--space-xl); }
  .extras {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-m);
  }
  .extra {
    display: grid;
    grid-template-columns: auto 1fr;
