---
import LeadFormFields from '@/components/LeadFormFields.astro';
import Base from '@/layouts/Base.astro';
import AgePicker from '@/components/AgePicker.astro';
import Character from '@/components/Character.astro';
import PhotoFrame from '@/components/PhotoFrame.astro';
import ProgramCard from '@/components/ProgramCard.astro';
import EventTicket from '@/components/EventTicket.astro';
import { sortKey } from '@/content/catalog';
import { href, rich } from '@/content/rich';

const { programs, events, programBySlug, locationById, locations, testimonial, testimonials, site, vars, pages } = Astro.locals.content;
const page = pages.home;

const featured = programs.filter((p) => p.featured);
const upcoming = [...events]
  .filter((e) => e.brand === 'lc' && e.times.length)
  .sort((a, b) => sortKey(a).localeCompare(sortKey(b)))
  .slice(0, 3);
const hq = locationById('hq') ?? locations[0];
const quote = testimonial(page.why.testimonial) ?? testimonials[0];
const tapes = [{ gel: 'yellow' }, { gel: 'teal', tilt: 'right' }, { gel: 'orange' }] as const;
---

<Base seo={page.seo} edit="/admin/content/pages/home">
  <!-- ───────────── Hero ───────────── -->
  <section class="hero">
    <div class="wrap hero__grid">
      <div class="hero__copy">
        {page.hero.eyebrow && <p class="eyebrow">{page.hero.eyebrow}</p>}
        <h1 set:html={rich(page.hero.headline, vars, { spotlight: 'lit' })} />
        <p class="lede" set:html={rich(page.hero.intro, vars)} />
        <AgePicker />
        {
          page.hero.promises.length > 0 && (
            <ul class="hero__promises" aria-label="Why families choose us">
              {page.hero.promises.map((promise, i) => (
                <li>
                  <span class="tape" data-gel={tapes[i % tapes.length].gel} data-tilt={'tilt' in tapes[i % tapes.length] ? 'right' : undefined}>
                    {promise}
                  </span>
                </li>
              ))}
            </ul>
          )
        }
      </div>

      <div class="hero__stage">
        <div class="pool pool--red" aria-hidden="true"></div>
        <div class="pool pool--teal" aria-hidden="true"></div>
        <div class="pool pool--orange" aria-hidden="true"></div>
        <PhotoFrame shape="arch" ratio="5 / 6" gel="orange" eager class="hero__photo" sizes="(max-width: 960px) 80vw, 440px" image={page.hero.photo} />
        <div class="hero__cast" aria-hidden="true">
          <Character name="royal" size={84} />
          <Character name="magician" size={64} />
          <Character name="artist" size={76} />
        </div>
      </div>
    </div>
  </section>

  <!-- ───────────── Now (call sheet) ───────────── -->
  {
    page.callSheet.items.length > 0 && (
      <section class="now" aria-labelledby="now-title">
        <div class="wrap">
          <div class="now__sheet">
            <h2 id="now-title" class="now__title">
              {page.callSheet.heading}
            </h2>
            <ul class="now__list">
              {page.callSheet.items.map((item) => (
                <li data-gel={item.gel}>
                  <a href={item.href ? href(item.href, vars) : undefined}>
                    <span class="now__when script">{item.when}</span>
                    <strong>{item.title}</strong>
                    {item.text && <span>{item.text}</span>}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </section>
    )
  }

  <!-- ───────────── First class free ───────────── -->
  <section class="trial" aria-labelledby="trial-title">
    <div class="wrap trial__inner">
      <div class="trial__copy">
        {page.trial.eyebrow && <p class="eyebrow">{page.trial.eyebrow}</p>}
        <h2 id="trial-title">{page.trial.heading}</h2>
        <p set:html={rich(page.trial.body, vars)} />
        <a class="btn btn--primary" href="/programs?trial=1">{page.trial.button} <span class="arrow" aria-hidden="true">→</span></a>
      </div>
      <ol class="trial__steps">
        {
          page.trial.steps.map((step, i) => (
            <li>
              <span class="trial__n">{i + 1}</span>
              <strong>{step.title}</strong>
              <span>{step.text}</span>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ───────────── Pathway ───────────── -->
  <section class="section" aria-labelledby="path-title">
    <div class="wrap">
      <div class="section-head">
        {page.pathway.eyebrow && <p class="eyebrow">{page.pathway.eyebrow}</p>}
        <h2 id="path-title">{page.pathway.heading}</h2>
        {page.pathway.lede && <p class="lede" set:html={rich(page.pathway.lede, vars)} />}
      </div>

      <ol class="risers">
        {
          page.pathway.steps.map((step, i) => (
            <li class="riser" data-gel={step.gel} style={`--rise: ${i}`}>
              <div class="riser__cast" aria-hidden="true">
                <Character name={step.character} size={72} />
              </div>
              <div class="riser__block">
                <span class="riser__age">Ages {step.age}</span>
                <h3>{step.title}</h3>
                <ul>
                  {step.programs
                    .map((slug) => programBySlug(slug))
                    .filter((p) => p !== undefined)
                    .map((p) => (
                      <li>
                        <a href={`/programs/${p.slug}`}>{p.title}</a>
                      </li>
                    ))}
                </ul>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ───────────── Approach ───────────── -->
  <section class="section section--hall" aria-labelledby="approach-title">
    <div class="wrap">
      <div class="section-head">
        {page.approach.eyebrow && <p class="eyebrow">{page.approach.eyebrow}</p>}
        <h2 id="approach-title">{page.approach.heading}</h2>
      </div>
      <ol class="approach">
        {
          page.approach.steps.map((a, i) => (
            <li class="approach__step" data-gel={a.gel}>
              <PhotoFrame image={a.photo} gel={a.gel} ratio="4 / 3" sizes="(max-width: 960px) 100vw, 380px" />
              <span class="approach__num">{i + 1}</span>
              <h3>{a.title}</h3>
              <p set:html={rich(a.body, vars)} />
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ───────────── Featured programs ───────────── -->
  {
    featured.length > 0 && (
      <section class="section" aria-labelledby="featured-title">
        <div class="wrap">
          <div class="section-head section-head--split">
            <div class="stack">
              {page.featured.eyebrow && <p class="eyebrow">{page.featured.eyebrow}</p>}
              <h2 id="featured-title">{page.featured.heading}</h2>
            </div>
            <a class="btn btn--outline" href="/programs">
              See everything <span class="arrow" aria-hidden="true">→</span>
            </a>
          </div>
          <div class="grid" style="--min: 300px">
            {featured.map((p) => (
              <ProgramCard program={p} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- ───────────── Why families choose us ───────────── -->
  <section class="section section--hall" aria-labelledby="why-title">
    <div class="wrap why">
      <div class="why__facts">
        {page.why.eyebrow && <p class="eyebrow">{page.why.eyebrow}</p>}
        <h2 id="why-title">{page.why.heading}</h2>
        <dl class="facts">
          {
            page.why.facts.map((f) => (
              <div data-gel={f.gel}>
                <dt>{f.big}</dt>
                <dd set:html={rich(f.text, vars)} />
              </div>
            ))
          }
        </dl>
      </div>
      {
        quote && (
          <figure class="quote">
            <blockquote>
              <p>“{quote.quote}”</p>
            </blockquote>
            <figcaption>{quote.attribution}</figcaption>
            <div class="quote__cast" aria-hidden="true">
              <Character name="royal" size={82} />
            </div>
          </figure>
        )
      }
    </div>
  </section>

  <!-- ───────────── More ways to play ───────────── -->
  <section class="section section--tight" aria-labelledby="extras-title">
    <div class="wrap">
      <h2 id="extras-title" class="extras__title">{page.extras.heading}</h2>
      <ul class="extras">
        {
          page.extras.items.map((x) => (
            <li>
              <a href={href(x.href, vars)} class:list={['extra', { 'extra--geode': x.geode }]}>
                <span class="extra__cast" aria-hidden="true">
                  <Character name={x.character} size={54} />
                </span>
                <span class="extra__text">
                  <strong>{x.title}</strong>
                  <span>{x.body}</span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ───────────── Shows (house lights down) ───────────── -->
  <section class="section section--stage shows" aria-labelledby="shows-title">
    <div class="shows__lights" aria-hidden="true"></div>
    <div class="wrap">
      <div class="section-head section-head--split">
        <div class="stack">
          {page.shows.eyebrow && <p class="eyebrow">{page.shows.eyebrow}</p>}
          <h2 id="shows-title">{page.shows.heading}</h2>
        </div>
        <a class="btn btn--ghost-light" href="/events">Full calendar <span class="arrow" aria-hidden="true">→</span></a>
      </div>
      <div class="shows__list">
        {upcoming.map((e) => <EventTicket event={e} />)}
      </div>
    </div>
  </section>

  <!-- ───────────── Founder ───────────── -->
  <section class="section" aria-labelledby="founder-title">
    <div class="wrap founder">
      <PhotoFrame shape="arch" ratio="4 / 5" gel="red" class="founder__photo" image={page.story.photo} sizes="(max-width: 960px) 70vw, 420px" />
      <div class="founder__text stack" style="--stack: var(--space-l)">
        {page.story.eyebrow && <p class="eyebrow">{page.story.eyebrow}</p>}
        <h2 id="founder-title">{page.story.heading}</h2>
        <div class="prose">
          {page.story.paragraphs.map((para) => <p set:html={rich(para, vars)} />)}
        </div>
        <div class="founder__links">
          <a class="btn btn--outline" href="/about">Meet the whole team <span class="arrow" aria-hidden="true">→</span></a>
        </div>
      </div>
    </div>
  </section>

  <!-- ───────────── Visit ───────────── -->
  {
    hq && (
      <section class="section section--tight section--hall" aria-labelledby="visit-title">
        <div class="wrap visit">
          <div class="visit__place stack">
            {page.visit.eyebrow && <p class="eyebrow">{page.visit.eyebrow}</p>}
            <h2 id="visit-title">{page.visit.heading}</h2>
            <p class="script">{hq.address.join(', ')}</p>
            {hq.notes && <p>{hq.notes}</p>}
            <a class="link-arrow" href={hq.mapUrl} rel="noopener">
              Get directions
            </a>
          </div>
          <dl class="visit__parking">
            <div data-gel="teal">
              <dt>Walk in</dt>
              <dd>{site.parking.walkIn}</dd>
            </div>
            <div data-gel="orange">
              <dt>Drop off (after 5 pm)</dt>
              <dd>{site.parking.dropOff}</dd>
            </div>
            <div data-gel="red">
              <dt>Running late?</dt>
              <dd>{site.parking.late}</dd>
            </div>
          </dl>
        </div>
      </section>
    )
  }

  <!-- ───────────── Give + list ───────────── -->
  <section class="section section--tight" aria-labelledby="give-title">
    <div class="wrap signup">
      <div class="signup__give">
        <h2 id="give-title">{page.give.heading}</h2>
        <p set:html={rich(page.give.body, vars)} />
        <a class="btn btn--primary" href="/give">Ways to support LC</a>
      </div>
      <form
        class="signup__list"
        action="/api/leads"
        method="post"
        data-lead-form
        data-success-title="You’re on the list!"
        data-success-body="We’ll email you camp dates, new classes and show announcements. No spam, and you can unsubscribe any time."
      >
        <LeadFormFields kind="newsletter" />
        <h2>{page.signup.heading}</h2>
        <p set:html={rich(page.signup.body, vars)} />
        <div class="signup__row">
          <label class="sr-only" for="signup-email">Email address</label>
          <input class="input" id="signup-email" name="email" type="email" autocomplete="email" placeholder="you@example.com" required />
          <button class="btn" type="submit">Sign up</button>
        </div>
      </form>
    </div>
  </section>
</Base>

<style>
  /* ── Hero ── */
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: var(--space-2xl) 0;
  }
  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.12fr) minmax(0, 0.88fr);
    gap: var(--space-2xl);
    align-items: end;
  }
  .hero__copy {
    display: grid;
    gap: var(--space-l);
    padding-bottom: var(--space-2xl);
    align-self: center;
  }
  .hero h1 { max-width: 12ch; }
  /* The spotlit word comes from editable text (set:html), so it's styled with :global. */
  .hero h1 :global(.lit) {
    position: relative;
    white-space: nowrap;
    z-index: 0;
  }
  .hero h1 :global(.lit)::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: 12% -10% -2%;
    border-radius: 50%;
    background: radial-gradient(closest-side, var(--yellow) 0 62%, color-mix(in srgb, var(--yellow) 40%, transparent) 78%, transparent);
  }
  .hero__promises {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1rem;
  }

  .hero__stage {
    position: relative;
    display: grid;
    justify-items: center;
    padding-top: var(--space-l);
  }
  .hero__stage :global(.hero__photo) { width: min(100%, 440px); z-index: 1; }
  .pool {
    position: absolute;
    border-radius: 50%;
    mix-blend-mode: multiply;
    filter: blur(2px);
    z-index: 0;
  }
  .pool--red { width: 58%; aspect-ratio: 1; background: radial-gradient(closest-side, var(--red-tint), color-mix(in srgb, var(--red) 50%, transparent) 70%, transparent); top: 4%; left: -6%; }
  .pool--teal { width: 64%; aspect-ratio: 1; background: radial-gradient(closest-side, var(--teal-tint), color-mix(in srgb, var(--teal) 50%, transparent) 70%, transparent); top: -4%; right: -10%; }
  .pool--orange { width: 70%; aspect-ratio: 1; background: radial-gradient(closest-side, var(--orange-tint), color-mix(in srgb, var(--orange) 55%, transparent) 70%, transparent); bottom: 2%; left: 18%; }

  .hero__cast {
    position: absolute;
    z-index: 2;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: min(118%, 560px);
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    pointer-events: none;
  }
  .hero__cast :global(.character) {
    animation: bob 3.2s var(--ease) infinite alternate;
    margin-bottom: -2px;
  }
  .hero__cast :global(.character:nth-child(2)) { animation-delay: -1.1s; margin-right: auto; margin-left: 4%; }
  .hero__cast :global(.character:nth-child(3)) { animation-delay: -2.1s; }
  @keyframes bob {
    from { transform: translateY(0) rotate(-1.5deg); }
    to { transform: translateY(-6px) rotate(1.5deg); }
  }

  /* ── Call sheet ── */
  .now { background: var(--ink); color: var(--on-stage); padding-bottom: var(--space-xl); }
  .now__sheet {
    display: grid;
    gap: var(--space-m);
    padding-top: var(--space-l);
  }
  .now__title {
    font-family: var(--font-script);
    font-size: var(--step-0);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--yellow);
  }
  .now__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-m);
  }
  .now__list a {
    display: grid;
    gap: 0.25rem;
    height: 100%;
    padding: 1rem 1.2rem 1.1rem;
    background: var(--paper);
    border-top: 6px solid var(--gel);
    border-radius: var(--r-sm) var(--r-sm) var(--r-md) var(--r-md);
    color: var(--ink-soft);
    text-decoration: none;
    box-shadow: 0 10px 24px -14px rgba(0, 0, 0, 0.7);
    transition: transform 150ms, box-shadow 150ms;
  }
  .now__list a:hover { transform: translateY(-3px); box-shadow: 0 16px 30px -14px rgba(0, 0, 0, 0.85), 0 0 0 3px var(--gel); }
  .now__when { color: var(--gel-ink); font-size: var(--step--1); font-weight: 700; }
  .now__list strong { font-family: var(--font-display); font-size: var(--step-1); font-stretch: 90%; color: var(--ink); }

  /* ── First class free ── */
  .trial { background: var(--yellow); color: var(--ink); padding-block: var(--space-xl); }
  .trial__inner { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr); gap: var(--space-xl); align-items: center; }
  .trial__copy { display: grid; gap: var(--space-s); justify-items: start; }
  .trial__copy .eyebrow { color: var(--ink); }
  .trial h2 { font-size: var(--step-4); }
  .trial__copy p { max-width: 38ch; }
  .trial__steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-m); counter-reset: none; }
  .trial__steps li { display: grid; align-content: start; gap: 0.3rem; padding: 1rem 1.1rem; background: var(--paper); border: 2px solid var(--ink); border-radius: var(--r-md); box-shadow: 4px 4px 0 var(--ink); }
  .trial__steps span:last-child { font-size: var(--step--1); color: var(--ink-soft); }
  .trial__n { display: grid; place-items: center; width: 1.9rem; height: 1.9rem; border-radius: 50%; background: var(--ink); color: var(--yellow); font-family: var(--font-display); font-weight: 800; }
  .trial__steps strong { font-family: var(--font-display); font-size: var(--step-0); line-height: 1.2; }

  /* ── Risers ── */
  .risers {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    align-items: end;
  }
  .riser { display: grid; justify-items: start; }
  .riser__cast { padding-left: 1.2rem; }
  .riser__cast :global(.character) { margin-bottom: -2px; }
  .riser__block {
    width: 100%;
    min-height: calc(10rem + var(--rise) * 3rem);
    padding: 1.2rem 1.2rem 1.4rem;
    background: var(--gel-tint);
    border-top: 6px solid var(--gel);
    display: grid;
    align-content: start;
    gap: 0.4rem;
  }
  .riser:first-child .riser__block { border-radius: var(--r-md) 0 0 var(--r-md); }
  .riser:last-child .riser__block { border-radius: 0 var(--r-md) var(--r-md) 0; }
  .riser__age { font-family: var(--font-script); font-weight: 700; color: var(--gel-ink); }
  .riser h3 { font-size: var(--step-2); }
  .riser ul { list-style: none; margin: 0.3rem 0 0; padding: 0; display: grid; gap: 0.3rem; }
  .riser ul a { color: var(--ink); font-weight: 600; text-decoration-color: var(--gel); }

  /* ── Approach ── */
  .approach {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-l);
  }
  .approach__step { position: relative; display: grid; gap: 0.7rem; align-content: start; }
  .approach__num {
    position: absolute;
    top: 0.8rem;
    left: 0.8rem;
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 50%;
    background: var(--gel);
    color: var(--gel-on);
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.2rem;
  }
  .approach h3 { font-size: var(--step-2); margin-top: 0.3rem; }
  .approach p { color: var(--ink-soft); }

  /* ── Why ── */
  .why {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
    gap: var(--space-2xl);
    align-items: center;
  }
  .why__facts { display: grid; gap: var(--space-m); }
  .facts {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-l) var(--space-xl);
    margin: var(--space-l) 0 0;
  }
  .facts div { display: grid; gap: 0.35rem; align-content: start; }
  .facts dt {
    font-family: var(--font-display);
    font-weight: 800;
    font-stretch: 75%;
    font-size: var(--step-4);
    line-height: 0.95;
    color: var(--gel-ink);
  }
  .facts dd { margin: 0; color: var(--ink-soft); }
  .quote {
    position: relative;
    margin: 0;
    padding: var(--space-xl) var(--space-xl) var(--space-2xl);
    background: var(--paper);
    border: 2px solid var(--ink);
    border-radius: var(--r-lg);
    box-shadow: 8px 8px 0 var(--yellow);
  }
  .quote blockquote { margin: 0; }
  .quote p {
    font-family: var(--font-display);
    font-weight: 550;
    font-size: var(--step-1);
    line-height: 1.4;
  }
  .quote figcaption { margin-top: var(--space-m); font-family: var(--font-script); font-weight: 700; color: var(--purple); }
  .quote__cast { position: absolute; right: 1.2rem; bottom: -1.2rem; }

  /* ── Extras ── */
  .extras__title { font-size: var(--step-3); margin-bottom: var(--space-xl); }
  .extras {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-m);
  }
  .extra {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-m);
    align-items: center;
    height: 100%;
    padding: 1rem 1.2rem;
    background: var(--paper);
    border: 1.5px solid var(--line);
    border-radius: var(--r-md);
    color: var(--ink);
    text-decoration: none;
    transition: border-color 150ms, transform 150ms var(--ease);
  }
  .extra:hover { border-color: var(--ink); transform: translateY(-2px); }
  .extra__cast { width: 64px; height: 64px; border-radius: 50%; background: var(--hall); display: grid; place-items: end center; overflow: hidden; }
  .extra__cast :global(.character) { margin-bottom: -4px; }
  .extra__text { display: grid; gap: 0.15rem; }
