---
/**
 * Schools & partners: theater at your school. Edited at /admin/content/pages/schools.
 */
import Base from '@/layouts/Base.astro';
import Character from '@/components/Character.astro';
import { plain, rich } from '@/content/rich';
import { breadcrumbLd } from '@/lib/seo';

const { testimonial, site, vars, pages } = Astro.locals.content;
const page = pages.schools.schools;
const quote = testimonial(page.quote);
const structuredData = [breadcrumbLd([{ name: 'About', url: new URL('/about', site.url).href }, { name: page.heading }])];
---

<Base
  title={page.heading}
  description={plain(page.lede, vars) || undefined}
  seo={pages.schools.seo}
  structuredData={structuredData}
  edit="/admin/content/pages/schools"
>
  <section class="section about-sub" aria-labelledby="schools-title">
    <div class="wrap">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/about">About</a>
      </nav>
      <div class="schools">
        <div class="stack" style="--stack: var(--space-m)">
          {page.eyebrow && <p class="eyebrow">{page.eyebrow}</p>}
          <h1 id="schools-title">{page.heading}</h1>
          {page.lede && <p class="lede" set:html={rich(page.lede, vars)} />}
          <p set:html={rich(page.body, vars)} />
        </div>
        {
          quote && (
            <figure class="quote-card">
              <blockquote>
                <p>“{quote.quote}”</p>
              </blockquote>
              <figcaption>{quote.attribution}</figcaption>
              <div class="quote-card__cast" aria-hidden="true">
                <Character name="magician" size={70} />
              </div>
            </figure>
          )
        }
      </div>
    </div>
  </section>
</Base>

<style>
  .about-sub { padding-top: var(--space-xl); }
  .crumbs { display: flex; gap: 0.5rem; margin-bottom: var(--space-l); font-size: var(--step--1); color: var(--ink-mute); }
  .crumbs a { color: var(--ink-soft); }
  .schools { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr); gap: var(--space-2xl); align-items: center; }
  .schools h1 { font-size: var(--step-4); }
  .schools p:not(.lede):not(.eyebrow) { color: var(--ink-soft); }
  .quote-card { position: relative; margin: 0; padding: var(--space-xl) var(--space-xl) var(--space-2xl); border: 2px solid var(--ink); border-radius: var(--r-lg); box-shadow: 8px 8px 0 var(--teal); }
  .quote-card blockquote { margin: 0; }
  .quote-card p { font-family: var(--font-display); font-size: var(--step-1); font-weight: 550; line-height: 1.4; }
  .quote-card figcaption { margin-top: var(--space-m); font-family: var(--font-script); font-weight: 700; color: var(--purple); }
  .quote-card__cast { position: absolute; right: 1.2rem; bottom: -1.1rem; }

  @media (max-width: 960px) {
    .schools { grid-template-columns: 1fr; }
  }
</style>
