---
import LeadFormFields from '@/components/LeadFormFields.astro';
import Base from '@/layouts/Base.astro';
import { rich } from '@/content/rich';
import { resolveImage } from '@/lib/media';
import { CONTACT_TOPICS as topics } from '@/lib/contact-topics';

const { site, vars, locations, locationById, pages, uploads, programs } = Astro.locals.content;
// "My child will miss a class": the weekly classes to pick from.
const classNames = [...new Set(programs.filter((p) => p.kind === 'class').map((p) => p.title))];
const page = pages.contact;
const parking = site.parking;
const hq = locationById('hq') ?? locations[0];
// The parking maps, each beside its directions. A tap opens the largest size, so the labels can be read on a phone.
const map = (ref: typeof parking.walkInMap) => {
  const img = resolveImage(ref, uploads);
  return img && ref && { ...img, alt: ref.alt, full: resolveImage(ref, uploads, Infinity)!.src };
};
const routes = [
  { label: 'Walk in', text: parking.walkIn, gel: 'teal', map: map(parking.walkInMap) },
  { label: 'Drop off (after 5 pm)', text: parking.dropOff, gel: 'orange', map: map(parking.dropOffMap) },
];
---

<Base title="Contact" description="Get in touch with Little Characters Theater Troupe at 1635 W Broad St, Athens, GA." seo={page.seo} edit="/admin/content/pages/contact">
  <section class="contact">
    <div class="wrap contact__grid">
      <div class="stack" style="--stack: var(--space-l)">
        {page.hero.eyebrow && <p class="eyebrow">{page.hero.eyebrow}</p>}
        <h1>{page.hero.headline}</h1>
        <p class="lede" set:html={rich(page.hero.intro, vars)} />
        <dl class="direct">
          <div><dt>Email</dt><dd><a href={`mailto:${site.contact.email}`}>{site.contact.email}</a></dd></div>
          <div><dt>Phone</dt><dd><a href={site.contact.phoneHref}>{site.contact.phone}</a></dd></div>
          <div><dt>Visit</dt><dd><a href={hq.mapUrl} rel="noopener">{hq.address.join(', ')}</a></dd></div>
          {
            (site.social.instagram || site.social.facebook) && (
              <div>
                <dt>Follow</dt>
                <dd>
                  {site.social.instagram && <a href={site.social.instagram} rel="noopener">Instagram</a>}
                  {site.social.instagram && site.social.facebook && ' · '}
                  {site.social.facebook && <a href={site.social.facebook} rel="noopener">Facebook</a>}
                </dd>
              </div>
            )
          }
        </dl>
      </div>

      <form
        class="contact__form"
        action="/api/leads"
        method="post"
        id="contact-form"
        data-lead-form
        data-success-title="Thanks! Your message is on its way."
        data-success-body={`Hannah will reply by email.${site.contact.replyTime ? ` ${site.contact.replyTime}` : ''} If it’s urgent, call us at ${site.contact.phone.replaceAll('-', '\u2011').replaceAll(' ', '\u00a0')}.`}
      >
        <LeadFormFields kind="contact" />
        <div class="field">
          <label for="c-name">Your name</label>
          <input id="c-name" name="name" autocomplete="name" required />
        </div>
        <div class="field">
          <label for="c-email">Email</label>
          <input id="c-email" name="email" type="email" autocomplete="email" required />
        </div>
        <div class="field">
          <label for="c-topic">What’s it about?</label>
          <select id="c-topic" name="topic">
            {topics.map((t) => <option value={t.value}>{t.label}</option>)}
          </select>
        </div>
        <fieldset class="absence" data-absence hidden disabled>
          <legend>Who’s missing class?</legend>
          <div class="field">
            <label for="c-child">Your child’s name</label>
            <input id="c-child" name="child" autocomplete="off" maxlength="100" required />
          </div>
          <div class="absence__row">
            <div class="field">
              <label for="c-class">Class</label>
              <select id="c-class" name="className" required>
                <option value="">Choose a class</option>
                {classNames.map((name) => <option>{name}</option>)}
                <option>Another class</option>
              </select>
            </div>
            <div class="field">
              <label for="c-date">Date they’ll miss</label>
              <input id="c-date" name="date" type="date" required />
            </div>
          </div>
        </fieldset>
        <div class="field" data-ages>
          <label for="c-kids">Your child’s age(s) <span class="opt">optional</span></label>
          <input id="c-kids" name="ages" placeholder="e.g. 5 and 8" />
        </div>
        <div class="field">
          <label for="c-msg">Message <span class="opt" data-msg-optional hidden>optional</span></label>
          <textarea id="c-msg" name="message" required></textarea>
        </div>
        <button class="btn btn--primary" type="submit">Send message</button>
        <p class="contact__fine">
          We’ll email you to say it arrived.{site.contact.replyTime && ` ${site.contact.replyTime}`}
        </p>
      </form>
    </div>
  </section>

  <section class="section section--hall" id="parking" aria-labelledby="parking-title">
    <div class="wrap">
      <div class="section-head">
        {page.parking.eyebrow && <p class="eyebrow">{page.parking.eyebrow}</p>}
        <h2 id="parking-title">{page.parking.heading}</h2>
        {hq.notes && <p class="lede">{hq.notes}</p>}
      </div>
      <div class="parking">
        {
          routes.map((r) => (
            <div class:list={['parking__route', { 'has-map': r.map }]}>
              <dl class="parking__card" data-gel={r.gel}>
                <dt>{r.label}</dt>
                <dd>{r.text}</dd>
              </dl>
              {r.map && (
                <figure class="parking__map">
                  <a href={r.map.full}>
                    <img src={r.map.src} srcset={r.map.srcset} sizes="(max-width: 860px) 100vw, 720px" width={r.map.width} height={r.map.height} alt={r.map.alt} loading="lazy" decoding="async" />
                  </a>
                  <figcaption>Tap the map to see it full size.</figcaption>
                </figure>
              )}
            </div>
          ))
        }
        <dl class="parking__card" data-gel="red"><dt>Please don’t</dt><dd>{parking.staffOnly}</dd></dl>
        <dl class="parking__card" data-gel="purple"><dt>Running late?</dt><dd>{parking.late}</dd></dl>
      </div>
    </div>
  </section>
</Base>

<script>
  // Pre-select the topic from links like /contact?topic=party
  const params = new URLSearchParams(location.search);
  const topic = params.get('topic');
  const select = document.getElementById('c-topic') as HTMLSelectElement | null;
  if (topic && select && [...select.options].some((o) => o.value === topic)) select.value = topic;
  // "Ask us" on enrollment links here with the class's name (/contact?topic=class&class=Intro%20to%20Theater).
  const className = params.get('class')?.trim().slice(0, 80);
  const message = document.getElementById('c-msg') as HTMLTextAreaElement | null;
  if (className && message && !message.value && topic !== 'absence') message.value = `About ${className}: `;

  // "My child will miss a class" asks who, which class and when; the message is then optional.
  const absence = document.querySelector<HTMLFieldSetElement>('[data-absence]');
  const ages = document.querySelector<HTMLElement>('[data-ages]');
  const msgOptional = document.querySelector<HTMLElement>('[data-msg-optional]');
  const showTopic = () => {
    const away = select?.value === 'absence';
    if (absence) absence.hidden = absence.disabled = !away;
    if (ages) ages.hidden = away;
    if (msgOptional) msgOptional.hidden = !away;
    if (message) message.required = !away;
  };
  select?.addEventListener('change', showTopic);
  showTopic();
  // "Can’t make it?" in the family account links here with the child, class and next date.
  if (topic === 'absence') {
    const set = (id: string, value: string | null | undefined) => {
      const el = document.getElementById(id) as HTMLInputElement | HTMLSelectElement | null;
      if (el && value && !el.value) el.value = value.trim().slice(0, 100);
    };
    set('c-child', params.get('child'));
    const classSelect = document.getElementById('c-class') as HTMLSelectElement | null;
    if (className && classSelect && [...classSelect.options].some((o) => o.value === className)) classSelect.value = className;
    if (/^\d{4}-\d{2}-\d{2}$/.test(params.get('date') ?? '')) set('c-date', params.get('date'));
  }

  // A signed-in parent doesn't have to type their name and email.
  if (document.cookie.includes('lc_signed_in=1')) {
    fetch('/api/me?for=contact', { credentials: 'same-origin' })
      .then((r) => (r.ok ? r.json() : null))
      .then((me: { signedIn: boolean; name?: string; email?: string } | null) => {
        if (!me?.signedIn) return;
        const name = document.getElementById('c-name') as HTMLInputElement | null;
        const email = document.getElementById('c-email') as HTMLInputElement | null;
        if (name && !name.value && me.name && !me.name.includes('@')) name.value = me.name;
        if (email && !email.value && me.email) email.value = me.email;
      })
      .catch(() => {});
  }
</script>

<style>
  .contact { padding-block: var(--space-2xl) var(--space-3xl); }
  .contact__grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: var(--space-2xl); align-items: start; }
  .direct { margin: 0; display: grid; gap: 0.6rem; }
  .direct div { display: grid; grid-template-columns: 6.5rem 1fr; gap: 0.5rem; }
  .direct dt { font-family: var(--font-script); font-weight: 700; color: var(--ink-mute); text-transform: uppercase; font-size: var(--step--1); padding-top: 0.15rem; }
  .direct dd { margin: 0; font-weight: 600; }
  .contact__form { display: grid; gap: var(--space-m); padding: var(--space-xl); background: var(--hall); border-radius: var(--r-lg); }
  .contact__form .btn { justify-self: start; }
  .opt { font-weight: 400; color: var(--ink-mute); }
  .absence { display: grid; gap: var(--space-m); margin: 0; padding: var(--space-m); border: 1.5px solid var(--line-strong); border-radius: var(--r-md); background: var(--paper); min-width: 0; }
  .absence[hidden] { display: none; }
  .absence legend { padding: 0 0.4rem; font-family: var(--font-display); font-weight: 700; }
  .absence__row { display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); gap: var(--space-m); }
  .contact__fine { margin: 0; font-size: var(--step--1); color: var(--ink-mute); }
  [data-ages][hidden] { display: none; }
  .parking { margin: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-m); }
  .parking__card { margin: 0; padding: 1.1rem 1.3rem; background: var(--paper); border-radius: var(--r-md); border-left: 6px solid var(--gel); }
  .parking__route.has-map { grid-column: 1 / -1; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr); gap: var(--space-m); align-items: start; }
  .parking__map { margin: 0; display: grid; gap: 0.4rem; }
  .parking__map a { display: block; border-radius: var(--r-md); overflow: hidden; cursor: zoom-in; }
  .parking__map img { display: block; width: 100%; height: auto; }
  .parking__map figcaption { font-size: var(--step--1); color: var(--ink-mute); }
  .parking dt { font-family: var(--font-display); font-weight: 750; font-size: 1.1rem; font-stretch: 92%; }
  .parking__card dd { margin: 0.2rem 0 0; color: var(--ink-soft); }
  @media (max-width: 860px) {
    .contact__grid, .parking, .parking__route.has-map, .absence__row { grid-template-columns: 1fr; }
  }
</style>
