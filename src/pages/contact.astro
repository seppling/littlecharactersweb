---
import Base from '@/layouts/Base.astro';
import { site } from '@/config/site';
import { locations, parking } from '@/data/locations';

const topics = [
  { value: 'general', label: 'A general question' },
  { value: 'class', label: 'Help picking a class' },
  { value: 'camps', label: 'Camps & workshops' },
  { value: 'private-lessons', label: 'Private lessons' },
  { value: 'party', label: 'A party' },
  { value: 'scholarship', label: 'Scholarships & pay-what-you-can' },
  { value: 'needs', label: 'My child’s specific needs' },
];
const hq = locations.find((l) => l.id === 'hq')!;
---

<Base title="Contact" description="Get in touch with Little Characters Theater Troupe at 1635 W Broad St, Athens, GA.">
  <section class="contact">
    <div class="wrap contact__grid">
      <div class="stack" style="--stack: var(--space-l)">
        <p class="eyebrow">Say hello</p>
        <h1>Contact us!</h1>
        <p class="lede">Interested but need more info? The class times don’t work for you? Questions about scholarships? We’re eager to make a class work for your family.</p>
        <dl class="direct">
          <div><dt>Email</dt><dd><a href={`mailto:${site.contact.email}`}>{site.contact.email}</a></dd></div>
          <div><dt>Phone</dt><dd><a href={site.contact.phoneHref}>{site.contact.phone}</a></dd></div>
          <div><dt>Visit</dt><dd><a href={hq.mapUrl} rel="noopener">{hq.address.join(', ')}</a></dd></div>
          <div><dt>Follow</dt><dd><a href={site.social.instagram} rel="noopener">Instagram</a> · <a href={site.social.facebook} rel="noopener">Facebook</a></dd></div>
        </dl>
      </div>

      <form class="contact__form" action={site.forms.contactAction || undefined} method="post" id="contact-form">
        <div class="field">
          <label for="c-name">Your name</label>
          <input id="c-name" name="name" autocomplete="name" required />
        </div>
        <div class="field">
          <label for="c-email">Email</label>
          <input id="c-email" name="email" type="email" autocomplete="email" required />
        </div>
        <div class="field">
          <label for="c-topic">What’s it about?</label>
          <select id="c-topic" name="topic">
            {topics.map((t) => <option value={t.value}>{t.label}</option>)}
          </select>
        </div>
        <div class="field">
          <label for="c-kids">Your child’s age(s) <span class="opt">optional</span></label>
          <input id="c-kids" name="ages" placeholder="e.g. 5 and 8" />
        </div>
        <div class="field">
          <label for="c-msg">Message</label>
          <textarea id="c-msg" name="message" required></textarea>
        </div>
        <button class="btn btn--primary" type="submit">Send message</button>
      </form>
    </div>
  </section>

  <section class="section section--hall" id="parking" aria-labelledby="parking-title">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">One of our favorite topics</p>
        <h2 id="parking-title">Parking & drop-off</h2>
        <p class="lede">{hq.notes}</p>
      </div>
      <dl class="parking">
        <div data-gel="teal"><dt>Walk in</dt><dd>{parking.walkIn}</dd></div>
        <div data-gel="orange"><dt>Drop off (after 5 pm)</dt><dd>{parking.dropOff}</dd></div>
        <div data-gel="red"><dt>Please don’t</dt><dd>{parking.staffOnly}</dd></div>
        <div data-gel="purple"><dt>Running late?</dt><dd>{parking.late}</dd></div>
      </dl>
      <p class="parking__more"><a href={parking.guideUrl} rel="noopener">Download the full parking guide (PDF)</a></p>
    </div>
  </section>
</Base>

<script>
  // Pre-select the topic from links like /contact?topic=party
  const topic = new URLSearchParams(location.search).get('topic');
  const select = document.getElementById('c-topic') as HTMLSelectElement | null;
  if (topic && select && [...select.options].some((o) => o.value === topic)) select.value = topic;
</script>

<style>
  .contact { padding-block: var(--space-2xl) var(--space-3xl); }
  .contact__grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: var(--space-2xl); align-items: start; }
  .direct { margin: 0; display: grid; gap: 0.6rem; }
  .direct div { display: grid; grid-template-columns: 6.5rem 1fr; gap: 0.5rem; }
  .direct dt { font-family: var(--font-script); font-weight: 700; color: var(--ink-mute); text-transform: uppercase; font-size: var(--step--1); padding-top: 0.15rem; }
  .direct dd { margin: 0; font-weight: 600; }
  .contact__form { display: grid; gap: var(--space-m); padding: var(--space-xl); background: var(--hall); border-radius: var(--r-lg); }
  .contact__form .btn { justify-self: start; }
  .opt { font-weight: 400; color: var(--ink-mute); }
  .parking { margin: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-m); }
  .parking div { padding: 1.1rem 1.3rem; background: var(--paper); border-radius: var(--r-md); border-left: 6px solid var(--gel); }
  .parking dt { font-family: var(--font-display); font-weight: 750; font-size: 1.1rem; font-stretch: 92%; }
  .parking dd { margin: 0.2rem 0 0; color: var(--ink-soft); }
  .parking__more { margin-top: var(--space-l); }
  @media (max-width: 860px) {
    .contact__grid, .parking { grid-template-columns: 1fr; }
  }
</style>
