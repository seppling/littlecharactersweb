---
/**
 * A show's own page: what its card on /events says, plus its photo, for
 * sharing and for Google's event results. It stays after the show, so shared
 * links keep working. Other events have no page: their addresses go to /events
 * (see src/lib/redirects.ts and src/middleware.ts).
 */
import Base from '@/layouts/Base.astro';
import PhotoFrame from '@/components/PhotoFrame.astro';
import { dateRange, timeRange } from '@/lib/format';
import { hasShowPage, isPastShow, showPageLd } from '@/lib/events';
import { shareImage } from '@/lib/media';
import { todayInAthens } from '@/lib/pricing';

const { events, locationById, site, uploads } = Astro.locals.content;
const found = events.find((e) => e.slug === Astro.params.slug && hasShowPage(e));
if (!found) return Astro.rewrite('/404');
const event = found;

const today = todayInAthens();
const past = isPastShow(event, today);
const dated = event.times.length > 0;
const location = event.venue ? undefined : locationById(event.locationId);
const expected = event.tba ? new Date(`${event.tba}-15T12:00`).toLocaleDateString('en-US', { month: 'long', year: 'numeric' }) : undefined;
const extras = [event.ages && `Ages ${event.ages}`, event.price].filter(Boolean).join(' · ');

const pageUrl = new URL(`/events/${event.slug}`, site.url).href;
const photo = shareImage(event.image, uploads);
const structuredData = showPageLd(event, {
  site,
  location,
  pageUrl,
  image: photo && new URL(photo.src, site.url).href,
  today,
});
---

<Base title={event.title} description={event.summary} seo={event.seo} image={event.image} structuredData={structuredData} edit={`/admin/content/events/${event.slug}`}>
  <article class="show" data-gel={event.gel}>
    <div class:list={['wrap', 'show__grid', { 'show__grid--photo': event.image?.src }]}>
      <div class="show__text stack" style="--stack: var(--space-l)">
        <nav class="crumbs" aria-label="Breadcrumb">
          <a href="/events">Shows & events</a>
        </nav>
        {
          past && (
            <p class="show__past" role="note">
              This show has already happened. <a href="/events">See what’s coming up</a>
            </p>
          )
        }
        <div class="show__tags">
          <span class="tape">Show</span>
          {event.ages && <span class="tape tape--quiet" data-tilt="right">Ages {event.ages}</span>}
        </div>
        <h1>{event.title}</h1>
        <dl class="show__facts">
          <div>
            <dt>When</dt>
            <dd>
              {!dated && <span>Date coming soon{expected && ` (expected ${expected})`}</span>}
              {
                event.times.map((t) => (
                  <span class="show__time">
                    {dateRange(t.start, t.start)}, {timeRange(t.start.slice(11, 16), t.end.slice(11, 16))}
                  </span>
                ))
              }
            </dd>
          </div>
          {
            (event.venue || location) && (
              <div>
                <dt>Where</dt>
                <dd>
                  {event.venue ?? location!.name}
                  {location && <span class="show__address">{location.address.join(', ')}</span>}
                  {location?.mapUrl && <a class="show__map" href={location.mapUrl} rel="noopener">Map</a>}
                </dd>
              </div>
            )
          }
          {
            extras && (
              <div>
                <dt>Cost</dt>
                <dd>{extras}</dd>
              </div>
            )
          }
        </dl>
        {
          !past && (event.cta || dated) && (
            <div class="show__actions">
              {event.cta && <a class="btn btn--orange" href={event.cta.href}>{event.cta.label}</a>}
              {dated && <a class="show__cal" href={`/events/${event.slug}.ics`} download>Add to calendar</a>}
            </div>
          )
        }
        <p class="show__summary">{event.summary}</p>
        <p><a class="link-arrow" href="/events">All shows & events <span class="arrow" aria-hidden="true">→</span></a></p>
      </div>
      {event.image?.src && <PhotoFrame image={event.image} gel={event.gel} shape="arch" ratio="5 / 6" class="show__photo" eager />}
    </div>
  </article>
</Base>

<style>
  .show { padding-block: var(--space-xl) var(--space-3xl); background: linear-gradient(180deg, var(--gel-tint), var(--paper) 60%); }
  .show__grid { display: grid; grid-template-columns: minmax(0, 46rem); gap: var(--space-2xl); align-items: start; }
  .show__grid--photo { grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.75fr); }
  .show h1 { font-size: var(--step-5); }
  .show :global(.show__photo) { width: 100%; max-width: 400px; justify-self: end; }
  .crumbs { display: flex; gap: 0.5rem; font-size: var(--step--1); color: var(--ink-mute); }
  .crumbs a { color: var(--ink-soft); }
  .show__tags { display: flex; flex-wrap: wrap; gap: 0.6rem; }
  .show__tags .tape { --tape: var(--gel); }
  .show__tags .tape--quiet { --tape: var(--paper); box-shadow: inset 0 0 0 2px var(--gel); }
  .show__past {
    padding: 0.8rem 1rem;
    border: 2px dashed var(--gel-ink);
    border-radius: var(--r-md);
    font-weight: 600;
  }
  .show__facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    gap: 1rem 1.5rem;
    margin: 0;
    padding-top: var(--space-m);
    border-top: 2px solid var(--ink);
  }
  .show__facts dt { font-family: var(--font-script); font-weight: 700; font-size: var(--step--1); text-transform: uppercase; letter-spacing: 0.04em; color: var(--gel-ink); }
  .show__facts dd { margin: 0.2rem 0 0; font-weight: 600; display: grid; gap: 0.15rem; justify-items: start; }
  .show__address { font-weight: 400; color: var(--ink-soft); }
  .show__map { font-weight: 600; font-size: var(--step--1); }
  .show__actions { display: flex; flex-wrap: wrap; align-items: center; gap: 0.6rem 1.2rem; }
  .show__cal { font-weight: 600; }
  .show__summary { font-size: var(--step-1); max-width: 60ch; }

  @media (max-width: 960px) {
    .show__grid, .show__grid--photo { grid-template-columns: minmax(0, 1fr); }
    .show :global(.show__photo) { justify-self: start; max-width: 320px; order: -1; }
  }
</style>
