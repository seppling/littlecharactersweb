---
/** Enrollment step 4: you're in. Everything needed for the first class, in one place. */
import Base from '@/layouts/Base.astro';
import EnrollShell from '@/components/portal/EnrollShell.astro';
import Character from '@/components/Character.astro';
import { autopayLine, familyTotals, getOrder, householdForUser, listStudents } from '@/server/family';
import AnotherChild from '@/components/portal/AnotherChild.astro';
import { completeCheckout, paymentsMode } from '@/server/payments';
import { dayList, timeRange } from '@/lib/format';
import { formatCents, meetings, todayInAthens } from '@/lib/pricing';
import { arrivalLines, isOneOff, oneOffWhen } from '@/lib/program-fit';

export const prerender = false;
const { locationById, site } = Astro.locals.content;
const parking = site.parking;

const user = Astro.locals.user;
if (!user) return Astro.redirect('/account');
const household = await householdForUser(user.id);
const orderId = Astro.url.searchParams.get('order') ?? '';
let o = household ? await getOrder(household.id, orderId) : null;
if (!household || !o) return Astro.redirect('/account');
// A drop-in's checkout returns here (createEmbeddedCheckout's return address); it has its own page.
if (o.plan === 'drop_in') return Astro.redirect(`/drop-in/confirmation${Astro.url.search}`);

// Returning from Stripe: confirm the payment (the webhook may not have landed yet).
const checkoutId = Astro.url.searchParams.get('checkout');
if (o.status !== 'paid' && checkoutId && paymentsMode === 'stripe') {
  const done = await completeCheckout(checkoutId, user.id);
  if (done.paid && done.orderId === o.id) o = await getOrder(household.id, o.id);
}
if (!o) return Astro.redirect('/account');
if (o.status !== 'paid') return Astro.redirect(`/enroll/review?order=${o.id}`);

const { program, session } = Astro.locals.content.findSession(o.sessionId)!;
const kids = (await listStudents(household.id)).filter((s) => o!.studentIds.includes(s.id));
const names = kids.map((k) => k.firstName).join(' and ');
const loc = locationById(session.locationId);
const first = meetings(session).find((m) => m >= todayInAthens()) ?? session.startDate;
const firstDate = new Date(`${first}T12:00:00Z`).toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric', timeZone: 'UTC' });
const waitlist = o.plan === 'waitlist';
// One date (a night out, the free class): its date and time in one line, no "first class".
const oneOff = isOneOff(session);
const arrival = arrivalLines(program, parking);
// The whole family, read from their payments: what today's sign-ups cost, and
// autopay on the next 1st. Shown once there's more than this one sign-up to add up.
const totals = await familyTotals(household.id);
const nextFirst = new Date(`${totals.nextFirst}T12:00:00Z`).toLocaleDateString('en-US', { month: 'long', day: 'numeric', timeZone: 'UTC' });
const ownNext = o.schedule.some((c) => c.dueDate === totals.nextFirst) ? 1 : 0;
const showTotals = !waitlist && (totals.signUpsToday > 1 || totals.nextMonthOrders > ownNext);
---

<Base title="You’re in!" noindex>
  <EnrollShell step={4} program={program} session={session}>
    <div class="done">
      <div class="done__cast" aria-hidden="true">
        <Character name="royal" size={70} />
        <Character name="artist" size={62} />
        <Character name="magician" size={56} />
      </div>
      <h1>{waitlist ? 'You’re on the waitlist.' : 'You’re in!'}</h1>
      <p class="lede">
        {waitlist
          ? `We’ll email you as soon as a spot opens for ${names} in ${program.title}.`
          : `${names} ${kids.length > 1 ? 'are' : 'is'} enrolled in ${program.title}. We sent a confirmation to ${user.email}.`}
      </p>
    </div>

    {
      !waitlist && (
        <dl class="facts">
          {oneOff ? (
            <div class="wide"><dt>When</dt><dd>{oneOffWhen(program, session)}</dd></div>
          ) : (
            <>
              <div><dt>First class</dt><dd>{firstDate}</dd></div>
              <div><dt>Time</dt><dd>{dayList(session.days)}, {timeRange(session.start, session.end)}</dd></div>
            </>
          )}
          {loc && <div><dt>Where</dt><dd>{loc.name}<br /><span class="muted">{loc.address.join(', ')}</span></dd></div>}
          <div><dt>{o.plan === 'trial' ? 'Today' : 'Paid'}</dt><dd>{o.plan === 'trial' ? 'Your first class is free' : formatCents(o.totalCents)}</dd></div>
        </dl>
      )
    }

    {
      showTotals && (
        <div class="family-totals" data-family-totals>
          <h2>Your family</h2>
          <dl>
            <div><dt>Paid today</dt><dd>{formatCents(totals.paidTodayCents)} <span class="muted">for {totals.signUpsToday} {totals.signUpsToday === 1 ? 'sign-up' : 'sign-ups'}</span></dd></div>
            {totals.nextMonthOrders > 0 && (
              <div><dt>From {nextFirst}</dt><dd>{formatCents(totals.nextMonthCents)} a month <span class="muted">in autopay, for every class</span></dd></div>
            )}
          </dl>
        </div>
      )
    }

    {
      !waitlist && (
        <div class="actions">
          <a class="btn btn--primary" href={`/calendar/${session.id}.ics`} download>Add to calendar</a>
          <a class="btn btn--outline" href="/account">Go to your family account</a>
        </div>
      )
    }

    <div class="bring">
      <h2>{oneOff ? 'Before you come' : 'Before the first class'}</h2>
      <ul>
        {arrival.map((line) => <li>{line}</li>)}
        {o.plan === 'monthly' && o.schedule.length > 0 && <li>{autopayLine(o.schedule)} You can see upcoming charges in your family account.</li>}
      </ul>
    </div>

    <AnotherChild />
  </EnrollShell>
</Base>

<style>
  .done { display: grid; gap: var(--space-s); }
  .done__cast { display: flex; align-items: flex-end; gap: 0.3rem; }
  h1 { font-size: var(--step-4); }
  .facts { margin: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-m); padding: var(--space-l); background: var(--hall); border-radius: var(--r-md); }
  .facts dt { font-family: var(--font-script); font-weight: 700; font-size: var(--step--2); text-transform: uppercase; color: var(--purple); }
  .facts dd { margin: 0.2rem 0 0; font-weight: 600; }
  .facts .wide { grid-column: 1 / -1; }
  .muted { color: var(--ink-mute); font-weight: 400; }
  .actions { display: flex; flex-wrap: wrap; gap: 0.75rem; }
  .family-totals { display: grid; gap: 0.5rem; padding: var(--space-m) var(--space-l); border: 2px solid var(--ink); border-radius: var(--r-md); }
  .family-totals h2 { font-size: var(--step-1); }
  .family-totals dl { margin: 0; display: grid; gap: 0.4rem; }
  .family-totals dl > div { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.2rem 1rem; }
  .family-totals dt { font-weight: 650; }
  .family-totals dd { margin: 0; font-weight: 700; font-variant-numeric: tabular-nums; }
  .bring h2 { font-size: var(--step-1); margin-bottom: 0.5rem; }
  .bring ul { margin: 0; padding-left: 1.2rem; display: grid; gap: 0.4rem; color: var(--ink-soft); }
  @media (max-width: 520px) { .facts { grid-template-columns: 1fr; } }
</style>
