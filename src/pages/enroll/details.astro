---
/**
 * Enrollment step 2: care details for each student, the family's part
 * (emergency contacts, who may pick up, ZIP, how they heard about us), and one
 * policy checkbox. Each is asked once, then confirmed yearly: details confirmed
 * within the year get a one-line summary with "Edit" instead of the form.
 */
import { eq } from 'drizzle-orm';
import Base from '@/layouts/Base.astro';
import EnrollShell from '@/components/portal/EnrollShell.astro';
import { getDb, schema } from '@/server/db';
import { getFamilyDetails, getOrder, householdForUser, listStudents, readStudentNotes, studentDetailsInput, updateFamilyDetails, updateStudentDetails } from '@/server/family';
import FamilyDetailsFields from '@/components/portal/FamilyDetailsFields.astro';
import { familyDetailsOnFile, familySummary, readFamilyForm } from '@/lib/family-details';
import { detailsSummary, needsDetailsForm } from '@/lib/student-details';

import { bookingClock, bookingProblem } from '@/lib/session-dates';
import { isOneOff, oneOffPolicies } from '@/lib/program-fit';

export const prerender = false;

const user = Astro.locals.user;
if (!user) return Astro.redirect('/account');
const household = await householdForUser(user.id);
const orderId = Astro.url.searchParams.get('order') ?? '';
const o = household ? await getOrder(household.id, orderId) : null;
if (!household || !o || o.status === 'paid') return Astro.redirect('/account');
const found = Astro.locals.content.findSession(o.sessionId)!;
// A drop-in (one class of a weekly class, src/server/drop-ins.ts): its date is checked on the pay step instead.
const dropIn = o.plan === 'drop_in';
// The date closed since this order was started: the first step explains, with a link back to the class.
const closed = () => bookingProblem(found.program, found.session, bookingClock(Astro.locals.content.site.lateJoinWeeks));
if (!dropIn && closed()) return Astro.redirect(`/enroll/${o.sessionId}`, 303);
const firstStep = dropIn ? `/drop-in/${o.sessionId}` : `/enroll/${o.sessionId}`;

// A single date (a night out, the free class) has its own short rules, not the monthly-tuition ones.
const policies = dropIn
  ? [
      'A drop-in is one class, on the date you picked, paid today. Missed classes aren’t refunded.',
      'Doors lock 5 minutes after class starts; walk late students to the front door.',
    ]
  : isOneOff(found.session)
  ? oneOffPolicies(found.program, found.session)
  : [
      'Monthly tuition is charged automatically to your saved card on the 1st. Balances still unpaid after the 10th have a $15 late fee.',
      'To unenroll, tell us at least 5 days before the next billing date. Missed classes aren’t refunded.',
      'Doors lock 5 minutes after class starts; walk late students to the front door.',
    ];

const students = (await listStudents(household.id)).filter((s) => o.studentIds.includes(s.id));
const errors: Record<string, string> = {};
const editing = Astro.url.searchParams.get('edit');
const family = await getFamilyDetails(household.id);
// The family's part, like each child's: a summary when a parent confirmed it this year, unless they tap Edit.
const askFamily = !family || !familyDetailsOnFile(family) || editing === 'family';
const askHeard = !family?.heardAbout;
let familyErrors: Record<string, string> = {};
let familyValues: Record<string, string> | null = null;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  if (form.get('policies') !== 'on') errors.policies = 'Please agree to the policies to continue.';
  // Only the forms on the page are read; a student shown as a summary keeps what's on file.
  const asked = students.filter((s) => form.get(`details-${s.id}`) === '1' || needsDetailsForm(s, editing));
  const parsedAll = asked.map((s) => ({
    s,
    parsed: studentDetailsInput.safeParse({
      allergies: String(form.get(`allergies-${s.id}`) ?? ''),
      medicalNotes: String(form.get(`medical-${s.id}`) ?? ''),
      pickupNotes: String(form.get(`pickup-${s.id}`) ?? ''),
      photoConsent: form.get(`photo-${s.id}`) === 'yes' ? true : form.get(`photo-${s.id}`) === 'no' ? false : undefined,
    }),
  }));
  for (const { s, parsed } of parsedAll) if (!parsed.success) errors[s.id] = 'Choose a photo preference.';
  const familyForm = askFamily || form.get('family-details') === '1' ? readFamilyForm(form, { askHeard }) : null;
  if (familyForm && !familyForm.data) {
    familyErrors = familyForm.errors;
    familyValues = Object.fromEntries([...form.entries()].map(([k, v]) => [k, String(v)]));
    errors.family = 'Check the family details.';
  }

  if (!Object.keys(errors).length) {
    for (const { s, parsed } of parsedAll) if (parsed.success) await updateStudentDetails(household.id, s.id, parsed.data, user.id);
    if (familyForm?.data) await updateFamilyDetails(household.id, familyForm.data, user.id);
    const db = await getDb();
    await db.update(schema.order).set({ policyAcceptedAt: new Date() }).where(eq(schema.order.id, o.id));
    return Astro.redirect(dropIn ? `/drop-in/pay?order=${o.id}` : `/enroll/review?order=${o.id}`, 303);
  }
}
---

<Base title={`Enroll: ${found.program.title}`} noindex>
  <EnrollShell step={2} program={found.program} session={found.session} dropInCents={dropIn ? o.totalCents : undefined}>
    <form method="post" class="form">
      <h1>A few details</h1>
      <p class="lede">
        {students.every((s) => !needsDetailsForm(s, editing)) && !askFamily
          ? 'We have these on file from this year. Edit anything that’s changed, then agree to the policies.'
          : 'So teachers can take good care of everyone. You only fill this in once; we’ll ask you to confirm it each year.'}
      </p>

      {
        students.map((s) => {
          const notes = readStudentNotes(s);
          if (!needsDetailsForm(s, editing)) {
            return (
              <div class="kid kid--on-file" data-details-on-file>
                <p>
                  <strong>{s.firstName} {s.lastName}</strong> <span class="fresh">✓ On file</span>
                  <span class="summary">{detailsSummary({ firstName: s.firstName, ...notes, pickupNotes: s.pickupNotes, photoConsent: s.photoConsent })}</span>
                </p>
                <a href={`/enroll/details?order=${o.id}&edit=${s.id}`}>Edit<span class="sr-only"> {s.firstName}’s details</span></a>
              </div>
            );
          }
          return (
            <fieldset class="kid">
              <input type="hidden" name={`details-${s.id}`} value="1" />
              <legend>{s.firstName} {s.lastName}</legend>
              {editing === s.id && <p class="fresh">✓ On file from before. Update anything that’s changed.</p>}
              <div class="field">
                <label for={`allergies-${s.id}`}>Allergies <span class="opt">optional</span></label>
                <input id={`allergies-${s.id}`} name={`allergies-${s.id}`} value={notes.allergies} placeholder="e.g. peanuts, bee stings" />
              </div>
              <div class="field">
                <label for={`medical-${s.id}`}>Medical notes or support needs <span class="opt">optional</span></label>
                <textarea id={`medical-${s.id}`} name={`medical-${s.id}`} rows="3" placeholder="Anything that helps us support your child, including sensory needs. Ask us about a 1:1 class buddy.">{notes.medicalNotes}</textarea>
                <p class="hint">Stored encrypted and only visible to teaching staff.</p>
              </div>
              <div class="field">
                <label for={`pickup-${s.id}`}>Pickup notes for {s.firstName} <span class="opt">optional</span></label>
                <input id={`pickup-${s.id}`} name={`pickup-${s.id}`} value={s.pickupNotes ?? ''} placeholder="Anything just for this child, like “only Dad on Tuesdays”" />
              </div>
              <div class="field">
                <span class="label">Photos</span>
                <div class="choices">
                  <label><input type="radio" name={`photo-${s.id}`} value="yes" checked={s.photoConsent === true} required /> OK to share photos of {s.firstName} online</label>
                  <label><input type="radio" name={`photo-${s.id}`} value="no" checked={s.photoConsent === false} required /> Please don’t share photos of {s.firstName}</label>
                </div>
                {errors[s.id] && <p class="error">{errors[s.id]}</p>}
              </div>
            </fieldset>
          );
        })
      }

      {
        askFamily ? (
          <fieldset class="kid" data-family-form>
            <input type="hidden" name="family-details" value="1" />
            <legend>Your family</legend>
            <p class="who">
              {editing === 'family' ? '✓ On file from before. Update anything that’s changed. ' : 'Asked once for the whole family. '}
              Little Characters staff see these, and from spring, the teachers of your children’s classes.
            </p>
            <FamilyDetailsFields details={family} values={familyValues} errors={familyErrors} askHeard={askHeard} />
          </fieldset>
        ) : (
          <div class="kid kid--on-file" data-family-on-file>
            <p>
              <strong>Your family</strong> <span class="fresh">✓ On file</span>
              <span class="summary">{familySummary(family!)}</span>
            </p>
            <a href={`/enroll/details?order=${o.id}&edit=family`}>Edit<span class="sr-only"> your family details</span></a>
          </div>
        )
      }

      <div class="policies">
        <h2>The short version of our policies</h2>
        <ul>
          {policies.map((line) => <li>{line}</li>)}
        </ul>
        <p><a href="/policies" target="_blank" rel="noopener">Read our full policies</a></p>
        <label class="agree">
          <input type="checkbox" name="policies" required />
          <span>I’ve read and agree to the Little Characters policies.</span>
        </label>
        {errors.policies && <p class="error">{errors.policies}</p>}
      </div>

      <div class="actions">
        <a class="back" href={firstStep}>← Back</a>
        <button class="btn btn--primary" type="submit">Review & pay <span class="arrow" aria-hidden="true">→</span></button>
      </div>
    </form>
  </EnrollShell>
</Base>

<style>
  h1 { font-size: var(--step-3); }
  .form { display: grid; gap: var(--space-l); }
  .kid { border: 1.5px solid var(--line); border-radius: var(--r-md); padding: var(--space-l); margin: 0; display: grid; gap: var(--space-m); }
  .kid legend { font-family: var(--font-display); font-weight: 750; font-size: var(--step-1); padding: 0 0.4rem; }
  .fresh { color: var(--ok); font-weight: 600; font-size: var(--step--1); }
  .kid--on-file { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; padding-block: var(--space-m); }
  .kid--on-file p { margin: 0; display: flex; flex-wrap: wrap; gap: 0.2rem 0.6rem; align-items: baseline; min-width: 0; }
  .kid--on-file .summary { flex-basis: 100%; color: var(--ink-soft); font-size: var(--step--1); overflow-wrap: anywhere; }
  .kid--on-file a { font-weight: 650; flex: none; }
  .opt { font-weight: 400; color: var(--ink-mute); }
  .hint { font-size: var(--step--2); color: var(--ink-mute); }
  .who { margin: 0; font-size: var(--step--1); color: var(--ink-soft); }
  .label { font-weight: 650; font-size: var(--step--1); }
  .choices { display: grid; gap: 0.4rem; }
  .choices label { display: flex; gap: 0.5rem; align-items: center; font-weight: 400; }
  .choices input, .agree input { flex: none; accent-color: var(--purple); width: 1.35rem; height: 1.35rem; }
  .policies { display: grid; gap: 0.6rem; padding: var(--space-l); background: var(--hall); border-radius: var(--r-md); }
  .policies h2 { font-size: var(--step-1); }
  .policies ul { margin: 0; padding-left: 1.2rem; color: var(--ink-soft); display: grid; gap: 0.3rem; }
  .agree { display: flex; gap: 0.6rem; align-items: center; font-weight: 600; }
  .error { color: var(--red-ink); font-size: var(--step--1); font-weight: 600; }
  .actions { display: flex; justify-content: space-between; align-items: center; gap: 1rem; }
</style>
