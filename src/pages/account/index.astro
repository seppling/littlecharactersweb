---
/** Family account: sign in, or see every child's classes, details and payments in one place. */
import { eq } from 'drizzle-orm';
import { z } from 'zod';
import Base from '@/layouts/Base.astro';
import Character from '@/components/Character.astro';
import SignInPanel from '@/components/portal/SignInPanel.astro';
import { getDb, schema } from '@/server/db';
import { ageOn, confirmFamilyDetails, createStudent, detailsFresh, ensureHousehold, getFamilyDetails, householdAccount, listEnrollments, listOrders, listStudents, studentInput } from '@/server/family';
import { familyDetailsComplete, familyDetailsOnFile, personLine } from '@/lib/family-details';
import { today as staffToday } from '@/lib/admin-links';
import { dayList, timeRange } from '@/lib/format';
import { formatCents, meetings, todayInAthens } from '@/lib/pricing';
import { bookingClock, canBook, sessionState } from '@/lib/session-dates';
import { failureReason, listInstallments, totalDue } from '@/server/billing';
import { dayOffFrom, daysOffBetween } from '@/server/class-day';
import { noClassLine } from '@/server/days-off';
import { adjustmentLine, discountLines } from '@/lib/adjustments';
import { cardLabel, groupAutopay, namesList, studioDirectorWelcome } from '@/lib/account';
import { dropInClasses, dropInDay, familyDropIns } from '@/server/drop-ins';
import { familyPayments, refundNote } from '@/server/refunds';
import { familyCredits } from '@/server/credits';
import { statementYears } from '@/server/statements';

export const prerender = false;
const { locationById, site } = Astro.locals.content;
const email = site.contact.email;

const user = Astro.locals.user;
const errors: Record<string, string> = {};
let values: Record<string, string> = {};

if (user && Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  values = Object.fromEntries([...form.entries()].map(([k, v]) => [k, String(v)]));
  if (values.action === 'profile') {
    const parsed = z
      .object({ name: z.string().trim().min(2, 'Add your first and last name').max(100), phone: z.string().trim().regex(/^[\d\s()+.-]{7,20}$/, 'Add a phone number') })
      .safeParse(values);
    if (parsed.success) {
      const db = await getDb();
      await db.update(schema.user).set(parsed.data).where(eq(schema.user.id, user.id));
      await ensureHousehold({ ...user, name: parsed.data.name });
      return Astro.redirect('/account', 303);
    }
    for (const i of parsed.error.issues) errors[String(i.path[0])] = i.message;
  }
  if (values.action === 'add-student') {
    const h = await ensureHousehold(user);
    const parsed = studentInput.safeParse(values);
    if (parsed.success) {
      await createStudent(h.id, parsed.data, user.id);
      return Astro.redirect('/account#students', 303);
    }
    for (const i of parsed.error.issues) errors[String(i.path[0])] = i.message;
  }
  // "Looks right" on the family details: nothing changes but the date they were last checked.
  if (values.action === 'confirm-family') {
    const h = await ensureHousehold(user);
    await confirmFamilyDetails(h.id, user.id);
    return Astro.redirect('/account?saved=family#family', 303);
  }
}

const needsProfile = !!user && !user.name?.trim();
const household = user && !needsProfile ? await ensureHousehold(user) : null;
const students = household ? await listStudents(household.id) : [];
const enrollments = household ? await listEnrollments(household.id) : [];
const orders = household ? await listOrders(household.id) : [];
const installments = household ? await listInstallments(household.id) : [];
const account = household ? await householdAccount(household.id) : null;
const family = household ? await getFamilyDetails(household.id) : null;
const familyFresh = !!family && familyDetailsOnFile(family);
const familyStarted = !!family && (family.emergencyContacts.length > 0 || family.pickupPeople.length > 0 || !!family.zip);
const familyCheckedOn = family?.contactsConfirmedAt?.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'America/New_York' });
const needsAttention = installments.filter((i) => i.status === 'failed');
const autopay = installments.filter((i) => i.status === 'scheduled' || i.status === 'processing');
// Who each order (and so each monthly payment) is for, by first name.
const firstNames = new Map(students.map((s) => [s.id, s.firstName]));
const orderKids = new Map(orders.map((o) => [o.id, o.studentIds.map((id) => firstNames.get(id)).filter((n): n is string => !!n)]));
const autopayGroups = groupAutopay(autopay, (i) => orderKids.get(i.orderId) ?? []);
// The saved card, for families on autopay. Never more than brand, last four and expiry.
const card = account && (autopay.length || needsAttention.length) ? cardLabel(account) : null;
// Imported from Studio Director and nothing here yet: their fall classes and payments are still in Studio Director.
const fromStudioDirector = account?.source === 'studio-director' && !enrollments.length && !orders.length && !installments.length;
// Back from a child's page after saving or "Looks right".
const savedId = Astro.url.searchParams.get('saved');
const saved = savedId ? students.find((s) => s.id === savedId) : undefined;
const savedFamily = savedId === 'family';
// The 15% family discount on monthly payments to come, or a note that it ended (src/server/family-discount.ts).
const withFamilyDiscount = (i: (typeof installments)[number]) => i.baseAmountCents < i.regularAmountCents;
const familyNote = [...needsAttention, ...autopay].some(withFamilyDiscount)
  ? 'Family discount: 15% off for multiple students or classes, on every monthly payment while two or more are enrolled. If that drops to one, the months not yet paid go back to the regular price.'
  : autopay.length && installments.some(withFamilyDiscount)
    ? 'Your family discount (15% off for multiple students or classes) ended when fewer than two were still enrolled, so the months not yet paid are back to the regular price.'
    : '';
const shortDate = (d: Date) => d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
// Refunds on each payment, the family's credits, and the years they can download a statement for (src/server/refunds.ts, credits.ts, statements.ts).
const paidList = household ? await familyPayments(household.id) : [];
const refundedOn = new Map(paidList.map((p) => [p.key, refundNote(p.amountCents, p.refunds)]));
const credits = household ? (await familyCredits(household.id)).filter((c) => c.state !== 'removed') : [];
const statementYearsList = statementYears(paidList);
const receipts: { key: string; date: Date; label: string; amountCents: number; discounts?: ReturnType<typeof discountLines> }[] = [
  ...orders.map((o) => ({
    key: `o-${o.id}`,
    date: o.paidAt!,
    label:
      o.plan === 'drop_in' && o.lines[0]
        ? o.lines[0].label
        : `${namesList(orderKids.get(o.id) ?? [])}${orderKids.get(o.id)?.length ? ': ' : ''}${Astro.locals.content.findSession(o.sessionId)?.program.title ?? o.sessionId}${o.plan === 'trial' ? ' (free trial)' : o.plan === 'full' ? ' (full season)' : o.plan === 'monthly' ? ' (first month + fees)' : ''}`,
    amountCents: o.totalCents,
  })),
  ...installments
    .filter((i) => i.status === 'paid')
    .map((i) => ({ key: `i-${i.id}`, date: i.paidAt!, label: `${i.label}${i.lateFeeCents ? ' + late fee' : ''}`, amountCents: totalDue(i), discounts: discountLines(i) })),
].sort((a, b) => b.date.getTime() - a.date.getTime());
const today = todayInAthens();
const clock = bookingClock(Astro.locals.content.site.lateJoinWeeks);

// Days off from today on: "No class Nov 26 (Thanksgiving)" in each class's line, and the next class skips them.
const daysOff = enrollments.length ? await daysOffBetween(today, '9999-12-31') : [];
const upcoming = enrollments
  .map(({ enrollment, student }) => {
    const found = Astro.locals.content.findSession(enrollment.sessionId);
    if (!found) return null;
    const left = meetings(found.session).filter((m) => m >= today);
    const next = left.find((m) => !dayOffFrom(daysOff, found.session.id, m)) ?? (left.length ? left[0] : undefined);
    const off = left.map((m) => dayOffFrom(daysOff, found.session.id, m)).filter((d): d is NonNullable<typeof d> => !!d);
    // After a free class, continuing is a new sign-up: only while the class still takes new students.
    const canContinue = enrollment.status === 'trial' && canBook(found.program, found.session, clock);
    return { enrollment, student, ...found, next, off, canContinue };
  })
  // A waitlist place shows until the class has ended.
  .filter((x): x is NonNullable<typeof x> => !!x && (!!x.next || (x.enrollment.status === 'waitlist' && sessionState(x.program, x.session, clock) !== 'ended')))
  .sort((a, b) => (a.next ?? '9999').localeCompare(b.next ?? '9999'));

// Drop-ins (src/server/drop-ins.ts): the ones booked ahead, and the weekly classes a child of theirs could drop in to.
const dropInsAhead = household ? (await familyDropIns(household.id, { from: today })).filter((d) => d.status === 'booked') : [];
const inClass = (sessionId: string, studentId: string) => enrollments.some((e) => e.enrollment.sessionId === sessionId && e.student.id === studentId && (e.enrollment.status === 'active' || e.enrollment.status === 'trial'));
const dropInOffers = students.length ? dropInClasses(Astro.locals.content).filter((c) => students.some((s) => !inClass(c.session.id, s.id))) : [];

const statusLabel = { active: 'Enrolled', trial: 'Free trial class', waitlist: 'Waitlist', cancelled: 'Cancelled' } as const;
const fmtDate = (iso: string) => new Date(`${iso}T12:00:00Z`).toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric', timeZone: 'UTC' });
---

<Base title="Your family account" noindex>
  <section class="acct">
    <div class="wrap">
      {
        !user ? (
          <div class="acct__signin">
            <div class="acct__cast" aria-hidden="true">
              <Character name="magician" size={64} />
              <Character name="royal" size={78} />
            </div>
            <SignInPanel level="h1" heading="Family login" />
            <p class="acct__moving" data-moving-note>Moving from Studio Director? Use the email address you used there, or <a href="/contact">ask us</a>.</p>
          </div>
        ) : needsProfile ? (
          <form method="post" class="card form narrow">
            <input type="hidden" name="action" value="profile" />
            <h1>Welcome to Little Characters!</h1>
            <p class="lede">Tell us who you are and you’re all set.</p>
            <div class="field">
              <label for="p-name">Your name</label>
              <input id="p-name" name="name" autocomplete="name" required value={values.name ?? ''} />
              {errors.name && <p class="error">{errors.name}</p>}
            </div>
            <div class="field">
              <label for="p-phone">Mobile phone</label>
              <input id="p-phone" name="phone" type="tel" autocomplete="tel" required value={values.phone ?? ''} />
              {errors.phone && <p class="error">{errors.phone}</p>}
            </div>
            <button class="btn btn--primary" type="submit">Save</button>
          </form>
        ) : (
          <div class="dash">
            <header class="dash__head">
              <div>
                <p class="eyebrow">{household!.name}</p>
                <h1>Hi, {user.name.split(' ')[0]}!</h1>
              </div>
              <div class="dash__actions">
                {Astro.locals.isAdmin && <a class="btn btn--outline btn--sm" href={staffToday()}>Staff</a>}
                {!fromStudioDirector && <a class="btn btn--primary btn--sm" href="/programs">Find a class</a>}
                <form method="post" action="/account/sign-out">
                  <button class="btn btn--outline btn--sm" type="submit">Sign out</button>
                </form>
              </div>
            </header>

            {fromStudioDirector ? (
              <section class="panel panel--welcome" aria-labelledby="welcome-title" data-welcome>
                <h2 id="welcome-title">Welcome from Studio Director!</h2>
                <p>{studioDirectorWelcome(site.studioDirectorBillingEnds)}</p>
                <p class="fine">Questions about your fall classes or payments? Email <a href={`mailto:${email}`}>{email}</a>.</p>
              </section>
            ) : (
            <section class="panel" aria-labelledby="up-title">
              <h2 id="up-title">Coming up</h2>
              {upcoming.length ? (
                <ul class="classes">
                  {upcoming.map((u) => (
                    <li data-gel={u.program.gel}>
                      <div>
                        <span class="classes__who">{u.student.firstName}</span>
                        <strong>{u.program.title}</strong>
                        <span class="script">{dayList(u.session.days)} · {timeRange(u.session.start, u.session.end)} · {locationById(u.session.locationId)?.shortName}</span>
                      </div>
                      <div class="classes__side">
                        <span class:list={['badge', `badge--${u.enrollment.status}`]}>{statusLabel[u.enrollment.status]}</span>
                        {u.next && <span class="classes__next">Next: {fmtDate(u.next)}</span>}
                        {u.enrollment.status !== 'waitlist' && u.off.map((d) => <span class="classes__off" data-no-class>{noClassLine(d)}</span>)}
                        {u.canContinue && <a href={`/enroll/${u.session.id}`}>Continue after the trial</a>}
                        {u.enrollment.status === 'trial' && !u.canContinue && (
                          <span>Sign-ups for this season have closed. <a href={`/contact?topic=class&class=${encodeURIComponent(u.program.title)}`}>Ask us</a></span>
                        )}
                        {u.enrollment.status !== 'waitlist' && u.next && <a href={`/account/calendar/${u.enrollment.id}.ics`} download data-calendar-link>Add to calendar</a>}
                        {u.enrollment.status !== 'waitlist' && u.next && (
                          <a href={`/contact?${new URLSearchParams({ topic: 'absence', child: u.student.firstName, class: u.program.title, date: u.next })}`} data-absence-link>Can’t make it?</a>
                        )}
                      </div>
                    </li>
                  ))}
                </ul>
              ) : dropInsAhead.length ? null : (
                <p class="empty">No classes yet. <a href="/programs">Find one for your crew</a>.</p>
              )}
              {dropInsAhead.length > 0 && (
                <ul class="classes" data-drop-ins>
                  {dropInsAhead.map((d) => {
                    const f = Astro.locals.content.findSession(d.sessionId);
                    return f && (
                      <li data-gel={f.program.gel} data-drop-in={d.id}>
                        <div>
                          <span class="classes__who">{d.firstName}</span>
                          <strong>{f.program.title}</strong>
                          <span class="script">{dropInDay(d.date)} · {timeRange(f.session.start, f.session.end)} · {locationById(f.session.locationId)?.shortName}</span>
                        </div>
                        <div class="classes__side">
                          <span class="badge badge--trial">Drop-in</span>
                          <span class="classes__next">{dropInDay(d.date)}</span>
                        </div>
                      </li>
                    );
                  })}
                </ul>
              )}
              {dropInOffers.length > 0 && (
                <details class="drop-ins" data-drop-in-offers>
                  <summary>Drop in for one class</summary>
                  <p class="fine">Try a weekly class for one date, or come along with a brother or sister.</p>
                  <ul>
                    {dropInOffers.map((c) => (
                      <li>
                        <span><strong>{c.program.title}</strong> <span class="script">{dayList(c.session.days)} · {timeRange(c.session.start, c.session.end)}</span></span>
                        <a href={`/drop-in/${c.session.id}`} data-drop-in-link>Drop in · {formatCents(c.priceCents)}</a>
                      </li>
                    ))}
                  </ul>
                </details>
              )}
            </section>
            )}

            <section class="panel" id="students" aria-labelledby="st-title">
              <h2 id="st-title">Your students</h2>
              {saved && (
                <p class="saved" role="status" data-saved>Saved. {saved.firstName}’s details are up to date. Our staff see them on the class roster.</p>
              )}
              <ul class="kids">
                {students.map((s) => (
                  <li>
                    <strong>{s.firstName} {s.lastName}</strong>
                    <span class="muted">{ageOn(s.birthdate) !== null ? `Age ${ageOn(s.birthdate)}` : ''}</span>
                    {detailsFresh(s) ? (
                      <span class="badge badge--active">Care details on file</span>
                    ) : (
                      <a class="badge badge--todo badge--link" href={`/account/students/${s.id}#confirm`} data-care-link>
                        {s.allergiesEnc || s.medicalNotesEnc || s.pickupNotes ? 'Confirm care details' : 'Add care details'} <span aria-hidden="true">→</span>
                      </a>
                    )}
                    <a href={`/account/students/${s.id}`}>Edit</a>
                  </li>
                ))}
              </ul>
              <details class="add" open={!students.length || !!errors.firstName || !!errors.birthdate}>
                <summary>+ Add a student</summary>
                <form method="post" class="form">
                  <input type="hidden" name="action" value="add-student" />
                  <div class="row">
                    <div class="field">
                      <label for="s-first">First name</label>
                      <input id="s-first" name="firstName" required value={values.firstName ?? ''} />
                      {errors.firstName && <p class="error">{errors.firstName}</p>}
                    </div>
                    <div class="field">
                      <label for="s-last">Last name</label>
                      <input id="s-last" name="lastName" required value={values.lastName ?? ''} />
                    </div>
                    <div class="field">
                      <label for="s-bday">Birthday</label>
                      <input id="s-bday" name="birthdate" type="date" required value={values.birthdate ?? ''} />
                      {errors.birthdate && <p class="error">{errors.birthdate}</p>}
                    </div>
                  </div>
                  <button class="btn btn--outline btn--sm" type="submit">Save student</button>
                </form>
              </details>
            </section>

            <section class="panel" id="family" aria-labelledby="fam-title" data-family>
              <div class="panel__head">
                <h2 id="fam-title">Family details</h2>
                <a href="/account/family" data-family-edit>{familyStarted ? 'Edit' : 'Add'}<span class="sr-only"> family details</span></a>
              </div>
              {savedFamily && <p class="saved" role="status" data-saved>Saved. Your family details are up to date.</p>}
              {family && !familyFresh && (
                familyDetailsComplete(family) ? (
                  <form method="post" class="confirm" data-family-confirm>
                    <input type="hidden" name="action" value="confirm-family" />
                    <p>
                      <strong>Are these still right?</strong>
                      {familyCheckedOn ? ` Last checked ${familyCheckedOn}.` : ' Please check them.'} If nothing has changed, tell us here.
                    </p>
                    <button class="btn btn--primary btn--sm" type="submit">Looks right</button>
                  </form>
                ) : (
                  <p class="confirm" data-family-todo>
                    <span><strong>Please add {familyStarted ? 'what’s missing' : 'your family details'}.</strong> We ask for an emergency contact and your ZIP code before your next sign-up.</span>
                    <a class="btn btn--primary btn--sm" href="/account/family">{familyStarted ? 'Finish' : 'Add details'}</a>
                  </p>
                )
              )}
              {familyStarted && (
                <dl class="facts">
                  <div>
                    <dt>Emergency contacts</dt>
                    <dd>{family!.emergencyContacts.length ? <ul>{family!.emergencyContacts.map((c) => <li>{personLine(c)}</li>)}</ul> : 'None yet'}</dd>
                  </div>
                  <div>
                    <dt>Who may pick up</dt>
                    <dd>
                      <ul>
                        <li>Parents</li>
                        {family!.pickupPeople.map((p) => <li>{personLine(p)}</li>)}
                      </ul>
                    </dd>
                  </div>
                  <div>
                    <dt>ZIP code</dt>
                    <dd>{family!.zip ?? 'Not yet'}</dd>
                  </div>
                </dl>
              )}
              <p class="fine">Little Characters staff see these, and from spring, the teachers of your children’s classes.</p>
            </section>

            {!fromStudioDirector && (
            <section class="panel" aria-labelledby="pay-title" data-payments>
              <h2 id="pay-title">Payments</h2>
              {needsAttention.map((i) => (
                <div class="alert" role="alert">
                  <p>
                    <strong>{i.label}: {formatCents(totalDue(i))}</strong>{discountLines(i).length > 0 && ` (after ${discountLines(i).map(adjustmentLine).join(', ')})`}{i.lateFeeCents > 0 && ` (includes a ${formatCents(i.lateFeeCents)} late fee)`} didn’t go through because {failureReason(i.lastError ?? '')}.
                    {i.retryOn ? ` We’ll try again on ${fmtDate(i.retryOn)}, or you can pay now.` : ''}
                  </p>
                  <a class="btn btn--primary btn--sm" href={`/account/pay/${i.id}`}>Pay now</a>
                </div>
              ))}
              {card && (
                <div class="card-on-file" data-card>
                  <h3>Card on file</h3>
                  <p><strong data-card-label>{card}</strong></p>
                  <p class="fine">To switch cards, <a href={`mailto:${email}?subject=${encodeURIComponent('Switching cards')}`}>email us</a>. Please don’t send card numbers by email; we’ll send you a secure link.</p>
                </div>
              )}
              {autopay.length > 0 && (
                <div class="autopay">
                  <h3>Upcoming autopay</h3>
                  <table class="receipts" data-autopay>
                    <thead><tr><th>Date</th><th>For</th><th>Amount</th></tr></thead>
                    {autopayGroups.map((g) => (
                      <tbody>
                        <tr class="day" data-autopay-day><th colspan="3" scope="rowgroup">{g.summary}</th></tr>
                        {g.items.map((i) => (
                          <tr data-autopay-item>
                            <td>{fmtDate(i.dueDate)}</td>
                            <td>{i.label}{discountLines(i).map((l) => (l.family ? <span class="adj" data-family-discount>{adjustmentLine(l)}</span> : <span class="adj" data-adjustment>{adjustmentLine(l)}</span>))}</td>
                            <td>{i.amountCents !== i.regularAmountCents && <s class="was">{formatCents(i.regularAmountCents)}</s>}{formatCents(i.amountCents)}</td>
                          </tr>
                        ))}
                      </tbody>
                    ))}
                  </table>
                  <p class="fine">Charged automatically to your saved card on the 1st, with an emailed receipt. To withdraw, tell us at least 5 days before the 1st.</p>
                  {familyNote && <p class="fine" data-family-note>{familyNote}</p>}
                </div>
              )}
              <h3>Receipts</h3>
              {receipts.length ? (
                <table class="receipts" data-receipts>
                  <thead><tr><th>Date</th><th>For</th><th>Amount</th></tr></thead>
                  <tbody>
                    {receipts.map((r) => (
                      <tr>
                        <td>{shortDate(r.date)}</td>
                        <td>{r.label}{r.discounts?.map((l) => (l.family ? <span class="adj" data-family-discount>{adjustmentLine(l)}</span> : <span class="adj" data-adjustment>{adjustmentLine(l)}</span>))}{refundedOn.get(r.key) && <span class="adj refunded" data-refunded>{refundedOn.get(r.key)}</span>}</td>
                        <td>{formatCents(r.amountCents)}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              ) : (
                <p class="empty">No payments yet.</p>
              )}
              {credits.length > 0 && (
                <div class="credits" data-credits>
                  <h3>Credits</h3>
                  <ul>
                    {credits.map((c) => (
                      <li data-credit={c.state}>
                        <strong>Credit: −{formatCents(c.amountCents)}</strong>{c.showToFamily && `, ${c.reason}`}
                        <span class="fine"> · {c.state === 'waiting' ? 'comes off your next payment' : c.state === 'applied' ? `comes off your ${fmtDate(c.payment!.dueDate)} payment` : `taken off your ${fmtDate(c.payment!.dueDate)} payment`}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
              {statementYearsList.length > 0 ? (
                <div class="statements" data-statement>
                  <h3>Statements</h3>
                  <ul>
                    {statementYearsList.map((y) => (
                      <li>Statement for {y}: <a href={`/account/statement.pdf?year=${y}`} data-statement-pdf={y}>PDF</a> · <a href={`/account/statement.csv?year=${y}`} data-statement-csv={y}>spreadsheet (CSV)</a></li>
                    ))}
                  </ul>
                  <p class="fine">Every payment that year, any refunds, and the total. For taxes or an FSA.</p>
                </div>
              ) : (
                <p class="fine" data-statement>Need a statement for taxes or an FSA? It’s here once you’ve made a payment.</p>
              )}
            </section>
            )}
            <p class="fine">Signed in as {user.email} on this device for 90 days. Questions about billing? Email <a href={`mailto:${email}`}>{email}</a>.</p>
          </div>
        )
