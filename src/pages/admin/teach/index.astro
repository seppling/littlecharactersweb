---
/**
 * The teacher app's home (docs/back-office.md → The teacher app): today's
 * classes, each with how many children are expected and whether attendance is
 * done, then the next 7 days. Teachers land here from /admin; owners see every
 * class today here, so Hannah can take attendance when she teaches or covers.
 *
 * Kept on the phone for the day (the X-Teach-Cache header, read by
 * public/admin/teach-sw.js) with today's rosters, so it opens with no signal.
 * The status chips add what's saved on the phone and not sent yet.
 * Rehearsals today for the teacher's classes show as read-only cards
 * (src/server/shows.ts): time, place and note, never the cast.
 */
import AdminShell from '@/components/admin/AdminShell.astro';
import { teachRoster } from '@/lib/admin-links';
import { timeRange } from '@/lib/format';
import { todayInAthens } from '@/lib/pricing';
import { addDays, nextTeachingDay, teachCards, type TeachCard } from '@/server/attendance';
import { whenLabel } from '@/server/classes';
import { isProd } from '@/server/env';
import { requireTeacherOrOwner } from '@/server/staff';
import { staffById } from '@/server/staff-settings';
import { teacherClasses } from '@/server/teachers';
import { devDay, longDay, shortDay } from '@/server/today';
import { rehearsalCardsBetween, teacherRehearsals, type RehearsalCard } from '@/server/shows';

export const prerender = false;
const { staff, response } = requireTeacherOrOwner(Astro.locals);
if (response) return response;

const { content } = Astro.locals;
// Browser tests pick the day with ?on=YYYY-MM-DD; production ignores it.
const on = devDay(Astro.url.searchParams, !isProd);
const date = on ?? todayInAthens();
const viewer = staff ? { userId: staff.id, staffId: staff.staffId, role: staff.role } : null;
const today: TeachCard[] = viewer ? await teachCards(viewer, date, content) : [];
const rehearsals: RehearsalCard[] = viewer ? await teacherRehearsals(viewer, date, content) : [];
// The week ahead: their own classes and cover dates (owners too), and their classes' rehearsals (read-only).
const weekRehearsals = viewer ? await rehearsalCardsBetween({ ...viewer, role: 'teacher' }, addDays(date, 1), addDays(date, 7), content) : [];
const week = viewer
  ? (
      await Promise.all(
        [1, 2, 3, 4, 5, 6, 7].map(async (i) => ({
          date: addDays(date, i),
          cards: await teachCards({ ...viewer, role: 'teacher' }, addDays(date, i), content),
          rehearsals: weekRehearsals.filter((r) => r.date === addDays(date, i)),
        })),
      )
    ).filter((d) => d.cards.length || d.rehearsals.length)
  : [];
const next = viewer && !today.length ? await nextTeachingDay(viewer, date, content) : null;
const mine = staff ? (await teacherClasses(staff.staffId, content)).filter((c) => c.session.endDate >= date).sort((a, b) => a.session.startDate.localeCompare(b.session.startDate)) : [];
// The name Hannah typed in Settings → Staff (a new sign-in has no name of its own).
const name = staff ? (await staffById(staff.staffId))?.name : undefined;
const firstName = name && !name.includes('@') ? name.split(' ')[0] : undefined;

const time = (c: TeachCard) => (c.session.start && c.session.end ? timeRange(c.session.start, c.session.end) : '');
const role = (c: TeachCard) =>
  c.as === 'cover' ? (c.coveringFor ? `Covering for ${c.coveringFor}` : 'Substitute') : c.as === 'assistant' ? 'Assisting' : c.as === 'owner' && c.session.teacher ? c.session.teacher : '';
const kids = (n: number) => `${n} ${n === 1 ? 'child' : 'children'}`;
// Today's rosters this person may mark: kept on the phone with this page. Nothing is kept on a shared device.
const keep = !!staff && !Astro.locals.sharedDevice;
const precache = keep ? today.filter((c) => !c.dayOff && c.as !== 'owner').map((c) => teachRoster(c.sessionId, date, on)) : [];

if (keep) Astro.response.headers.set('X-Teach-Cache', todayInAthens());
else Astro.response.headers.set('X-Teach-Signed-Out', '1');
---

<AdminShell title="Your classes" section="teach" teachers>
  <div class="admin-page teach" data-teach-home data-by={staff?.id} data-date={date} data-on={on ?? ''} data-precache={JSON.stringify(precache)} data-keep={keep ? '1' : '0'}>
    <div class="admin-head">
      <div>
        <h1>{firstName ? `Hi, ${firstName}` : 'Your classes'}</h1>
        <p class="admin-intro" data-teach-date>{longDay(date)}{on && ' (test date)'}</p>
      </div>
    </div>
    <p class="sync-line" data-sync-status hidden></p>

    <section class="admin-section" aria-labelledby="today-title">
      <h2 id="today-title">Today</h2>
      {
        today.length === 0 ? (
          <div class="empty-state" data-no-classes>
            <strong>No classes today</strong>
            <span>{next ? `Your next class is ${longDay(next)}.` : 'Your classes and substitute dates show here on the day.'}</span>
          </div>
        ) : (
          <ul class="teach-list" data-teach-today>
            {today.map((c) => {
              const inner = (
                <>
                  <span class="teach-card__time">{time(c) || 'All day'}</span>
                  <span class="teach-card__what">
                    <strong>{c.program.title}</strong>
                    <span class="teach-card__meta">{[c.location, c.dayOff ? '' : kids(c.expected)].filter(Boolean).join(' · ')}</span>
                    {(role(c) || c.coveredBy) && (
                      <span class="badges">
                        {role(c) && <span class:list={['badge', c.as === 'cover' ? 'badge--warning' : 'badge--neutral']} data-role>{role(c)}</span>}
                        {c.coveredBy && <span class="badge badge--warning" data-covered-by>{c.coveredBy} is covering</span>}
                      </span>
                    )}
                  </span>
                  {c.dayOff ? (
                    <span class="teach-card__off" data-day-off>No class: {c.dayOff}</span>
                  ) : (
                    <span class:list={['chip-status', c.done ? 'chip-status--done' : 'chip-status--todo']} data-status={c.done ? 'done' : 'todo'}>
                      {c.done ? 'Done ✓' : 'Not taken'}
                    </span>
                  )}
                </>
              );
              return (
                <li data-teach-class={c.sessionId} data-done={c.done ? '1' : '0'} data-off={c.dayOff ? '1' : '0'}>
                  {c.dayOff ? (
                    <div class="teach-card teach-card--off">{inner}</div>
                  ) : (
                    <a class="teach-card" href={teachRoster(c.sessionId, date, on)}>{inner}</a>
                  )}
                </li>
              );
            })}
          </ul>
        )
      }
      {
        rehearsals.length > 0 && (
          <ul class="teach-list" data-teach-rehearsals>
            {rehearsals.map((r) => (
              <li data-teach-rehearsal={r.id}>
                <div class="teach-card teach-card--rehearsal">
                  <span class="teach-card__time">{r.time}</span>
                  <span class="teach-card__what">
                    <strong>Rehearsal: {r.showTitle}</strong>
                    <span class="teach-card__meta">{[r.place, r.classes].filter(Boolean).join(' · ')}</span>
                    {r.note && <span class="teach-card__note" data-rehearsal-note>{r.note}</span>}
                  </span>
                  <span class="badge badge--rehearsal">Rehearsal</span>
                </div>
              </li>
            ))}
          </ul>
        )
      }
    </section>

    {
      week.length > 0 && (
        <section class="admin-section" aria-labelledby="week-title">
          <h2 id="week-title">This week</h2>
          <ul class="teach-week" data-teach-week>
            {week.map((d) => (
              <li>
                <h3 class="teach-week__day">{shortDay(d.date)}</h3>
                <ul class="teach-list">
                  {d.cards.map((c) => (
                    <li data-week-class={`${c.sessionId} ${d.date}`}>
                      <a class:list={['teach-row', { 'teach-row--off': c.dayOff }]} href={teachRoster(c.sessionId, d.date, on)}>
                        <span class="teach-row__time">{time(c)}</span>
                        <span>
                          <strong>{c.program.title}</strong>
                          <span class="teach-row__meta">{[c.location, c.dayOff ? `No class: ${c.dayOff}` : kids(c.expected), role(c), c.coveredBy && `${c.coveredBy} is covering`].filter(Boolean).join(' · ')}</span>
                        </span>
                      </a>
                    </li>
                  ))}
                  {d.rehearsals.map((r) => (
                    <li data-week-rehearsal={r.id}>
                      <div class="teach-row teach-row--rehearsal">
                        <span class="teach-row__time">{r.time}</span>
                        <span>
                          <strong>Rehearsal: {r.showTitle}</strong>
                          <span class="teach-row__meta">{[r.place, r.classes, r.note].filter(Boolean).join(' · ')}</span>
                        </span>
                      </div>
                    </li>
                  ))}
                </ul>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      mine.length > 0 && (
        <section class="admin-section" aria-labelledby="mine-title">
          <h2 id="mine-title">Classes you teach</h2>
          <ul class="teach-list" data-teach-mine>
            {mine.map((c) => (
              <li class="teach-mine" data-teach-mine-class={c.sessionId}>
                <strong>{c.program.title}</strong>
                <span>{[c.session.label, whenLabel(c.session), c.role === 'assistant' ? 'Assisting' : ''].filter(Boolean).join(' · ')}</span>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </div>
</AdminShell>

<script>
  import { allQueued, claimPhone, keepSending, registerWorker, type SyncOutcome } from '@/scripts/teach';

  const root = document.querySelector<HTMLElement>('[data-teach-home]');
  const by = root?.dataset.by;
  if (root && by) {
    const date = root.dataset.date!;
    const status = root.querySelector<HTMLElement>('[data-sync-status]')!;
    const cards = [...root.querySelectorAll<HTMLElement>('[data-teach-today] > li')];

    /** Each class's chip: done on the server, saved on this phone and not sent, or not taken. */
    async function paint(outcome?: SyncOutcome) {
      const waiting = (await allQueued()).filter((q) => q.by === by && q.date === date);
      for (const done of outcome?.done ?? []) if (done.kind === 'report' && done.date === date) cards.find((c) => c.dataset.teachClass === done.sessionId)?.setAttribute('data-done', '1');
      let notTaken = 0;
      for (const li of cards) {
        const chip = li.querySelector<HTMLElement>('[data-status]');
        if (!chip) continue;
        const saved = waiting.some((q) => q.sessionId === li.dataset.teachClass);
        const done = li.dataset.done === '1';
        const state = saved ? 'saved' : done ? 'done' : 'todo';
        chip.dataset.status = state;
        chip.className = `chip-status chip-status--${state}`;
        chip.textContent = saved ? 'Saved on this phone, sending…' : done ? 'Done ✓' : 'Not taken';
        if (!done || saved) notTaken++;
      }
      // The app icon's badge: classes still to take today (installed app, where supported).
      const nav = navigator as Navigator & { setAppBadge?: (n?: number) => Promise<void>; clearAppBadge?: () => Promise<void> };
      try {
        if (notTaken) await nav.setAppBadge?.(notTaken);
        else await nav.clearAppBadge?.();
      } catch {
        /* not supported */
      }
      const anyWaiting = (await allQueued()).some((q) => q.by === by);
      status.hidden = !anyWaiting && outcome?.state !== 'signed-out';
      status.textContent =
        outcome?.state === 'signed-out'
          ? 'Sign in again to send what’s saved on this phone.'
          : anyWaiting
            ? 'Saved on this phone · sending when you have signal'
            : 'All sent ✓';
    }

    claimPhone(by).then(() => {
      registerWorker(JSON.parse(root.dataset.precache || '[]'), root.dataset.keep === '1');
      const go = keepSending(by, paint);
      paint().then(go);
    });
  }
</script>

<style>
  .teach-list { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-s); }
  .sync-line { margin: 0; padding: 0.6rem 0.9rem; border-radius: var(--r-sm); background: var(--yellow-tint); font-weight: 650; font-size: var(--step--1); }
  .teach-card {
    display: grid;
    grid-template-columns: 7.5rem minmax(0, 1fr) auto;
    gap: 0.35rem 1rem;
    align-items: center;
    min-height: 64px;
    padding: 0.85rem 1rem;
    border: 1.5px solid var(--line-strong);
    border-radius: var(--r-md);
    background: var(--paper);
    color: var(--ink);
    text-decoration: none;
  }
  a.teach-card:hover { border-color: var(--ink); text-decoration: none; }
  .teach-card--off { background: var(--hall); color: var(--ink-mute); border-style: dashed; }
  .teach-card--rehearsal { border-left: 6px solid var(--teal); }
  .teach-card__note { font-size: var(--step--1); color: var(--ink); white-space: pre-line; }
  .badge--rehearsal { background: var(--teal-tint); color: var(--ink); }
  [data-teach-rehearsals] { margin-top: var(--space-s); }
  .teach-card__time { font-weight: 700; white-space: nowrap; }
  .teach-card__what { display: grid; gap: 0.25rem; min-width: 0; overflow-wrap: anywhere; }
  .teach-card__what strong { font-family: var(--font-display); font-size: var(--step-1); font-stretch: 92%; line-height: 1.15; }
  .teach-card__meta { font-size: var(--step--1); color: var(--ink-soft); }
  .teach-card__off { font-weight: 700; font-size: var(--step--1); }
  .chip-status { display: inline-flex; align-items: center; min-height: 32px; padding: 0 0.75rem; border-radius: 999px; font-size: var(--step--1); font-weight: 750; white-space: nowrap; }
  .chip-status--todo { background: var(--hall); color: var(--ink); border: 1.5px solid var(--line-strong); }
  .chip-status--saved { background: var(--yellow-tint); color: var(--yellow-ink); border: 1.5px solid var(--yellow); white-space: normal; }
  .chip-status--done { background: var(--ok-tint); color: #1c6b3e; border: 1.5px solid #1c6b3e; }
  .teach-week { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-s); }
  .teach-week__day { font-size: var(--step-0); margin: 0 0 0.35rem; }
  .teach-row { display: grid; grid-template-columns: 7.5rem minmax(0, 1fr); gap: 0.2rem 1rem; align-items: center; min-height: 44px; padding: 0.55rem 0; border-bottom: 1px solid var(--line); color: var(--ink); text-decoration: none; }
  .teach-row strong { display: block; }
  .teach-row__time { font-size: var(--step--1); font-weight: 650; color: var(--ink-soft); white-space: nowrap; }
  .teach-row__meta { display: block; font-size: var(--step--1); color: var(--ink-mute); }
  .teach-row--off { color: var(--ink-mute); }
  .teach-row--rehearsal { border-left: 4px solid var(--teal); padding-left: 0.6rem; }
  .teach-mine { display: grid; gap: 0.15rem; padding: 0.6rem 0; border-bottom: 1px solid var(--line); }
  .teach-mine > span { color: var(--ink-soft); font-size: var(--step--1); }
  @media (max-width: 520px) {
    .teach-card { grid-template-columns: minmax(0, 1fr) auto; }
    .teach-card__time { grid-column: 1 / -1; }
    .teach-row { grid-template-columns: minmax(0, 1fr); }
  }
</style>
