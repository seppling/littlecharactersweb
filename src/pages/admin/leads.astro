---
/** Staff: everything sent through the site's forms, newest first. Downloads: leads.csv.ts and leads.pdf.ts, built from the same rows. */
import AdminShell from '@/components/admin/AdminShell.astro';
import DownloadLinks from '@/components/admin/DownloadLinks.astro';
import { downloads, leads as leadsPath } from '@/lib/admin-links';
import { LEAD_LABELS, leadWhen, staffLeads } from '@/server/leads';
import { requireStaff } from '@/server/staff';

export const prerender = false;
const { programBySlug, events } = Astro.locals.content;
const { staff, response } = requireStaff(Astro.locals);
if (response) return response;

const leads = staff ? await staffLeads((slug) => programBySlug(slug)?.title ?? events.find((e) => e.slug === slug)?.title) : [];
const counts = Object.entries(LEAD_LABELS).map(([kind, name]) => ({ kind, name, n: leads.filter((l) => l.kind === kind).length }));
const files = downloads(leadsPath());
---

<AdminShell title="Messages & sign-ups" section="leads">
  <div class="admin-page">
    <div class="admin-head">
      <div>
        <h1>Messages & sign-ups</h1>
        <p class="admin-intro">{counts.map((c) => `${c.name}: ${c.n}`).join(' · ')}. Contact messages are also emailed to you; reply to that email to answer the family.</p>
      </div>
      <div class="admin-head__actions">
        <DownloadLinks csv={files.csv} pdf={files.pdf} what="messages and sign-ups" />
      </div>
    </div>
    {
      leads.length ? (
        <table class="data-table" data-leads>
          <thead>
            <tr><th>When</th><th>Form</th><th>From</th><th>Details</th></tr>
          </thead>
          <tbody>
            {leads.map((l) => (
              <tr>
                <td data-label="When" class="nowrap">{leadWhen(l.createdAt)}</td>
                <td data-label="Form">{l.form}</td>
                <td data-label="From">
                  <div>
                    {l.name && <strong>{l.name}<br /></strong>}
                    <a href={`mailto:${l.email}`}>{l.email}</a>
                  </div>
                </td>
                <td data-label="Details">
                  <div>
                    {l.program && <span class="muted">{l.program}</span>}
                    {l.topic && <span class="muted">About: {l.topic}</span>}
                    {l.ages && <span class="muted"> · Ages {l.ages}</span>}
                    {l.message && <p class="msg">{l.message}</p>}
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      ) : (
        <div class="empty-state">
          <strong>Nothing yet</strong>
          <p>Messages and sign-ups from the site’s forms will show up here.</p>
        </div>
      )
    }
  </div>
</AdminShell>

<style>
  .nowrap { white-space: nowrap; font-size: var(--step--1); }
  .msg { margin: 0.3rem 0 0; white-space: pre-line; max-width: 60ch; }
</style>
