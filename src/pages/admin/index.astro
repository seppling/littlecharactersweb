---
/** Staff home. A placeholder until the Today page (with "Needs attention") replaces it. */
import AdminShell from '@/components/admin/AdminShell.astro';
import { classes, payments } from '@/lib/admin-links';
import { requireStaff } from '@/server/staff';

export const prerender = false;
const { response } = requireStaff(Astro.locals);
if (response) return response;
---

<AdminShell title="Today" section="today">
  <div class="admin-page">
    <div class="admin-head">
      <div>
        <h1>Today</h1>
        <p class="admin-intro">Today’s classes and what needs your attention will be here soon. For now, start from Classes or Payments.</p>
      </div>
    </div>
    <ul class="tiles">
      <li><a class="tile tile--feature" href={classes()}><strong>Classes</strong><span>Rosters, trials and waitlists</span></a></li>
      <li><a class="tile" href={payments()}><strong>Payments</strong><span>Monthly autopay, failed charges and discounts</span></a></li>
    </ul>
  </div>
</AdminShell>
