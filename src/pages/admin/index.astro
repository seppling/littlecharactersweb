---
import Base from '@/layouts/Base.astro';
import { programs } from '@/data/programs';
import { sessionCounts } from '@/server/admin';
import { capacityFor } from '@/server/family';
import { dayList, timeRange } from '@/lib/format';

export const prerender = false;
if (!Astro.locals.isAdmin) return new Response('Not found', { status: 404 });

const counts = await sessionCounts();
const rows = programs.flatMap((p) =>
  p.sessions.filter((s) => !s.externalUrl || s.externalUrl.includes('docs.google.com')).map((s) => ({ program: p, session: s, c: counts.get(s.id) ?? { active: 0, trial: 0, waitlist: 0 }, cap: capacityFor(p, s) })),
);
---

<Base title="Rosters" noindex>
  <section class="wrap admin">
    <p class="eyebrow">Staff</p>
    <div class="head"><h1>Rosters</h1><span class="links"><a class="btn btn--outline btn--sm" href="/admin/leads">Messages & signups</a> <a class="btn btn--outline btn--sm" href="/admin/billing">Monthly autopay</a></span></div>
    <table>
      <thead><tr><th>Class</th><th>When</th><th>Enrolled</th><th>Trials</th><th>Waitlist</th><th></th></tr></thead>
      <tbody>
        {rows.map(({ program, session, c, cap }) => (
          <tr>
            <td><strong>{program.title}</strong><br /><span class="muted">{session.label ?? session.term}</span></td>
            <td class="script">{dayList(session.days)} {timeRange(session.start, session.end)}</td>
            <td>{c.active}{cap ? ` / ${cap}` : ''}</td>
            <td>{c.trial}</td>
            <td>{c.waitlist}</td>
            <td><a href={`/admin/${session.id}`}>Roster</a></td>
          </tr>
        ))}
      </tbody>
    </table>
  </section>
</Base>

<style>
  .admin { padding-block: var(--space-2xl) var(--space-3xl); display: grid; gap: var(--space-m); }
  table { width: 100%; border-collapse: collapse; font-variant-numeric: tabular-nums; }
  th, td { text-align: left; padding: 0.6rem 0.5rem; border-bottom: 1px solid var(--line); vertical-align: top; }
  th { font-family: var(--font-script); font-size: var(--step--2); text-transform: uppercase; color: var(--ink-mute); }
  .muted { color: var(--ink-mute); font-size: var(--step--1); }
  .head { display: flex; flex-wrap: wrap; gap: var(--space-m); justify-content: space-between; align-items: end; }
</style>
