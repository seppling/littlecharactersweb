---
/**
 * Staff: every class the site takes sign-ups for, by term, with places filled,
 * openings and the waitlist. Filters are links (?openings=1&waitlist=1&under5=1&term=…&show=ended),
 * so other pages can link to a filtered list. Downloads: classes.csv.ts and
 * classes.pdf.ts, built from the same rows (src/server/classes.ts).
 */
import AdminShell from '@/components/admin/AdminShell.astro';
import DownloadLinks from '@/components/admin/DownloadLinks.astro';
import { classes, classPage, downloads } from '@/lib/admin-links';
import { classFilters, classList, filterQuery, MIN_TO_RUN, placesLabel, type ClassFilters } from '@/server/classes';
import { requireStaff } from '@/server/staff';

export const prerender = false;
// Signed-out staff get the sign-in form (AdminShell); signed-in families get nothing.
const { staff, response } = requireStaff(Astro.locals);
if (response) return response;

const f = classFilters(Astro.url.searchParams);
const list = staff ? await classList(Astro.locals.content, f) : { terms: [], groups: [], rows: [] };
const files = downloads(classes() + filterQuery(f));
const link = (change: Partial<ClassFilters>) => classes() + filterQuery({ ...f, ...change });
const toggles: { key: 'openings' | 'waitlist' | 'under5'; label: string }[] = [
  { key: 'openings', label: 'Has openings' },
  { key: 'waitlist', label: 'Has a waitlist' },
  { key: 'under5', label: `Under ${MIN_TO_RUN}` },
];
const filtered = f.openings || f.waitlist || f.under5 || !!f.term;
---

<AdminShell title="Classes" section="classes">
  <div class="admin-page">
    <div class="admin-head">
      <div>
        <h1>Classes</h1>
        <p class="admin-intro">{f.ended ? 'Classes that have ended.' : 'Current and upcoming classes.'} Tap a class for its roster.</p>
      </div>
      <div class="admin-head__actions">
        <DownloadLinks csv={files.csv} pdf={files.pdf} what="the class list" />
      </div>
    </div>

    <nav class="filters" aria-label="Filter classes">
      <div class="chip-row" data-filters>
        {toggles.map((t) => (
          <a class="chip" href={link({ [t.key]: !f[t.key] })} aria-pressed={f[t.key] ? 'true' : 'false'} data-filter={t.key}>{t.label}</a>
        ))}
        <a class="chip" href={link({ ended: !f.ended, term: undefined })} aria-pressed={f.ended ? 'true' : 'false'} data-filter="ended">Ended</a>
      </div>
      {list.terms.length > 1 && (
        <div class="chip-row" data-terms>
          <span class="filters__label">Term</span>
          <a class="chip" href={link({ term: undefined })} aria-pressed={!f.term ? 'true' : 'false'}>All</a>
          {list.terms.map((t) => (
            <a class="chip" href={link({ term: t })} aria-pressed={f.term === t ? 'true' : 'false'}>{t}</a>
          ))}
        </div>
      )}
    </nav>

    {list.groups.length === 0 ? (
      <div class="empty-state">
        <strong>{filtered ? 'No classes match' : f.ended ? 'No ended classes' : 'No classes yet'}</strong>
        <p>{filtered ? 'Try fewer filters.' : 'Classes you add in the website editor show up here.'}</p>
        {filtered && <a class="btn btn--outline btn--sm" href={link({ openings: false, waitlist: false, under5: false, term: undefined })}>Clear filters</a>}
      </div>
    ) : (
      list.groups.map((g) => (
        <section class="term" aria-labelledby={`term-${g.term.replace(/\W+/g, '-')}`}>
          <h2 id={`term-${g.term.replace(/\W+/g, '-')}`}>{g.term}</h2>
          <div class="class-list__head" aria-hidden="true">
            <span>Class</span><span>Teacher</span><span class="num">Places</span><span class="num">Openings</span><span class="num">Waitlist</span>
          </div>
          <ul class="class-list" data-classes>
            {g.rows.map((r) => (
              <li>
                <a class="class-row" href={classPage(r.session.id)} data-session={r.session.id}>
                  <span class="class-row__name">
                    <strong>{r.program.title}</strong>
                    <span class="muted">{[r.label, r.when].filter(Boolean).join(' · ')}</span>
                    {(r.under5 && r.state !== 'ended') || r.openings === 0 ? (
                      <span class="badges">
                        {r.openings === 0 && <span class="badge badge--neutral">Full</span>}
                        {r.under5 && r.state !== 'ended' && <span class="badge badge--warning">Under {MIN_TO_RUN}</span>}
                      </span>
                    ) : null}
                  </span>
                  <span class="class-row__teacher" data-label="Teacher">{r.teacher || '—'}</span>
                  <span class="num" data-label="Places">{placesLabel(r)}{r.trial > 0 && <span class="muted"> ({r.trial} trial)</span>}</span>
                  <span class="num" data-label="Openings">{r.openings ?? '—'}</span>
                  <span class="num" data-label="Waitlist">{r.waitlist}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    )}
  </div>
</AdminShell>

<style>
  .filters { display: grid; gap: 0.6rem; }
  .filters__label { align-self: center; font-family: var(--font-script); font-size: var(--step--2); text-transform: uppercase; color: var(--ink-mute); margin-right: 0.2rem; }
  .filters .chip { min-height: 44px; }
  .term { display: grid; gap: 0.4rem; }
  .term h2 { font-size: var(--step-1); }
  .class-list { list-style: none; margin: 0; padding: 0; }
  .class-list__head,
  .class-row {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 1.6fr) 6.5rem 5.5rem 5rem;
    gap: 0.75rem;
    align-items: start;
    padding: 0.7rem 0.5rem;
  }
  .class-list__head {
    padding-block: 0.4rem;
    border-bottom: 2px solid var(--ink);
    font-family: var(--font-script);
    font-size: var(--step--2);
    text-transform: uppercase;
    color: var(--ink-mute);
  }
  .class-row { border-bottom: 1px solid var(--line); color: var(--ink); text-decoration: none; font-size: var(--step--1); font-variant-numeric: tabular-nums; }
  .class-row:hover { background: var(--hall); text-decoration: none; }
  .class-row:hover strong { text-decoration: underline; }
  .class-row__name { display: grid; gap: 0.2rem; min-width: 0; }
  .class-row__name strong { font-size: var(--step-0); color: var(--purple); }
  .class-row > * { min-width: 0; overflow-wrap: anywhere; }
  .num { text-align: right; }
  .muted { color: var(--ink-mute); }
  @media (max-width: 760px) {
    .class-list__head { display: none; }
    .class-list { display: grid; gap: var(--space-s); }
    .class-row {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 0.5rem 0.75rem;
      padding: 0.8rem 1rem;
      border: 1.5px solid var(--line-strong);
      border-radius: var(--r-md);
      background: var(--paper);
    }
    .class-row:hover { background: var(--paper); }
    .class-row__name,
    .class-row__teacher { grid-column: 1 / -1; }
    .num { text-align: left; }
    .class-row [data-label]::before {
      content: attr(data-label);
      display: block;
      font-family: var(--font-script);
      font-size: var(--step--2);
      text-transform: uppercase;
      color: var(--ink-mute);
    }
  }
</style>
