---
/**
 * Staff: one class. The header (when, where, who teaches, places filled), the
 * roster with badges and parents' contacts, each child's care details on tap,
 * and the waitlist. Opening it is written to the audit log, once per view:
 * the care details are in the page, not fetched per tap.
 * Print: ./print.astro. Downloads: [sessionId].csv.ts, [sessionId].pdf.ts and
 * the sign-in sheet, all from classRoster (src/server/classes.ts).
 *
 * Roster changes (src/server/roster-changes.ts): Add a child (a sign-up link,
 * or without charge after a fresh sign-in), Remove (a preview, then the
 * change), and Offer the spot / Withdraw offer on the waitlist. Buttons post
 * back here; changes redirect with ?done= so a reload doesn't repeat them.
 * Children's names are searched by POST, never put in the address.
 *
 * Drop-ins (src/server/drop-ins.ts): the roster for one date (?date=, the next
 * class by default) adds that day's drop-ins with the Drop-in badge; the
 * Drop-ins part lists them all with Cancel; "Add a drop-in" sends a pay link,
 * or books one with no charge after a fresh sign-in.
 *
 * Tags and skills (src/server/tags.ts, skills.ts): child tags on the roster,
 * "Show tagged …" (?tag=) and "Tag selected" (posts to ./[sessionId]/tags.ts);
 * the Skills part with the grid, its downloads and progress notes to send.
 */
import AdminShell from '@/components/admin/AdminShell.astro';
import Badges from '@/components/admin/Badges.astro';
import ClassSkills from '@/components/admin/ClassSkills.astro';
import RosterTags from '@/components/admin/RosterTags.astro';
import TagChips from '@/components/admin/TagChips.astro';
import { draftsForClass } from '@/server/progress-notes';
import { classSkillGrid } from '@/server/skills';
import { listTags, tagsForStudents, withTag } from '@/server/tags';
import DownloadLinks from '@/components/admin/DownloadLinks.astro';
import { classAttendance as attendanceList, classDropIns as classDropInsLink, classEmail, classes, classPage, classPrint, classSignInSheet, downloads, family, paymentsOrder, settingsDaysOff, teachRoster } from '@/lib/admin-links';
import { classAttendance } from '@/server/attendance';
import { formatPhone, smsHref, telHref } from '@/lib/contacts';
import { formatCents, isWeeklyTuitionClass, meetings, todayInAthens } from '@/lib/pricing';
import { classDates } from '@/server/class-day';
import { capacityFor } from '@/server/family';
import { classLine, classRoster, type ClassRoster } from '@/server/classes';
import { newSendToken } from '@/server/messages';
import {
  OFFER_HOURS,
  REASON_MAX,
  RosterError,
  addCandidate,
  addProblem,
  addWithoutCharge,
  findChildren,
  noChargeLabel,
  offerDeadline,
  offerSpot,
  previewRemoval,
  removeChild,
  sendSignUpLink,
  withdrawOffer,
  type AddCandidate,
  type AddWay,
  type RemovalPreview,
} from '@/server/roster-changes';
import { requireFreshStaff, requireStaff } from '@/server/staff';
import {
  DropInError,
  addDropInWithoutCharge,
  cancelDropIn,
  classDropIns,
  dropInDates,
  dropInDay,
  dropInPrice,
  dropInRoster,
  dropInStatus,
  rosterDate,
  sendDropInPayLink,
  type DropInDate,
} from '@/server/drop-ins';

export const prerender = false;
const { staff, response } = requireStaff(Astro.locals);
if (response) return response;
const found = Astro.locals.content.findSession(Astro.params.sessionId ?? '');
if (!found) return new Response('Not found', { status: 404 });
const { program, session } = found;
const location = Astro.locals.content.locationById(session.locationId);
const here = classPage(session.id);
const plural = (n: number, one: string, many = `${one}s`) => `${n} ${n === 1 ? one : many}`;
const names = (xs: string[]) => (xs.length <= 1 ? (xs[0] ?? '') : `${xs.slice(0, -1).join(', ')} and ${xs[xs.length - 1]}`);
const shortDay = (iso: string) => new Date(`${iso}T12:00:00Z`).toLocaleDateString('en-US', { month: 'short', day: 'numeric', timeZone: 'UTC' });
/** Back here after a change, with what happened (so a reload doesn't do it twice). */
const after = (done: Record<string, string | number>, anchor = '') => `${here}?${new URLSearchParams(Object.entries(done).map(([k, v]) => [k, String(v)]))}${anchor}`;
/** A no-charge add needs a sign-in from the last 15 minutes; staff come back to this child's confirm step. */
const freshFor = (studentId: string) => requireFreshStaff(Astro.locals, new URL(`${here}?add=${encodeURIComponent(studentId)}`, Astro.url));

let removal: RemovalPreview | null = null;
let matches: AddCandidate[] | null = null;
let query = '';
let pick: (AddCandidate & { full: boolean }) | null = null;
let way: AddWay = 'link';
let reason = '';
let addError = '';
let actionError = '';
// Add a drop-in: find, choose a way and a date, confirm.
let dropMatches: AddCandidate[] | null = null;
let dropQuery = '';
let dropPick: AddCandidate | null = null;
let dropWay: AddWay = 'link';
let dropDate = '';
let dropReason = '';
let dropError = '';
let cancelError = '';
/** A no-charge drop-in needs a fresh sign-in too; staff come back to this child's confirm step. */
const freshForDrop = (studentId: string) => requireFreshStaff(Astro.locals, new URL(`${here}?dropAdd=${encodeURIComponent(studentId)}#drop-ins-h`, Astro.url));
if (staff && Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const get = (k: string) => String(form.get(k) ?? '');
  const overFull = form.get('overFull') === 'yes';
  try {
    switch (get('action')) {
      // Remove: see what changes, then remove.
      case 'remove-check':
        removal = await previewRemoval(get('enrollmentId'), session.id, get('mode') === 'only' ? 'only' : 'stop');
        if (!removal) return Astro.redirect(after({ done: 'gone' }), 303);
        break;
      case 'remove': {
        const r = await removeChild(get('enrollmentId'), session.id, get('mode') === 'only' ? 'only' : 'stop', staff.id);
        return Astro.redirect(after(r ? { done: get('mode') === 'only' ? 'removed-only' : 'removed', n: r.stopped, fd: r.familyDiscount } : { done: 'gone' }), 303);
      }
      // Add: find a child, choose a way, confirm.
      case 'find':
        query = get('q').trim();
        matches = query ? await findChildren(query, session.id, Astro.locals.content) : [];
        break;
      case 'add-check':
        way = get('way') === 'free' ? 'free' : 'link';
        if (way === 'free') {
          const stop = freshFor(get('studentId'));
          if (stop) return stop;
        }
        pick = await addCandidate(get('studentId'), session.id, Astro.locals.content);
        break;
      case 'add-free': {
        const stop = freshFor(get('studentId'));
        if (stop) return stop;
        way = 'free';
        reason = get('reason');
        try {
          await addWithoutCharge({ sessionId: session.id, studentId: get('studentId'), staffId: staff.id, reason, overFull });
          return Astro.redirect(after({ done: 'added' }), 303);
        } catch (e) {
          if (!(e instanceof RosterError)) throw e;
          addError = e.message;
          pick = await addCandidate(get('studentId'), session.id, Astro.locals.content);
        }
        break;
      }
      case 'send-link':
        way = 'link';
        try {
          const r = await sendSignUpLink({ sessionId: session.id, studentId: get('studentId'), staffId: staff.id, overFull, token: get('token') });
          return Astro.redirect(after({ done: r.duplicate ? 'link-again' : 'link', n: r.parents }), 303);
        } catch (e) {
          if (!(e instanceof RosterError)) throw e;
          addError = e.message;
          pick = await addCandidate(get('studentId'), session.id, Astro.locals.content);
        }
        break;
      // The waitlist.
      case 'offer':
        await offerSpot({ enrollmentId: get('enrollmentId'), sessionId: session.id, staffId: staff.id });
        return Astro.redirect(after({ done: 'offered' }, '#waitlist-h'), 303);
      case 'withdraw':
        return Astro.redirect(after({ done: (await withdrawOffer(get('offerId'), session.id, staff.id)) ? 'withdrawn' : 'gone' }, '#waitlist-h'), 303);
      // Drop-ins.
      case 'drop-find':
        dropQuery = get('q').trim();
        dropMatches = dropQuery ? await findChildren(dropQuery, session.id, Astro.locals.content) : [];
        break;
      case 'drop-check':
        dropWay = get('way') === 'free' ? 'free' : 'link';
        if (dropWay === 'free') {
          const stop = freshForDrop(get('studentId'));
          if (stop) return stop;
        }
        dropPick = await addCandidate(get('studentId'), session.id, Astro.locals.content);
        break;
      case 'drop-link':
      case 'drop-free': {
        dropWay = get('action') === 'drop-free' ? 'free' : 'link';
        if (dropWay === 'free') {
          const stop = freshForDrop(get('studentId'));
          if (stop) return stop;
        }
        dropDate = get('date');
        dropReason = get('reason');
        try {
          if (dropWay === 'free') {
            await addDropInWithoutCharge({ sessionId: session.id, studentId: get('studentId'), date: dropDate, staffId: staff.id, reason: dropReason, overFull });
            return Astro.redirect(after({ done: 'drop-added', date: dropDate }, '#drop-ins-h'), 303);
          }
          const r = await sendDropInPayLink({ sessionId: session.id, studentId: get('studentId'), date: dropDate, staffId: staff.id, token: get('token') });
          return Astro.redirect(after({ done: r.duplicate ? 'link-again' : 'drop-link', n: r.parents }, '#drop-ins-h'), 303);
        } catch (e) {
          if (!(e instanceof DropInError)) throw e;
          dropError = e.message;
          dropPick = await addCandidate(get('studentId'), session.id, Astro.locals.content);
        }
        break;
      }
      case 'drop-cancel':
        try {
          const ok = await cancelDropIn({ dropInId: get('dropInId'), sessionId: session.id, staffId: staff.id, reason: get('reason') });
          return Astro.redirect(after({ done: ok ? 'drop-cancelled' : 'gone' }, '#drop-ins-h'), 303);
        } catch (e) {
          if (!(e instanceof DropInError)) throw e;
          cancelError = `${get('dropInId')}:${e.message}`;
        }
        break;
    }
  } catch (e) {
    if (!(e instanceof RosterError)) throw e;
    actionError = e.message;
  }
}
// Back from a fresh sign-in: straight to that child's "Drop-in, no charge" step.
const dropAddParam = Astro.url.searchParams.get('dropAdd');
if (staff && !dropPick && dropAddParam && Astro.request.method === 'GET') {
  dropWay = 'free';
  dropPick = await addCandidate(dropAddParam, session.id, Astro.locals.content);
}
// Back from a fresh sign-in: straight to that child's "Add without charge" step.
const addParam = Astro.url.searchParams.get('add');
if (staff && !pick && addParam && Astro.request.method === 'GET') {
  way = 'free';
  pick = await addCandidate(addParam, session.id, Astro.locals.content);
}
const token = newSendToken();

const n = Number(Astro.url.searchParams.get('n') ?? 0);
const fd = Number(Astro.url.searchParams.get('fd') ?? 0);
const discountEnded = fd ? ` The 15% family discount ended for this family, so ${plural(fd, 'unpaid payment')} went back to the regular price. The family is emailed the new amounts.` : '';
const notice = actionError
  ? { ok: false, text: actionError }
  : (() => {
      switch (Astro.url.searchParams.get('done')) {
        case 'removed': return { ok: true, text: `Removed from the class.${n ? ` ${plural(n, 'upcoming charge')} stopped.` : ' No charges were stopped.'}${discountEnded}` };
        case 'removed-only': return { ok: true, text: `Removed from the class. Payments weren’t changed.${discountEnded}` };
        case 'added': return { ok: true, text: 'Added to the class, with no charge.' };
        case 'link': return { ok: true, text: `Sign-up link sent to ${plural(n, 'parent')}.` };
        case 'link-again': return { ok: true, text: 'That link was already sent.' };
        case 'offered': return { ok: true, text: `Offer sent. The family has ${OFFER_HOURS} hours to sign up.` };
        case 'withdrawn': return { ok: true, text: 'Offer withdrawn. They’re still on the waitlist.' };
        case 'drop-link': return { ok: true, text: `Pay link sent to ${plural(n, 'parent')}. The drop-in is booked once they pay.` };
        case 'drop-added': return { ok: true, text: 'Drop-in added, with no charge.' };
        case 'drop-cancelled': return { ok: true, text: 'Drop-in cancelled. If it was paid, refund it in the Stripe dashboard for now.' };
        case 'gone': return { ok: false, text: 'That changed in the meantime. Nothing was done.' };
        default: return null;
      }
    })();
const { students, waitlist }: ClassRoster = staff ? await classRoster(session.id, staff.id) : { students: [], waitlist: [] };
const cap = capacityFor(program, session);
const files = downloads(classPage(session.id));
const sheet = classSignInSheet(session.id);
const joined = (d: Date) => d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'America/New_York' });
// The Attendance part: each class date so far, from the teacher app.
const att = staff ? await classAttendance(session) : { dates: [], children: [] };
const attFiles = downloads(attendanceList(session.id));
// Every meeting, with days off struck through (src/server/class-day.ts).
const today = todayInAthens();
const dates = staff ? await classDates(session) : [];
const classesLeft = dates.filter((d) => d.date >= today && !d.dayOff).length;
const dateLabel = (iso: string) => new Date(`${iso}T12:00:00Z`).toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric', timeZone: 'UTC' });
const places = `${students.length}${cap ? ` of ${cap}` : ''} ${(cap ?? students.length) === 1 ? 'place' : 'places'}${cap ? ' filled' : ''}`;

// The roster's date: drop-ins are for one date. ?date= picks a class date; the next class by default.
const classDays = meetings(session);
const dateParam = Astro.url.searchParams.get('date');
const onDate = dateParam && classDays.includes(dateParam) ? dateParam : rosterDate(session);
const dropKids = staff && onDate ? await dropInRoster(session.id, onDate, staff.id) : [];
const rosterKids = [...students, ...dropKids].sort((a, b) => a.lastName.localeCompare(b.lastName) || a.firstName.localeCompare(b.firstName));
const isWeekly = isWeeklyTuitionClass(program, session);
const dropPrice = dropInPrice(Astro.locals.content.site, program, session);
const allDropIns = staff ? await classDropIns(program, session) : [];
const upcomingDropIns = allDropIns.filter((d) => d.date >= today);
const pastDropIns = allDropIns.filter((d) => d.date < today).reverse();
const dropDates: DropInDate[] = dropPick ? await dropInDates(program, session) : [];
const dropFiles = downloads(classDropInsLink(session.id));
// Tags (staff labels) on the roster, its tag filter (?tag=), and the Skills part.
const rosterTags = await tagsForStudents(rosterKids.map((c) => c.studentId));
const tagFilter = Astro.url.searchParams.get('tag');
const shownKids = withTag(rosterKids, rosterTags, tagFilter);
const childTags = staff ? (await listTags()).filter((t) => t.kind === 'child') : [];
const skillGrid = staff ? await classSkillGrid(program, session) : { skills: [], children: [] };
const noteDrafts = staff ? await draftsForClass(session.id, Astro.locals.content) : [];
---

<AdminShell title={program.title} section="classes" back={{ href: classes(), label: 'Classes' }}>
  <div class="admin-page">
    <div class="admin-head">
      <div>
        <h1>{program.title}</h1>
        <p class="class-line">{classLine(session, location?.name)}</p>
        <p class="class-counts" data-counts><strong>{places}</strong> · {waitlist.length} on the waitlist{upcomingDropIns.some((d) => d.status === 'booked') && ` · ${plural(upcomingDropIns.filter((d) => d.status === 'booked').length, 'drop-in')} ahead`}</p>
      </div>
      <div class="admin-head__actions class-actions">
        <a class="btn btn--outline btn--sm" href={classPrint(session.id)} data-print-link>Print</a>
        <a class="btn btn--outline btn--sm" href={classEmail(session.id)} data-email-link>Email the class</a>
        <a class="btn btn--outline btn--sm" href={sheet} data-download="sign-in">Sign-in sheet</a>
        <DownloadLinks csv={files.csv} pdf={files.pdf} what="the roster" />
      </div>
    </div>
    <p class="safety">Rosters include medical notes. Share them only with the teaching team. Views and downloads are logged.</p>
    {notice && <p class:list={['notice', { 'notice--error': !notice.ok }]} role="status" data-notice>{notice.text}</p>}

    <div class="roster-tools" data-roster-tools>
      <details class="tool" open={matches !== null || undefined}>
        <summary class="btn btn--outline btn--sm">Add a child</summary>
        <div class="tool__body">
          <form method="post" class="find" data-find>
            <label for="find-q">Child’s name</label>
            <div class="find__row">
              <input id="find-q" name="q" value={query} autocomplete="off" required maxlength="100" />
              <button class="btn btn--primary btn--sm" name="action" value="find">Find</button>
            </div>
          </form>
          {matches !== null && (matches.length === 0 ? (
            <p class="muted" data-no-match>No child matches “{query}”. A new family signs up from the class’s page on the website.</p>
          ) : (
            <ul class="picks" data-add-results>
              {matches.map((c) => {
                const linkProblem = addProblem(c, 'link');
                const freeProblem = addProblem(c, 'free');
                return (
                  <li class="pick" data-add-child={c.studentId}>
                    <div class="pick__who">
                      <strong>{c.name}</strong>
                      <span class="muted">{c.age !== null ? `Age ${c.age} · ` : ''}{c.family}</span>
                      {c.ageNote && <span class="warn-line">{c.ageNote}</span>}
                      {(linkProblem && freeProblem) && <span class="muted">{freeProblem}</span>}
                    </div>
                    {!(linkProblem && freeProblem) && (
                      <div class="pick__actions">
                        {!linkProblem && (
                          <form method="post"><input type="hidden" name="studentId" value={c.studentId} /><input type="hidden" name="way" value="link" /><button class="btn btn--outline btn--sm" name="action" value="add-check">Send a sign-up link</button></form>
                        )}
                        {!freeProblem && (
                          <form method="post"><input type="hidden" name="studentId" value={c.studentId} /><input type="hidden" name="way" value="free" /><button class="btn btn--outline btn--sm" name="action" value="add-check">Add without charge</button></form>
                        )}
                      </div>
                    )}
                  </li>
                );
              })}
            </ul>
          ))}
        </div>
      </details>

      {pick && (
        <form method="post" class="confirm" data-add-confirm={way}>
          <input type="hidden" name="studentId" value={pick.studentId} />
          <input type="hidden" name="token" value={token} />
          <h2>{way === 'free' ? `Add ${pick.name} without charge?` : `Send the ${pick.family} a sign-up link?`}</h2>
          {way === 'free' ? (
            <p>{pick.firstName} joins {program.title} with no payments. This doesn’t change anything else the family pays, and doesn’t count toward the 15% family discount.</p>
          ) : (
            <p>The parents get an email with a link to sign {pick.firstName} up for {program.title}. They pay through the normal sign-up, so prices and discounts apply as usual.</p>
          )}
          {addProblem(pick, way) && <p class="notice notice--error">{addProblem(pick, way)}</p>}
          {pick.ageNote && <p class="warn-box" data-age-warning>{pick.ageNote} You can still go ahead.</p>}
          {pick.full && (
            <div class="warn-box" data-full-warning>
              <p><strong>This class is full.</strong> {way === 'free' ? `Adding ${pick.firstName} goes over the limit.` : 'Until a place opens, the link only lets them join the waitlist.'}</p>
              <label class="check"><input type="checkbox" name="overFull" value="yes" required /> {way === 'free' ? 'Add anyway' : 'Send anyway'}</label>
            </div>
          )}
          {way === 'free' && (
            <div class="field">
              <label for="add-reason">Reason</label>
              <input id="add-reason" name="reason" value={reason} required maxlength={REASON_MAX} placeholder="Scholarship, staff child, trade…" />
              <p class="muted">Shown on the family’s page and on Payments as “No charge, added by staff: …”, and kept in the record. Leave out medical details.</p>
            </div>
          )}
          {addError && <p class="notice notice--error" role="alert" data-add-error>{addError}</p>}
          <div class="confirm__actions">
            <button class="btn btn--primary btn--sm" name="action" value={way === 'free' ? 'add-free' : 'send-link'} disabled={!!addProblem(pick, way)}>{way === 'free' ? 'Add without charge' : 'Send the link'}</button>
            <a class="btn btn--outline btn--sm" href={here}>Cancel</a>
          </div>
        </form>
      )}

      {isWeekly && (
        <details class="tool" open={dropMatches !== null || undefined} data-drop-in-tool>
          <summary class="btn btn--outline btn--sm">Add a drop-in</summary>
          <div class="tool__body">
            {dropPrice === null && <p class="muted">Families can’t book drop-ins for this class right now (Site settings → Drop-ins, or the class’s own setting). You can still add one with no charge.</p>}
            <form method="post" class="find" data-drop-find>
              <label for="drop-q">Child’s name</label>
              <div class="find__row">
                <input id="drop-q" name="q" value={dropQuery} autocomplete="off" required maxlength="100" />
                <button class="btn btn--primary btn--sm" name="action" value="drop-find">Find</button>
              </div>
            </form>
            {dropMatches !== null && (dropMatches.length === 0 ? (
              <p class="muted" data-no-match>No child matches “{dropQuery}”. A new family books a drop-in from the class’s page on the website.</p>
            ) : (
              <ul class="picks" data-drop-results>
                {dropMatches.map((c) => {
                  const inClass = c.status === 'active' || c.status === 'trial';
                  return (
                    <li class="pick" data-drop-child={c.studentId}>
                      <div class="pick__who">
                        <strong>{c.name}</strong>
                        <span class="muted">{c.age !== null ? `Age ${c.age} · ` : ''}{c.family}</span>
                        {c.ageNote && <span class="warn-line">{c.ageNote}</span>}
                        {inClass && <span class="muted">{c.firstName} is already in this class.</span>}
                      </div>
                      {!inClass && (
                        <div class="pick__actions">
                          {dropPrice !== null && (
                            <form method="post"><input type="hidden" name="studentId" value={c.studentId} /><input type="hidden" name="way" value="link" /><button class="btn btn--outline btn--sm" name="action" value="drop-check">Send a pay link</button></form>
                          )}
                          <form method="post"><input type="hidden" name="studentId" value={c.studentId} /><input type="hidden" name="way" value="free" /><button class="btn btn--outline btn--sm" name="action" value="drop-check">No charge</button></form>
                        </div>
                      )}
                    </li>
                  );
                })}
              </ul>
            ))}
          </div>
        </details>
      )}

      {dropPick && (
        <form method="post" class="confirm" data-drop-confirm={dropWay}>
          <input type="hidden" name="studentId" value={dropPick.studentId} />
          <input type="hidden" name="token" value={token} />
          <h2>{dropWay === 'free' ? `Add ${dropPick.name} as a drop-in, with no charge?` : `Send the ${dropPick.family} a pay link for a drop-in?`}</h2>
          {dropWay === 'free' ? (
            <p>{dropPick.firstName} is on the roster for that date only. No payment, and nothing else the family pays changes.</p>
          ) : (
            <p>The parents get an email with a link to pay {dropPrice !== null ? formatCents(dropPrice) : ''} for that date. {dropPick.firstName} is booked once they pay; until then the place isn’t held.</p>
          )}
          {(dropPick.status === 'active' || dropPick.status === 'trial') && <p class="notice notice--error">{dropPick.firstName} is already in this class.</p>}
          {dropPick.ageNote && <p class="warn-box">{dropPick.ageNote} You can still go ahead.</p>}
          <div class="field">
            <label for="drop-date">Date</label>
            <select id="drop-date" name="date" required data-drop-date>
              {dropDates.map((d) => (
                <option value={d.date} selected={d.date === dropDate} disabled={d.problem === 'day-off' || (d.problem === 'full' && dropWay === 'link')}>
                  {d.label}{d.problem === 'day-off' ? ' (no class)' : d.problem === 'full' ? ' (full)' : d.placesLeft !== undefined ? ` (${plural(d.placesLeft, 'place')} left)` : ''}
                </option>
              ))}
            </select>
          </div>
          {dropWay === 'free' && dropDates.some((d) => d.problem === 'full') && (
            <label class="check"><input type="checkbox" name="overFull" value="yes" /> If the date is full, add anyway</label>
          )}
          {dropWay === 'free' && (
            <div class="field">
              <label for="drop-reason">Reason</label>
              <input id="drop-reason" name="reason" value={dropReason} required maxlength={REASON_MAX} placeholder="Make-up for a missed class, trade…" />
              <p class="muted">Shown in the Drop-ins list as “No charge: …”, and kept in the record. Leave out medical details.</p>
            </div>
          )}
          {dropError && <p class="notice notice--error" role="alert" data-drop-error>{dropError}</p>}
          <div class="confirm__actions">
            <button class="btn btn--primary btn--sm" name="action" value={dropWay === 'free' ? 'drop-free' : 'drop-link'} disabled={dropPick.status === 'active' || dropPick.status === 'trial' || !dropDates.length}>{dropWay === 'free' ? 'Add the drop-in' : 'Send the link'}</button>
            <a class="btn btn--outline btn--sm" href={here}>Cancel</a>
          </div>
        </form>
      )}
    </div>

    <section class="roster-section" aria-labelledby="roster-h">
      <h2 id="roster-h">Roster <span class="muted">({students.length}{dropKids.length > 0 && ` + ${dropKids.length} drop-in${dropKids.length === 1 ? '' : 's'}`})</span></h2>
      {onDate && classDays.length > 1 && (
        <form method="get" class="roster-date" data-roster-date>
          <label for="roster-date">Drop-ins on</label>
          <select id="roster-date" name="date">
            {classDays.map((d) => <option value={d} selected={d === onDate}>{dropInDay(d)}{d === today ? ' (today)' : ''}</option>)}
          </select>
          <button class="btn btn--outline btn--sm">Show</button>
        </form>
      )}
      <RosterTags sessionId={session.id} date={dateParam && onDate === dateParam ? onDate : null} filter={tagFilter} tags={childTags} total={rosterKids.length} shown={shownKids.length} />
      {rosterKids.length === 0 ? (
        <div class="empty-state">
          <strong>No one enrolled yet.</strong>
          <p>Children show up here when a family signs up.</p>
        </div>
      ) : (
        <ul class="roster" data-roster>
          {shownKids.map((c) => {
            const medical = !!(c.allergies || c.medicalNotes);
            return (
              <li class="kid" data-child={c.studentId}>
                <details class="kid__care">
                  <summary>
                    <span class="kid__who">
                      <strong class="kid__name">{c.name}</strong>
                      {c.age !== null && <span class="muted">Age {c.age}</span>}
                    </span>
                    <Badges badges={c.badges} />
                    <TagChips tags={rosterTags.get(c.studentId)} />
                    <span class="kid__more" aria-hidden="true">Care details</span>
                  </summary>
                  <div class="care" data-care>
                    <div class:list={['care__block', medical ? 'care__block--alert' : null]} data-medical={medical ? 'yes' : 'no'}>
                      <h3>Allergies and medical</h3>
                      {medical ? (
                        <>
                          {c.allergies && <p><strong>Allergies:</strong> {c.allergies}</p>}
                          {c.medicalNotes && <p><strong>Medical notes:</strong> {c.medicalNotes}</p>}
                        </>
                      ) : (
                        <p class="muted">Nothing on file.</p>
                      )}
                    </div>
                    <div class:list={['care__block', c.pickupNotes ? 'care__block--warning' : null]}>
                      <h3>Pickup</h3>
                      {c.pickupNotes && <p><strong>Note:</strong> {c.pickupNotes}</p>}
                      {c.pickupPeople.length ? (
                        <ul class="people">
                          {c.pickupPeople.map((p) => (
                            <li>
                              <span>{p.name} <span class="muted">({p.relationship})</span></span>
                              {p.phone && <a class="btn btn--outline btn--sm" href={telHref(p.phone)}>Call <span class="sr-only">{p.name}</span></a>}
                            </li>
                          ))}
                        </ul>
                      ) : (
                        <p class="muted">Parents only. No other pickup people on file.</p>
                      )}
                    </div>
                    <div class:list={['care__block', c.emergencyContacts.length ? null : 'care__block--warning']}>
                      <h3>Emergency contacts</h3>
                      {c.emergencyContacts.length ? (
                        <ul class="people">
                          {c.emergencyContacts.map((p) => (
                            <li>
                              <span>{p.name} <span class="muted">({p.relationship}) {formatPhone(p.phone)}</span></span>
                              <a class="btn btn--outline btn--sm" href={telHref(p.phone)} data-call>Call <span class="sr-only">{p.name}</span></a>
                            </li>
                          ))}
                        </ul>
                      ) : (
                        <p class="warn" data-no-emergency>No emergency contact on file</p>
                      )}
                    </div>
                    <div class="care__block">
                      <h3>Photos</h3>
                      <p>{c.photoConsent === false ? 'No photos, please.' : c.photoConsent === true ? 'Photos are OK.' : 'Not asked yet.'}</p>
                    </div>
                  </div>
                </details>
                <div class="kid__family">
                  {c.parents.map((p) => (
                    <div class="parent">
                      <span class="parent__name">{p.name}{p.phone && <span class="muted"> {formatPhone(p.phone)}</span>}</span>
                      <span class="contact-links">
                        {p.phone && <a class="btn btn--outline btn--sm" href={telHref(p.phone)} data-call>Call <span class="sr-only">{p.name}</span></a>}
                        {p.phone && <a class="btn btn--outline btn--sm" href={smsHref(p.phone)} data-text>Text <span class="sr-only">{p.name}</span></a>}
                        <a class="btn btn--outline btn--sm" href={`mailto:${p.email}`} data-email>Email <span class="sr-only">{p.name}</span></a>
                      </span>
                    </div>
                  ))}
                  <a class="family-link" href={family(c.householdId)}>Family page<span class="sr-only">: {c.family}</span></a>
                </div>
                <div class="kid__actions" data-roster-actions>
                  <label class="check" data-tag-tick><input type="checkbox" form="tag-selected" name="studentId" value={c.studentId} /> Tick to tag<span class="sr-only"> {c.name}</span></label>
                  {c.dropInId ? (
                    <p class="muted no-charge" data-drop-in-note>Drop-in on {dropInDay(onDate!)} only{c.noChargeReason ? `. No charge: ${c.noChargeReason}` : ''}. Cancel it under Drop-ins.</p>
                  ) : c.noChargeReason && <p class="muted no-charge" data-no-charge>{noChargeLabel(c.noChargeReason)}</p>}
                  {c.dropInId ? null : removal?.enrollmentId === c.enrollmentId ? (
                    <form method="post" class="confirm" data-remove-check={removal.mode} id="remove-check">
                      <input type="hidden" name="enrollmentId" value={c.enrollmentId} />
                      <input type="hidden" name="mode" value={removal.mode} />
                      <h3>Remove {c.name} from {program.title}?</h3>
                      {removal.mode === 'only' ? (
                        <p>Payments stay as they are. Use this when {c.firstName} moved to another class and you’re handling the payments yourself.</p>
                      ) : removal.staying.length > 0 ? (
                        <p data-staying>
                          Payments for this order continue, because {names(removal.staying)} {removal.staying.length === 1 ? 'is' : 'are'} still in the class. To lower them, add a discount on the <a href={paymentsOrder(removal.orderId!)}>order page</a>.
                        </p>
                      ) : (
                        <p data-stopping>
                          {removal.stopping.length
                            ? `These charges are cancelled: ${removal.stopping.map((i) => `${shortDay(i.dueDate)} ${formatCents(i.amountCents)}`).join(', ')}.`
                            : 'This class has no charges left to stop.'}
                        </p>
                      )}
                      {removal.effects.length > 0 ? (
                        <>
                          <p data-discount-ends>
                            <strong>The 15% family discount ends:</strong> the family drops below two weekly classes, so these unpaid payments{removal.effects.some((e) => e.orderId === removal!.orderId) ? '' : ' for their other classes'} go back to the regular price.
                          </p>
                          <ul class="effects">
                            {removal.effects.flatMap((e) =>
                              e.changes.map((ch) => (
                                <li>
                                  <span><strong>{e.names.join(' & ')}</strong>, {Astro.locals.content.findSession(e.sessionId)?.program.title ?? 'a class'}, {shortDay(ch.dueDate)}</span>
                                  <span><s>{formatCents(ch.beforeCents)}</s> → <strong>{formatCents(ch.afterCents)}</strong> <span class="muted">(+{formatCents(ch.afterCents - ch.beforeCents)})</span></span>
                                </li>
                              )),
                            )}
                          </ul>
                          <p class="muted">The family is emailed the new amounts, and sees them in their account.</p>
                        </>
                      ) : (
                        <p class="muted">No other payment changes.</p>
                      )}
                      <p class="muted">Nothing already paid is refunded here. To give money back, refund it in the Stripe dashboard.</p>
                      <div class="confirm__actions">
                        <button class="btn btn--danger btn--sm" name="action" value="remove">{removal.mode === 'only' ? 'Remove only' : 'Remove and stop payments'}</button>
                        <a class="btn btn--outline btn--sm" href={here}>Cancel</a>
                      </div>
                    </form>
                  ) : (
                    <details class="tool">
                      <summary class="btn btn--outline btn--sm">Remove<span class="sr-only"> {c.name}</span></summary>
                      <form method="post" class="tool__body">
                        <input type="hidden" name="enrollmentId" value={c.enrollmentId} />
                        <input type="hidden" name="action" value="remove-check" />
                        <p class="muted">You’ll see what changes before anything is saved.</p>
                        <div class="confirm__actions">
                          <button class="btn btn--outline btn--sm" name="mode" value="stop">Remove and stop payments</button>
                          <button class="btn btn--outline btn--sm" name="mode" value="only">Remove only</button>
                        </div>
                      </form>
                    </details>
                  )}
                </div>
              </li>
            );
          })}
        </ul>
      )}
    </section>

    <section class="roster-section" aria-labelledby="attendance-h" data-attendance>
      <div class="att-head">
        <h2 id="attendance-h">Attendance</h2>
        {att.dates.length > 0 && <DownloadLinks csv={attFiles.csv} pdf={attFiles.pdf} what="the attendance" />}
      </div>
      {att.dates.length === 0 ? (
        <p class="muted">No classes yet. Teachers take attendance in the teacher app on the day.</p>
      ) : (
        <ul class="att-dates">
          {[...att.dates].reverse().map((d) => (
            <li data-att-date={d.date}>
              <a class="att-date" href={teachRoster(session.id, d.date)}>
                <span class="att-date__day">{new Date(`${d.date}T12:00:00Z`).toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric', timeZone: 'UTC' })}</span>
                {d.dayOff ? (
                  <span class="muted">No class: {d.dayOff}</span>
                ) : d.by ? (
                  <span><strong data-att-count>{d.present} of {d.marked}</strong> present <span class="muted">· taken by {d.by}</span></span>
                ) : (
                  <span class="warn-line" data-att-missing>Not taken{d.marked ? ` (${d.marked} marked)` : ''}</span>
                )}
              </a>
            </li>
          ))}
        </ul>
      )}
    </section>

    <ClassSkills sessionId={session.id} programSlug={program.slug} grid={skillGrid} drafts={noteDrafts} />

    <section class="roster-section" aria-labelledby="waitlist-h" data-waitlist>
      <h2 id="waitlist-h">Waitlist <span class="muted">({waitlist.length})</span></h2>
      {waitlist.length === 0 ? (
        <p class="muted">No one on the waitlist.</p>
      ) : (
        <ol class="waitlist">
          {waitlist.map((c) => (
            <li class="wait" data-waiting={c.studentId}>
              <div class="wait__who">
                <strong>{c.name}</strong>
                <span class="muted">{c.age !== null ? `Age ${c.age} · ` : ''}Joined {joined(c.joinedAt)}</span>
                {c.offer?.status === 'offered' && (
                  <span class="badges"><span class="badge badge--good" data-offered>Offered {joined(c.offer.offeredAt)}{c.offer.expiresAt && `, expires ${offerDeadline(c.offer.expiresAt)}`}</span></span>
                )}
                {c.offer?.status === 'expired' && <span class="warn-line" data-offer-expired>Expired: offer to the next family</span>}
              </div>
              <div class="kid__family">
                {c.parents.map((p) => (
                  <div class="parent">
                    <span class="parent__name">{p.name}{p.phone && <span class="muted"> {formatPhone(p.phone)}</span>}</span>
                    <span class="contact-links">
                      {p.phone && <a class="btn btn--outline btn--sm" href={telHref(p.phone)} data-call>Call <span class="sr-only">{p.name}</span></a>}
                      {p.phone && <a class="btn btn--outline btn--sm" href={smsHref(p.phone)} data-text>Text <span class="sr-only">{p.name}</span></a>}
                      <a class="btn btn--outline btn--sm" href={`mailto:${p.email}`} data-email>Email <span class="sr-only">{p.name}</span></a>
                    </span>
                  </div>
                ))}
                <a class="family-link" href={family(c.householdId)}>Family page<span class="sr-only">: {c.family}</span></a>
              </div>
              <div class="wait__actions" data-waitlist-actions>
                {c.offer?.status === 'offered' ? (
                  <form method="post">
                    <input type="hidden" name="offerId" value={c.offer.id} />
                    <button class="btn btn--outline btn--sm" name="action" value="withdraw">Withdraw offer<span class="sr-only"> to {c.name}</span></button>
                  </form>
                ) : (
                  <details class="tool">
                    <summary class="btn btn--outline btn--sm">Offer the spot<span class="sr-only"> to {c.name}</span></summary>
                    <form method="post" class="tool__body">
                      <input type="hidden" name="enrollmentId" value={c.enrollmentId} />
                      <p class="muted">Emails the parents that a place opened. They have {OFFER_HOURS} hours to sign up and pay; the place goes to the first family who does.</p>
                      <button class="btn btn--primary btn--sm" name="action" value="offer">Send the offer</button>
                    </form>
                  </details>
                )}
              </div>
            </li>
          ))}
        </ol>
      )}
    </section>

    <section class="roster-section" aria-labelledby="dates-h" data-class-dates>
      <div class="dates-head">
        <h2 id="dates-h">Dates <span class="muted">({plural(classesLeft, 'class', 'classes')} left)</span></h2>
        <a class="btn btn--outline btn--sm" href={settingsDaysOff(session.id)} data-add-day-off>Add a day off</a>
      </div>
      {dates.length === 0 ? (
        <p class="muted">No dates.</p>
      ) : (
        <ol class="dates">
          {dates.map((d) => (
            <li class:list={['date', { 'date--past': d.date < today, 'date--off': !!d.dayOff }]} data-date={d.date}>
              {d.dayOff ? (
                <><s>{dateLabel(d.date)}</s> <span class="date__off" data-day-off>No class: {d.dayOff.reason}</span></>
              ) : (
                <span>{dateLabel(d.date)}</span>
              )}
            </li>
          ))}
        </ol>
      )}
    </section>
    {(isWeekly || allDropIns.length > 0) && (
      <section class="roster-section" aria-labelledby="drop-ins-h" data-drop-ins>
        <div class="section-head">
          <h2 id="drop-ins-h">Drop-ins <span class="muted">({upcomingDropIns.filter((d) => d.status === 'booked').length} ahead)</span></h2>
          <DownloadLinks csv={dropFiles.csv} pdf={dropFiles.pdf} what="the drop-ins" />
        </div>
        {allDropIns.length === 0 ? (
          <p class="muted">No drop-ins yet.{dropPrice !== null && ` Families book them from the class’s page on the website (${formatCents(dropPrice)} a class).`}</p>
        ) : (
          [{ title: 'Coming up', rows: upcomingDropIns, key: 'upcoming' }, { title: 'Past', rows: pastDropIns, key: 'past' }].filter((g) => g.rows.length).map((g) => (
            <>
              <h3 class="sub-h">{g.title}</h3>
              <table class="data-table" data-drop-in-list={g.key}>
                <thead><tr><th>Date</th><th>Child</th><th>Family</th><th>Paid</th><th><span class="sr-only">Actions</span></th></tr></thead>
                <tbody>
                  {g.rows.map((d) => (
                    <tr data-drop-in-row={d.id} data-status={d.status}>
                      <td data-label="Date">{dropInDay(d.date)}</td>
                      <td data-label="Child"><span><strong>{d.child}</strong>{d.overLimit && <span class="badges"><span class="badge badge--warning" data-over-limit>Over the limit</span></span>}</span></td>
                      <td data-label="Family"><a class="cell-link" href={family(d.householdId)}>{d.family}</a></td>
                      <td data-label="Paid"><span>{dropInStatus(d)}{d.orderId && d.paid && <> · <a class="cell-link" href={paymentsOrder(d.orderId)}>Payment<span class="sr-only"> for {d.child}’s drop-in</span></a></>}</span></td>
                      <td data-label="">
                        {d.status !== 'cancelled' && (
                          <details class="tool">
                            <summary class="btn btn--outline btn--sm">Cancel<span class="sr-only"> {d.child}’s drop-in on {dropInDay(d.date)}</span></summary>
                            <form method="post" class="tool__body">
                              <input type="hidden" name="dropInId" value={d.id} />
                              <div class="field">
                                <label for={`cancel-${d.id}`}>Reason</label>
                                <input id={`cancel-${d.id}`} name="reason" required maxlength={REASON_MAX} placeholder="Sick, booked by mistake…" />
                              </div>
                              {d.paid && <p class="muted">Nothing is refunded here. Refund it in the Stripe dashboard for now.</p>}
                              {cancelError.startsWith(`${d.id}:`) && <p class="notice notice--error" role="alert">{cancelError.slice(d.id.length + 1)}</p>}
                              <button class="btn btn--danger btn--sm" name="action" value="drop-cancel">Cancel the drop-in</button>
                            </form>
                          </details>
                        )}
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </>
          ))
        )}
      </section>
    )}
  </div>
</AdminShell>

<style>
  /* admin.css's `.admin-head > div { display: grid }` outranks .admin-head__actions' flex row. */
  .admin-head > .class-actions { flex: 1 1 100%; display: flex; flex-wrap: wrap; gap: 0.5rem; align-items: center; }
  .class-line { color: var(--ink-soft); }
  .class-counts { font-size: var(--step--1); color: var(--ink-soft); }
  .safety { font-size: var(--step--1); color: var(--ink-mute); max-width: var(--measure); }
  .muted { color: var(--ink-mute); font-weight: 400; }
  .roster-section { display: grid; gap: var(--space-s); }
  .roster-section h2 { font-size: var(--step-1); }
  .dates-head { display: flex; flex-wrap: wrap; gap: 0.5rem 1rem; align-items: center; justify-content: space-between; }
  .dates { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 13rem), 1fr)); gap: 0.4rem; }
  .date { padding: 0.45rem 0.7rem; border: 1.5px solid var(--line); border-radius: var(--r-sm); background: var(--paper); font-size: var(--step--1); font-variant-numeric: tabular-nums; }
  .date--past { color: var(--ink-mute); background: transparent; }
  .date--off { border-color: var(--red); background: var(--red-tint); }
  .date--off s { color: var(--ink-mute); }
  .date__off { display: block; font-weight: 650; color: var(--red-ink); overflow-wrap: anywhere; }
  .roster,
  .waitlist,
  .people { list-style: none; margin: 0; padding: 0; }
  .roster,
  .waitlist { display: grid; gap: var(--space-s); }
  .kid,
  .wait {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 0.75rem var(--space-l);
    align-items: start;
    padding: 0.8rem 1rem;
    border: 1.5px solid var(--line-strong);
    border-radius: var(--r-md);
    background: var(--paper);
    min-width: 0;
  }
  .kid__care summary {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.75rem;
    min-height: 44px;
    cursor: pointer;
    list-style: none;
  }
  .kid__care summary::-webkit-details-marker { display: none; }
  .kid__who,
  .wait__who { display: grid; gap: 0.1rem; min-width: 0; }
  .kid__name { font-size: var(--step-0); }
  .kid__more { font-size: var(--step--1); color: var(--purple); text-decoration: underline; white-space: nowrap; }
  .kid__more::after { content: ' ▸'; text-decoration: none; display: inline-block; }
  .kid__care[open] .kid__more::after { content: ' ▾'; }
  .care { display: grid; gap: 0.6rem; margin-top: 0.75rem; }
  .care__block { padding: 0.6rem 0.8rem; border-radius: var(--r-sm); background: var(--hall); font-size: var(--step--1); display: grid; gap: 0.3rem; }
  .care__block h3 { font-family: var(--font-script); font-size: var(--step--2); font-weight: 400; text-transform: uppercase; color: var(--ink-mute); }
  .care__block p { margin: 0; overflow-wrap: anywhere; }
  .care__block--alert { background: var(--red-tint); color: var(--red-ink); border-left: 5px solid var(--red); }
  .care__block--alert h3 { color: var(--red-ink); }
  .care__block--warning { background: var(--yellow-tint); border-left: 5px solid var(--yellow); }
  .warn { color: var(--yellow-ink); font-weight: 700; }
  .people { display: grid; gap: 0.4rem; }
  .people li,
  .parent { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.3rem 0.6rem; }
  .people li > span,
  .parent__name { min-width: 0; overflow-wrap: anywhere; }
  .kid__family { display: grid; gap: 0.5rem; font-size: var(--step--1); min-width: 0; }
  .contact-links { display: flex; flex-wrap: wrap; gap: 0.35rem; }
  .family-link { justify-self: start; display: inline-flex; align-items: center; min-height: 44px; }
  .kid__actions,
  .wait__actions { grid-column: 1 / -1; display: grid; gap: 0.5rem; justify-items: start; min-width: 0; }
  .roster-tools { display: grid; gap: var(--space-s); }
  .tool { min-width: 0; max-width: 100%; }
  .tool > summary { list-style: none; cursor: pointer; }
  .tool > summary::-webkit-details-marker { display: none; }
  .tool[open] > summary { background: var(--hall); }
  .tool__body { display: grid; gap: 0.6rem; margin-top: 0.6rem; max-width: var(--measure); }
  .find { display: grid; gap: 0.3rem; }
  .find label { font-weight: 650; font-size: var(--step--1); }
  .find__row { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .find__row input { flex: 1 1 12rem; min-width: 0; min-height: 44px; }
  .picks { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.5rem; }
  .pick { display: flex; flex-wrap: wrap; gap: 0.5rem 1rem; justify-content: space-between; align-items: center; padding: 0.6rem 0.8rem; border: 1.5px solid var(--line-strong); border-radius: var(--r-md); background: var(--paper); min-width: 0; }
  .pick__who { display: grid; gap: 0.1rem; min-width: 0; overflow-wrap: anywhere; }
  .pick__actions,
