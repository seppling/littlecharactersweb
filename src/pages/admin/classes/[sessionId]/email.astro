---
/**
 * Staff: "Email the class". One email to each family in the class (enrolled
 * and trial; the waitlist when ticked), from the site, logged on each family's
 * page. Steps: src/server/message-composer.ts; sending: src/server/messages.ts.
 */
import AdminShell from '@/components/admin/AdminShell.astro';
import MessageComposer from '@/components/admin/MessageComposer.astro';
import { classEmail, classPage } from '@/lib/admin-links';
import { classLine } from '@/server/classes';
import { blankState, composerStep, sentHere, type ComposerContext, type ComposerState } from '@/server/message-composer';
import { classAudience, earlierMessages, footerFor } from '@/server/messages';
import { requireStaff } from '@/server/staff';

export const prerender = false;
const { staff, response } = requireStaff(Astro.locals);
if (response) return response;
const found = Astro.locals.content.findSession(Astro.params.sessionId ?? '');
if (!found) return new Response('Not found', { status: 404 });
const { program, session } = found;
const location = Astro.locals.content.locationById(session.locationId);
const here = classEmail(session.id);

let state: ComposerState | null = null;
let sent: Awaited<ReturnType<typeof sentHere>> = null;
let earlier: Awaited<ReturnType<typeof earlierMessages>> = [];
let audience: ComposerContext['audience'] = [];
const footer = footerFor(program.title);
if (staff) {
  audience = await classAudience(session.id);
  const ctx: ComposerContext = { kind: 'class', sessionId: session.id, here, audience, footer, staff };
  if (Astro.request.method === 'POST') {
    const result = await composerStep(await Astro.request.formData(), ctx);
    if ('redirect' in result) return Astro.redirect(result.redirect, 303);
    state = result.state;
  } else {
    sent = await sentHere(Astro.url.searchParams.get('sent') ?? '', ctx);
    if (!sent) state = blankState(ctx);
  }
  earlier = await earlierMessages({ sessionId: session.id });
}
const sentNotice = Astro.url.searchParams.get('again') ? 'This email was already sent. It wasn’t sent again.' : Astro.url.searchParams.get('retried') ? 'Tried again.' : undefined;
---

<AdminShell title={`Email: ${program.title}`} section="classes" back={{ href: classPage(session.id), label: program.title }}>
  {
    staff && (
      <MessageComposer
        kind="class"
        heading={`Email the class: ${program.title}`}
        line={classLine(session, location?.name)}
        here={here}
        doneHref={classPage(session.id)}
        doneLabel="Back to the class"
        audience={audience}
        footer={footer}
        state={state}
        sent={sent}
        sentNotice={sentNotice}
        earlier={earlier}
      />
    )
  }
</AdminShell>
