---
/** Staff: monthly autopay at a glance. Charges that need a person, and what's coming on the 1st. */
import AdminShell from '@/components/admin/AdminShell.astro';
import { billingOverview, failureReason, markPaidOutsideStripe, stopRemainingPayments, totalDue, waiveLateFee } from '@/server/billing';
import { formatCents } from '@/lib/pricing';
import { payments, paymentsOrder } from '@/lib/admin-links';
import { requireStaff } from '@/server/staff';
import { orderBilling, ordersWithUpcomingPayments } from '@/server/adjustments';
import { previewStopEffect, type FamilyDiscountEffect } from '@/server/family-discount';

export const prerender = false;
const { staff: viewer, response } = requireStaff(Astro.locals);
if (response) return response;
const isAdmin = !!viewer;

const classTitle = (sessionId: string) => Astro.locals.content.findSession(sessionId)?.program.title ?? sessionId;
const fmt = (iso: string) => new Date(`${iso}T12:00:00Z`).toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric', timeZone: 'UTC' });
const plural = (n: number, one: string, many = `${one}s`) => `${n} ${n === 1 ? one : many}`;

let notice = '';
let stopCheck: { orderId: string; family: string; title: string; stopping: { dueDate: string; amountCents: number }[]; effects: FamilyDiscountEffect[] } | null = null;
if (isAdmin && viewer && Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const id = String(form.get('id') ?? '');
  if (form.get('action') === 'paid' && (await markPaidOutsideStripe(id, viewer.id))) notice = 'Marked as paid.';
  if (form.get('action') === 'waive' && (await waiveLateFee(id, viewer.id))) notice = 'Late fee waived.';
  // Stop payments is two steps: see what changes (the family discount may end for the family's other classes), then stop.
  if (form.get('action') === 'check-stop') {
    const billing = await orderBilling(id);
    if (billing) {
      stopCheck = {
        orderId: id,
        family: billing.family,
        title: classTitle(billing.order.sessionId),
        stopping: billing.installments.filter((i) => i.status === 'scheduled' || i.status === 'failed'),
        effects: await previewStopEffect(id),
      };
    }
  }
  if (form.get('action') === 'stop') {
    const r = await stopRemainingPayments(id, viewer.id);
    notice = `Stopped ${plural(r.stopped, 'upcoming charge')} for that family’s class.`;
    if (r.familyDiscount.length) notice += ` The 15% family discount ended for this family, so ${plural(r.familyDiscount.length, 'unpaid payment')} for their other classes went back to the regular price.`;
  }
}

const { needsAttention, nextDue, nextDueRows } = isAdmin ? await billingOverview() : { needsAttention: [], nextDue: undefined, nextDueRows: [] };
const families = isAdmin ? await ordersWithUpcomingPayments() : [];
const total = nextDueRows.reduce((a, r) => a + r.i.amountCents, 0);
---

<AdminShell title="Billing" section="payments">
  <section class="wrap admin">
    <h1>Monthly autopay</h1>
    {notice && <p class="notice" role="status">{notice}</p>}

    {
      stopCheck && (
        <form method="post" class="stop-check" data-stop-check>
          <h2>Stop payments: {stopCheck.family}, {stopCheck.title}?</h2>
          <p>
            Use this when a family withdraws.{' '}
            {stopCheck.stopping.length
              ? `These charges are cancelled: ${stopCheck.stopping.map((i) => `${fmt(i.dueDate)} ${formatCents(i.amountCents)}`).join(', ')}.`
              : 'This class has no charges left to stop.'}
          </p>
          {stopCheck.effects.length > 0 ? (
            <>
              <p><strong>The 15% family discount ends:</strong> the family drops below two weekly classes, so these unpaid payments for their other classes go back to the regular price.</p>
              <ul class="effects" data-stop-effects>
                {stopCheck.effects.flatMap((e) =>
                  e.changes.map((c) => (
                    <li>
                      <span><strong>{e.names.join(' & ')}</strong>, {classTitle(e.sessionId)}, {fmt(c.dueDate)}</span>
                      <span><s>{formatCents(c.beforeCents)}</s> → <strong>{formatCents(c.afterCents)}</strong> <span class="muted">(+{formatCents(c.afterCents - c.beforeCents)})</span></span>
                    </li>
                  )),
                )}
              </ul>
              <p class="muted">The family is emailed the new amounts, and sees them in their account.</p>
            </>
          ) : (
            <p class="muted">No other payment changes.</p>
          )}
          <input type="hidden" name="id" value={stopCheck.orderId} />
          <div class="stop-check__buttons">
            <button name="action" value="stop" class="btn btn--primary btn--sm">Stop payments</button>
            <a class="btn btn--outline btn--sm" href={payments()}>Cancel</a>
          </div>
        </form>
      )
    }

    <h2>Needs attention ({needsAttention.length})</h2>
    {
      needsAttention.length ? (
        <table>
          <thead><tr><th>Family</th><th>For</th><th>Amount</th><th>What happened</th><th></th></tr></thead>
          <tbody>
            {needsAttention.map(({ i, family }) => (
              <tr>
                <td><a href={paymentsOrder(i.orderId)}>{family}</a></td>
                <td>{i.label}<br /><span class="muted">due {fmt(i.dueDate)}</span></td>
                <td>{formatCents(totalDue(i))}{i.lateFeeCents > 0 && <><br /><span class="muted">incl. {formatCents(i.lateFeeCents)} late fee</span></>}</td>
                <td>
                  {i.status === 'processing' ? 'Charge in progress' : `${failureReason(i.lastError ?? '')} (${i.attempts} ${i.attempts === 1 ? 'try' : 'tries'})`}
                  <br /><span class="muted">{i.status === 'failed' ? (i.retryOn ? `Retrying ${fmt(i.retryOn)}` : 'Waiting for the family to pay') : ''}</span>
                </td>
                <td>
                  <div class="actions">
                    <form method="post"><input type="hidden" name="id" value={i.id} /><button name="action" value="paid" class="btn btn--outline btn--sm">Paid by cash/check</button></form>
                    {i.lateFeeCents > 0 && <form method="post"><input type="hidden" name="id" value={i.id} /><button name="action" value="waive" class="btn btn--outline btn--sm">Waive late fee</button></form>}
                    <form method="post"><input type="hidden" name="id" value={i.orderId} /><button name="action" value="check-stop" class="btn btn--outline btn--sm">Stop payments</button></form>
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      ) : (
        <p class="muted">Nothing. Every charge so far has gone through.</p>
      )
    }

    <h2>{nextDue ? `Next: ${fmt(nextDue)}, ${nextDueRows.length} charge${nextDueRows.length === 1 ? '' : 's'}, ${formatCents(total)}` : 'No upcoming charges'}</h2>
    {
      nextDueRows.length > 0 && (
        <table>
          <thead><tr><th>Family</th><th>For</th><th>Amount</th><th></th></tr></thead>
          <tbody>
            {nextDueRows.map(({ i, family }) => (
              <tr>
                <td><a href={paymentsOrder(i.orderId)}>{family}</a></td>
                <td>{i.label}</td>
                <td>{formatCents(i.amountCents)}</td>
                <td>
                  <div class="actions">
                    <form method="post"><input type="hidden" name="id" value={i.orderId} /><button name="action" value="check-stop" class="btn btn--outline btn--sm">Stop payments</button></form>
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      )
    }
    <h2 id="families">Families on monthly autopay ({families.length})</h2>
    {
      families.length > 0 ? (
        <table data-families>
          <thead><tr><th>Family</th><th>Class</th><th>Payments left</th><th></th></tr></thead>
          <tbody>
            {families.map((f) => (
              <tr>
                <td>{f.family}</td>
                <td>{classTitle(f.sessionId)}</td>
                <td>{f.remaining}{f.adjusted > 0 && <><br /><span class="muted">{f.adjusted} discounted</span></>}</td>
                <td><div class="actions"><a class="btn btn--outline btn--sm" href={paymentsOrder(f.orderId)}>Payments & discounts</a></div></td>
              </tr>
            ))}
          </tbody>
        </table>
      ) : (
        <p class="muted">No family has monthly payments left.</p>
      )
    }
    <p class="muted">To give a family a discount (a scholarship, a sibling deal, a credit for a missed class), open their payments above and add it there.</p>
    <p class="muted">Charges run automatically each morning. Failed charges are retried on the 4th and 7th, and the family is emailed each time with a link to pay. A month still unpaid on the 11th gets a $15 late fee (you can waive it here). When a family withdraws, use Stop payments; refunds are issued in the Stripe dashboard.</p>
  </section>
</AdminShell>

<style>
  .admin { padding-block: var(--space-2xl) var(--space-3xl); display: grid; gap: var(--space-m); }
  h2 { font-size: var(--step-1); margin-top: var(--space-m); }
  table { width: 100%; border-collapse: collapse; font-variant-numeric: tabular-nums; }
  th, td { text-align: left; padding: 0.6rem 0.5rem; border-bottom: 1px solid var(--line); vertical-align: top; }
  th { font-family: var(--font-script); font-size: var(--step--2); text-transform: uppercase; color: var(--ink-mute); }
  .muted { color: var(--ink-mute); font-size: var(--step--1); }
  .actions { display: flex; flex-wrap: wrap; gap: 0.4rem; justify-content: flex-end; }
  .notice { padding: 0.7rem 1rem; background: var(--ok-tint); color: var(--ok); border-radius: var(--r-sm); font-weight: 600; }
  .stop-check { display: grid; gap: 0.75rem; padding: var(--space-m); border: 1.5px solid var(--yellow); background: var(--yellow-tint); border-radius: var(--r-md); }
  .stop-check h2 { margin-top: 0; }
  .stop-check p { margin: 0; }
  .stop-check__buttons { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .effects { list-style: none; margin: 0; padding: 0; }
  .effects li { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.2rem 1rem; padding: 0.5rem 0; border-bottom: 1px solid var(--line); font-variant-numeric: tabular-nums; }
  .effects s { color: var(--ink-mute); }
  /* Long class names ("LC/Geode Performance Troupe") wrap instead of pushing the page sideways on phones. */
  td { overflow-wrap: anywhere; }
</style>
