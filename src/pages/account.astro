---
/**
 * Placeholder for the Phase 2 family portal. In 'studio-director' mode the
 * header links straight to Studio Director; this page exists so /account is a
 * stable URL families can bookmark before and after the switch.
 */
import Base from '@/layouts/Base.astro';
import Character from '@/components/Character.astro';
import { site } from '@/config/site';
---

<Base title="Family login" description="Log in to manage enrollments and payments.">
  <section class="acct">
    <div class="wrap wrap--narrow acct__card">
      <div class="acct__cast" aria-hidden="true">
        <Character name="magician" size={72} />
        <Character name="royal" size={88} />
      </div>
      <h1>Family login</h1>
      <p class="lede">Manage enrollments, update your student’s details and pay your balance in the family portal.</p>
      <a class="btn btn--primary" href={site.portal.studioDirector.login} rel="noopener">
        Go to the family portal <span class="arrow" aria-hidden="true">→</span>
      </a>
      <p class="acct__help">Trouble logging in? Email <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a>.</p>
    </div>
  </section>
</Base>

<style>
  .acct { padding-block: var(--space-3xl); background: var(--hall); }
  .acct__card {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: var(--space-l);
    padding-block: var(--space-2xl);
    background: var(--paper);
    border-radius: var(--r-lg);
    border: 2px solid var(--ink);
    box-shadow: 8px 8px 0 var(--orange);
  }
  .acct__cast { display: flex; align-items: flex-end; gap: 0.3rem; }
  .acct h1 { font-size: var(--step-4); }
  .acct__help { color: var(--ink-soft); font-size: var(--step--1); }
</style>
