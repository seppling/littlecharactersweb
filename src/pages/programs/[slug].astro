---
import LeadFormFields from '@/components/LeadFormFields.astro';
import Base from '@/layouts/Base.astro';
import ProgramCard from '@/components/ProgramCard.astro';
import FaqList from '@/components/FaqList.astro';
import { kindLabels } from '@/content/catalog';
import { rich } from '@/content/rich';
import { ageLabel, feeLabel, priceLabel, spotsLabel } from '@/lib/format';
import { cardParts, performanceLabel, sessionLines, sessionPrice, whenSummary } from '@/lib/class-summary';
import { enrollHref, enrollLabel, isExternal } from '@/lib/enroll';
import { formatCents, hasFreeFirstClass, joiningNow, sessionPriceParts, todayInAthens } from '@/lib/pricing';
import { dropInPrice, dropInsOffered } from '@/server/drop-ins';
import { bookingClock, offeredSessions, sessionState } from '@/lib/session-dates';
import { breadcrumbLd, courseLd, isCourse } from '@/lib/seo';
import { faqsFor, highlightsHeading, isAdult, kindTag, moneyLines, perChild } from '@/lib/program-fit';

const { programs, faqs, locationById, programBySlug, vars, site } = Astro.locals.content;
const found = programBySlug(Astro.params.slug ?? '');
if (!found) return Astro.rewrite('/404');
const program = found;

// Only dates families can still sign up for (or hear about): past dates, and
// weekly classes past their late-joining cut-off, leave on their own.
const clock = bookingClock(site.lateJoinWeeks);
const bookable = offeredSessions(program, clock);
const firstOpen = bookable.find((s) => s.status === 'open' || s.status === 'few-left') ?? bookable[0];
const fromPrice = program.priceFrom ?? bookable.find((s) => s.price)?.price;
// The summary at the top says when and where from the sessions families can pick;
// the card below it only repeats what differs between those sessions.
const shown = bookable.length > 0 ? bookable : program.sessions;
const places = [...new Set(shown.map((s) => s.locationId))].map((id) => locationById(id)).filter((l) => l != null);
const when = whenSummary(bookable);
const parts = cardParts(bookable);
const isCamp = program.kind === 'camp';
const comingSoon = bookable.length > 0 && bookable.every((s) => s.status === 'coming-soon');
const partnerOnly = bookable.length > 0 && bookable.every((s) => s.externalUrl && !s.externalUrl.includes('docs.google.com'));
// Nothing left to pick: say what's next, with the "tell me when" signup.
const hadDates = program.sessions.length > 0 && !program.requestCta;
const datesSoon = bookable.length === 0 && (program.notify || hadDates);
const running = program.sessions.find((s) => s.status !== 'closed' && sessionState(program, s, clock) === 'signups-closed' && s.startDate !== s.endDate);
const monthly = program.priceFrom?.unit === 'month';
// A class priced per session says what the session covers: "$160 for 9 weeks ($17.78 a class)".
const priceSession = firstOpen ?? program.sessions.at(-1);
const sessionParts = sessionPriceParts(fromPrice, priceSession);
// What a new student pays today and after, for each date on the card (src/lib/pricing.ts joiningNow).
const today = todayInAthens();
const joining = new Map(bookable.filter((s) => s.status !== 'coming-soon' && !partnerOnly).map((s) => [s.id, joiningNow(program, s, today)] as const));
const freeTrial = hasFreeFirstClass(program) && !partnerOnly;

// "Drop in for one class": weekly classes that have started or start within 14 days (src/server/drop-ins.ts).
// One under the button for the date picked above; one each for a class past its sign-up cut-off.
const dropIns = program.sessions.filter((s) => dropInsOffered(site, program, s)).map((s) => ({ s, label: `Drop in for one class · ${formatCents(dropInPrice(site, program, s)!)}`, listed: bookable.includes(s) }));

// What fits this kind of program: its pricing lines, FAQs and the heading over its highlights.
const money = moneyLines(program);
const children = perChild(program);
const relevantFaqs = faqsFor(program, faqs);

const related = programs
  .filter((p) => p.slug !== program.slug && p.brand === program.brand && p.kind === program.kind)
  .filter((p) => p.ages.min <= (program.ages.max ?? 120) + 2 && (p.ages.max ?? 120) >= program.ages.min - 2)
  .slice(0, 3);

const backHref = program.brand === 'geode' ? '/geode' : isCamp ? '/camps' : `/programs?kind=${program.kind}`;
const backLabel = program.brand === 'geode' ? 'Geode' : isCamp ? 'Camps' : kindLabels[program.kind].plural;

// For search engines: the same trail as the links above the heading, and the class itself.
const pageUrl = new URL(`/programs/${program.slug}`, site.url).href;
const structuredData = [
  breadcrumbLd([
    { name: 'Find a class', url: new URL('/programs', site.url).href },
    { name: backLabel, url: new URL(backHref, site.url).href },
    { name: program.title },
  ]),
  ...(isCourse(program) ? [courseLd(program, { site, url: pageUrl })] : []),
];
---

<Base
  title={program.title}
  description={program.summary}
  seo={program.seo}
  image={program.image}
  structuredData={structuredData}
  edit={`/admin/content/programs/${program.slug}`}
>
  <article class="ppage" data-gel={program.gel}>
    <div class="wrap ppage__grid">
      <header class="phero stack" style="--stack: var(--space-l)">
        <nav class="crumbs" aria-label="Breadcrumb">
          <a href="/programs">Find a class</a>
          <span aria-hidden="true">/</span>
          <a href={backHref}>{backLabel}</a>
        </nav>
        <div class="phero__tags">
          <span class="tape">{kindTag(program)}</span>
          <span class="tape tape--quiet" data-tilt="right">{ageLabel(program.ages, program.agesLabel)}</span>
          {program.brand === 'geode' && <span class="tape tape--ink" data-tilt="flat">Geode</span>}
        </div>
        <h1>{program.title}</h1>
        <p class="lede">{program.tagline}</p>
        <dl class="phero__facts">
          {when ? (
            <div class="phero__wide">
              <dt>When</dt>
              {when.lines.map((line) => <dd>{line}</dd>)}
              {when.seeAll && <dd><a href="#enroll">{when.seeAllLabel}</a></dd>}
            </div>
          ) : program.duration && (
            <div class="phero__wide"><dt>When</dt><dd>{program.duration}</dd></div>
          )}
          {places.length > 0 && (
            <div class="phero__wide">
              <dt>Where</dt>
              {places.map((l) => (
                <dd class="place">
                  {l.name}
                  <span class="place__addr">
                    {l.address.join(', ')} · <a href={l.mapUrl} rel="noopener">Map<span class="sr-only"> to {l.name}</span></a>
                  </span>
                </dd>
              ))}
            </div>
          )}
          <div>
            <dt>Cost</dt>
            <dd>
              {fromPrice ? priceLabel(fromPrice, priceSession) : partnerOnly ? 'Set by the school' : program.requestCta ? 'Ask us for rates' : 'Pricing TBA'}
              {program.fee && <span class="fee"> {feeLabel(program.fee)}</span>}
              {fromPrice?.note && fromPrice.amount > 0 && !sessionParts && <span class="fee"> · {fromPrice.note}</span>}
            </dd>
          </div>
          {program.teachers && (
            <div><dt>{program.teachers.length > 1 ? 'Teachers' : 'Teacher'}</dt><dd>{program.teachers.join(' & ')}</dd></div>
          )}
          {program.runs && (
            <div><dt>Runs</dt><dd>{program.runs}</dd></div>
          )}
          {program.showcase && (
            <div class="phero__wide"><dt>{performanceLabel(program.showcase)}</dt><dd>{program.showcase}</dd></div>
          )}
          {program.prerequisite && (
            <div class="phero__wide"><dt>Good to know</dt><dd>{program.prerequisite}</dd></div>
          )}
        </dl>
      </header>

      <aside class="enroll" id="enroll" aria-labelledby="enroll-title">
        <div class="enroll__card">
          {freeTrial && (
            <p class="enroll__trial">
              <span class="tape" data-gel="yellow">First class free</span>
              <span>New students try it free. Nothing is due until you decide to stay.</span>
            </p>
          )}
          {
            bookable.length > 0 ? (
              <form class="enroll__form" data-enroll-form>
                <h2 id="enroll-title">{comingSoon ? 'Upcoming dates' : 'Choose a time'}</h2>
                <fieldset>
                  <legend class="sr-only">Sessions for {program.title}</legend>
                  {bookable.map((s) => {
                    const href = s.status === 'coming-soon' ? '#notify' : enrollHref(program, s);
                    const { title, meta } = sessionLines(s, parts, locationById(s.locationId)?.shortName);
                    return (
                      <label class="opt">
                        <input
                          type="radio"
                          name="session"
                          value={s.id}
                          data-href={href}
                          data-label={enrollLabel(s)}
                          data-external={isExternal(href) ? '1' : undefined}
                          checked={s.id === firstOpen?.id}
                        />
                        <span class="opt__body">
                          <span class="opt__when script">{title}</span>
                          {meta && <span class="opt__meta">{meta}</span>}
                          <span class="opt__foot">
                            {parts.price && <strong>{sessionPrice(s)}</strong>}
                            <span class="status" data-status={s.status}>{spotsLabel(s)}</span>
                          </span>
                        </span>
                      </label>
                    );
                  })}
                </fieldset>
                {[...joining].map(([id, lines]) => lines && (
                  <div class="joining" data-joining-for={id} hidden={id !== firstOpen?.id}>
                    <p class="joining__title">Joining now, per student</p>
                    <ul>{lines.map((l) => <li>{l}</li>)}</ul>
                  </div>
                ))}
                {firstOpen && (
                  <a
                    class="btn btn--primary btn--block"
                    href={firstOpen.status === 'coming-soon' ? '#notify' : enrollHref(program, firstOpen)}
                    data-enroll-cta
                  >
                    <span data-enroll-cta-label>{firstOpen.status === 'coming-soon' ? 'Get notified' : enrollLabel(firstOpen) === 'Enroll' ? 'Continue to enrollment' : enrollLabel(firstOpen)}</span>
                    <span class="arrow" aria-hidden="true">→</span>
                  </a>
                )}
                {dropIns.filter((d) => d.listed).map((d) => (
                  <p class="enroll__drop-in" data-drop-in-for={d.s.id} hidden={d.s.id !== firstOpen?.id}>
                    <a href={`/drop-in/${d.s.id}`} data-drop-in-link>{d.label}</a>
                  </p>
                ))}
                <p class="enroll__note">
                  {partnerOnly
                    ? 'Registration for this program is handled by the school.'
                    : comingSoon
                        ? 'Registration opens soon.'
                        : `Next you’ll pick your student and pay in our family portal.${freeTrial ? ' New students’ first class is free.' : ''}${monthly ? ' Joining more than a week into the term? The first month is prorated to the classes left.' : ''}`}
                </p>
              </form>
            ) : datesSoon ? (
              <div class="enroll__form">
                {running ? (
                  <>
                    <h2 id="enroll-title">Sign-ups have closed</h2>
                    <p>{running.term} is in its last weeks, so it’s closed to new students. Leave your email and we’ll tell you as soon as the next dates open.</p>
                  </>
                ) : (
                  <>
                    <h2 id="enroll-title">Dates coming soon</h2>
                    <p>We announce {program.title.toLowerCase()} a few weeks ahead. Leave your email and we’ll tell you as soon as registration opens.</p>
                  </>
                )}
              </div>
            ) : (
              <div class="enroll__form">
                <h2 id="enroll-title">Book it</h2>
                <p>{program.kind === 'inclusive' ? 'Tell us a little about your participant and we’ll share the next dates.' : 'Scheduled around your family. Tell us what you have in mind and we’ll get back to you.'}</p>
                {program.requestCta && (
                  <a class="btn btn--primary btn--block" href={program.requestCta.href}>
                    {program.requestCta.label} <span class="arrow" aria-hidden="true">→</span>
                  </a>
                )}
              </div>
            )
          }
          {dropIns.filter((d) => !d.listed).map((d) => (
            <p class="enroll__drop-in">
              <a href={`/drop-in/${d.s.id}`} data-drop-in-link>{d.label}</a>
              {dropIns.length > 1 && <span class="enroll__drop-in-when">{sessionLines(d.s, parts, locationById(d.s.locationId)?.shortName).title}</span>}
            </p>
          ))}
          {(comingSoon || datesSoon) && (
            <form
              class="notify"
              id="notify"
              action="/api/leads"
              method="post"
              data-lead-form
              data-success-title="Got it!"
              data-success-body={`We’ll email you as soon as registration opens for ${program.title}.`}
            >
              <LeadFormFields kind="notify" program={program.slug} />
              <label for="notify-email">Get an email when registration opens</label>
              <div class="notify__row">
                <input class="input" id="notify-email" type="email" name="email" placeholder="you@example.com" autocomplete="email" required />
                <button class="btn btn--sm" type="submit">Notify me</button>
              </div>
            </form>
          )}
          <p class="enroll__help">Questions? <a href="/contact">Ask us</a> before you sign up.</p>
        </div>
      </aside>

      <div class="pbody__main">
        <section class="stack" aria-labelledby="about-title">
          <h2 id="about-title">About this {program.kind === 'camp' ? 'camp' : program.kind === 'class' ? 'class' : 'program'}</h2>
          <div class="prose">{program.description.map((para) => <p set:html={rich(para, vars)} />)}</div>
        </section>

        <section class="stack" aria-labelledby="skills-title">
          <h2 id="skills-title">{highlightsHeading(program)}</h2>
          <ul class="skills">
            {program.highlights.map((h, i) => <li class="tape tape--lg" data-tilt={i % 2 ? 'right' : undefined}>{h}</li>)}
          </ul>
        </section>

        {money.length > 0 && (
          <section class="money" aria-labelledby="money-title">
            <h2 id="money-title">{money.some((l) => l === 'multi' || l === 'monthly' || l === 'pay-what-you-can') ? 'Pricing & discounts' : 'Pricing'}</h2>
            <ul>
              {money.map((line) => (
                <li>
                  {line === 'school' && <><strong>Set by the school.</strong> The school handles registration and payment for this class.</>}
                  {line === 'free' && <><strong>Free.</strong> There’s nothing to pay; just sign up for the date you’d like.</>}
                  {line === 'trial' && <><strong>First class free.</strong> New students can try it before paying: choose “Try the first class free” when you enroll. Nothing is due until you decide to stay.</>}
                  {line === 'monthly' && <><strong>Monthly or up front.</strong> Pay monthly, or pay for the season in full and save 10%.</>}
                  {line === 'fee' && program.fee && <><strong>One-time {program.fee.label}: ${program.fee.amount}.</strong> It covers extra rehearsal time, costumes, props and space for the show.</>}
                  {line === 'per-child' && children && <><strong>${children.first} for the first child, ${children.additional} for each additional child</strong> on the same night.</>}
                  {line === 'per-night' && fromPrice && <><strong>${fromPrice.amount} a night.</strong> Sign up for just the nights you want.</>}
                  {line === 'multi' && <><strong>15% off</strong> for multiple students or multiple classes.</>}
                  {line === 'pay-what-you-can' && <><strong>Pay-what-you-can is available.</strong> <a href="/contact?topic=scholarship">Ask us privately</a>; we never want cost to keep a student from joining.</>}
                </li>
              ))}
            </ul>
          </section>
        )}

        {relevantFaqs.length > 0 && (
          <section class="stack" aria-labelledby="faq-title">
            <h2 id="faq-title">{isAdult(program) ? 'Questions people ask' : 'Questions parents ask'}</h2>
            <FaqList items={relevantFaqs} />
            <p><a href="/faq">All FAQs</a></p>
          </section>
        )}
      </div>

    </div>

    {related.length > 0 && (
      <section class="section section--hall" aria-labelledby="related-title">
        <div class="wrap">
          <h2 id="related-title" class="related__title">You might also like</h2>
          <div class="grid" style="--min: 280px">
            {related.map((p) => <ProgramCard program={p} />)}
          </div>
        </div>
      </section>
    )}
  </article>

  {
    firstOpen && (
      <div class="mobile-enroll">
        <span>
          <strong>{sessionParts ? sessionParts.total : fromPrice ? priceLabel(fromPrice, priceSession) : 'Pick a time'}</strong>
          <span class="script">{sessionParts ? `${sessionParts.perClass} · ` : ''}{ageLabel(program.ages, program.agesLabel)}</span>
        </span>
        <a class="btn btn--primary btn--sm" href="#enroll">{comingSoon ? 'See dates' : 'Choose a time'}</a>
      </div>
    )
  }
</Base>

<script>
  // Keep the main button in sync with the chosen session.
  document.querySelectorAll<HTMLFormElement>('[data-enroll-form]').forEach((form) => {
    const cta = form.querySelector<HTMLAnchorElement>('[data-enroll-cta]');
    const label = form.querySelector<HTMLElement>('[data-enroll-cta-label]');
    if (!cta || !label) return;
    form.addEventListener('change', () => {
      const picked = form.querySelector<HTMLInputElement>('input[name="session"]:checked');
      if (!picked) return;
      form.querySelectorAll<HTMLElement>('[data-joining-for]').forEach((el) => (el.hidden = el.dataset.joiningFor !== picked.value));
      form.querySelectorAll<HTMLElement>('[data-drop-in-for]').forEach((el) => (el.hidden = el.dataset.dropInFor !== picked.value));
      cta.href = picked.dataset.href ?? '#';
      const text = picked.dataset.label ?? 'Enroll';
      label.textContent = text === 'Enroll' ? 'Continue to enrollment' : text;
      if (picked.dataset.external) cta.rel = 'noopener';
      else cta.removeAttribute('rel');
    });
  });
</script>

<style>
  /* The summary on the left, the card beside it (and beside the rest of the page) on desktop. */
  .ppage { background: linear-gradient(180deg, var(--gel-tint), var(--paper) 560px); }
  .ppage__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 380px;
    grid-template-areas: 'head card' 'body card';
    column-gap: var(--space-2xl);
    row-gap: var(--space-2xl);
    align-items: start;
    padding-block: var(--space-xl) var(--space-3xl);
  }
  .phero { grid-area: head; }
  .phero h1 { font-size: var(--step-5); }
  .crumbs { display: flex; gap: 0.5rem; font-size: var(--step--1); color: var(--ink-mute); }
  .crumbs a { color: var(--ink-soft); }
  .phero__tags { display: flex; flex-wrap: wrap; gap: 0.6rem; }
  .phero__tags .tape { --tape: var(--gel); }
  .phero__tags .tape--quiet { --tape: var(--paper); box-shadow: inset 0 0 0 2px var(--gel); }
  .phero__facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9.5rem, 1fr));
    gap: 1rem 1.5rem;
    margin: 0;
    padding-top: var(--space-m);
    border-top: 2px solid var(--ink);
  }
  .phero__facts dt { font-family: var(--font-script); font-weight: 700; font-size: var(--step--1); text-transform: uppercase; letter-spacing: 0.04em; color: var(--gel-ink); }
  .phero__facts dd { margin: 0.2rem 0 0; font-weight: 600; }
  .phero__facts .phero__wide { grid-column: span 2; }
  .place__addr { display: block; font-weight: 400; color: var(--ink-soft); }
  .phero__facts .fee { font-weight: 400; color: var(--ink-soft); }

  .pbody__main { grid-area: body; display: grid; gap: var(--space-2xl); align-content: start; }
  .pbody__main h2 { font-size: var(--step-3); }
  .skills { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.8rem 1rem; }
  .skills .tape { --tape: var(--gel-tint); --tape-on: var(--ink); white-space: normal; }
  .money { padding: var(--space-xl); background: var(--hall); border-radius: var(--r-lg); display: grid; gap: var(--space-m); }
  .money h2 { font-size: var(--step-2); }
  .money ul { margin: 0; padding: 0; list-style: none; display: grid; gap: 0.7rem; }
  .money li { padding-left: 1.6rem; position: relative; color: var(--ink-soft); }
  .money li::before { content: '★'; position: absolute; left: 0; color: var(--gel-ink); }
  .money strong { color: var(--ink); }

  .enroll { grid-area: card; position: sticky; top: 96px; }
  .enroll__card {
    display: grid;
    gap: var(--space-m);
    padding: var(--space-l);
    background: var(--paper);
    border: 2px solid var(--ink);
    border-radius: var(--r-lg);
    box-shadow: 8px 8px 0 var(--gel);
  }
  .enroll__form { display: grid; gap: var(--space-m); }
  .enroll__trial { display: grid; justify-items: start; gap: 0.4rem; margin: 0 0 var(--space-m); padding-bottom: var(--space-m); border-bottom: 1.5px dashed var(--line-strong); font-size: var(--step--1); color: var(--ink-soft); }
  .enroll h2 { font-size: var(--step-2); }
  .enroll fieldset { border: 0; margin: 0; padding: 0; display: grid; gap: 0.6rem; }
  .opt { position: relative; display: block; cursor: pointer; }
  .opt input { position: absolute; opacity: 0; }
  .opt__body {
    display: grid;
    gap: 0.2rem;
    padding: 0.8rem 0.95rem 0.8rem 2.6rem;
    border: 2px solid var(--line-strong);
    border-radius: var(--r-md);
    transition: border-color 140ms, background 140ms;
  }
  .opt__body::before {
    content: '';
    position: absolute;
    left: 0.9rem;
    top: 1.05rem;
    width: 1.05rem;
    height: 1.05rem;
    border-radius: 50%;
    border: 2px solid var(--ink-mute);
    background: var(--paper);
  }
  .opt:hover .opt__body { border-color: var(--ink); }
  .opt input:checked + .opt__body { border-color: var(--ink); background: var(--gel-tint); }
  .opt input:checked + .opt__body::before { border-color: var(--ink); box-shadow: inset 0 0 0 3.5px var(--paper); background: var(--ink); }
  .opt input:focus-visible + .opt__body { outline: 3px solid var(--focus); outline-offset: 2px; }
  .opt__when { font-weight: 700; }
  .opt__meta { font-size: var(--step--1); color: var(--ink-soft); }
  .opt__foot { display: flex; justify-content: space-between; align-items: baseline; gap: 0.5rem; margin-top: 0.2rem; }
  .opt__foot strong { font-family: var(--font-display); font-size: 1.1rem; }
  .joining { display: grid; gap: 0.3rem; padding: 0.75rem 0.9rem; background: var(--hall); border-radius: var(--r-md); font-size: var(--step--1); }
  .joining[hidden] { display: none; }
  .joining__title { font-weight: 700; color: var(--ink); }
  .joining ul { margin: 0; padding-left: 1.1rem; display: grid; gap: 0.25rem; color: var(--ink-soft); }
  .enroll__drop-in { margin: 0; text-align: center; font-size: var(--step--1); }
  .enroll__drop-in a { display: inline-flex; align-items: center; min-height: 44px; color: var(--ink-soft); }
  .enroll__drop-in-when { display: block; color: var(--ink-mute); }
  .enroll__note, .enroll__help { font-size: var(--step--1); color: var(--ink-soft); }
  .enroll__help { padding-top: var(--space-s); border-top: 1.5px dashed var(--line-strong); }
  .notify { display: grid; gap: 0.5rem; padding-top: var(--space-s); border-top: 1.5px dashed var(--line-strong); }
  .notify label { font-weight: 650; font-size: var(--step--1); }
  .notify__row { display: flex; gap: 0.5rem; }
  .notify__row .input { min-width: 0; flex: 1; }

  .related__title { font-size: var(--step-3); margin-bottom: var(--space-xl); }

  .mobile-enroll { display: none; }

  @media (max-width: 960px) {
    .ppage__grid { grid-template-columns: minmax(0, 1fr); grid-template-areas: 'head' 'card' 'body'; row-gap: var(--space-xl); }
    .phero__facts .phero__wide { grid-column: 1 / -1; }
    .enroll { position: static; }
    .mobile-enroll {
      position: fixed;
