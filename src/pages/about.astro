---
/**
 * About: the story first, then the plain facts (what we do, what's
 * different, who it's for, how it works, key facts, FAQ) that families skim
 * and that search engines and AI assistants quote. The team and the schools
 * have their own pages (/about/team, /about/schools); cards here link to them.
 * The text is edited at /admin/content/pages/about; facts like prices and the
 * team size are filled in from the rest of the site's content, so they can't drift.
 */
import Base from '@/layouts/Base.astro';
import PhotoFrame from '@/components/PhotoFrame.astro';
import JourneySteps from '@/components/JourneySteps.astro';
import { href, rich } from '@/content/rich';

const { programBySlug, faq, site, vars, pages } = Astro.locals.content;
const page = pages.about;
const { team: teamPage, schools: schoolsPage } = pages;
const aboutFaqs = page.faq.questions.map((id) => faq(id)).filter((f) => f !== undefined);
---

<Base
  title="About Little Characters"
  description={`Little Characters is a children’s theater in Athens, Georgia, founded in ${site.founded} by ${site.founder}: weekly classes, camps and shows for ages 4 and up.`}
  seo={page.seo}
  image={page.hero.photo}
  edit="/admin/content/pages/about"
>
  <script is:inline>
    // The team and schools used to be sections of this page. Links to them
    // (/about#team, /about#schools) go to their own pages now. The server never
    // sees the part after #, so this is done here.
    {
      const to = { '#team': '/about/team', '#schools': '/about/schools' }[location.hash];
      if (to) location.replace(to);
    }
  </script>
  <section class="about-hero">
    <div class="wrap about-hero__grid">
      <div class="stack" style="--stack: var(--space-l)">
        {page.hero.eyebrow && <p class="eyebrow">{page.hero.eyebrow}</p>}
        <h1 set:html={rich(page.hero.headline, vars)} />
        <p class="about-hero__what" set:html={rich(page.hero.summary, vars)} />
        <div class="prose lede-prose">
          {page.hero.story.map((para) => <p set:html={rich(para, vars)} />)}
        </div>
      </div>
      <PhotoFrame shape="arch" ratio="4 / 5" gel="red" class="about-hero__photo" eager sizes="(max-width: 960px) 70vw, 400px" image={page.hero.photo} />
    </div>
  </section>

  <section class="section section--hall" aria-labelledby="does-title">
    <div class="wrap">
      <div class="section-head">
        {page.services.eyebrow && <p class="eyebrow">{page.services.eyebrow}</p>}
        <h2 id="does-title">{page.services.heading}</h2>
      </div>
      <ul class="services">
        {
          page.services.items.map((s) => (
            <li class="service" data-gel={s.gel}>
              <h3>{s.title}</h3>
              <p set:html={rich(s.body, vars)} />
              <a class="link-arrow" href={href(s.link.href, vars)}>
                {s.link.label} <span aria-hidden="true">→</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="different-title">
    <div class="wrap different">
      <div class="different__side">
        <div class="section-head">
          {page.differences.eyebrow && <p class="eyebrow">{page.differences.eyebrow}</p>}
          <h2 id="different-title">{page.differences.heading}</h2>
        </div>
        {page.differences.photo && <PhotoFrame shape="rounded" ratio="3 / 2" gel="teal" sizes="(max-width: 960px) 100vw, 480px" image={page.differences.photo} />}
      </div>
      <ol class="differences">
        {
          page.differences.items.map((d) => (
            <li>
              <h3>{d.title}</h3>
              <p set:html={rich(d.body, vars)} />
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section section--hall" aria-labelledby="who-title">
    <div class="wrap">
      <div class="section-head">
        {page.audiences.eyebrow && <p class="eyebrow">{page.audiences.eyebrow}</p>}
        <h2 id="who-title">{page.audiences.heading}</h2>
        {page.audiences.lede && <p class="lede" set:html={rich(page.audiences.lede, vars)} />}
      </div>
      <ul class="audiences">
        {
          page.audiences.items.map((a) => {
            const links = [
              ...(a.programs ?? [])
                .map((slug) => programBySlug(slug))
                .filter((p) => p !== undefined)
                .map((p) => ({ label: p.title, href: `/programs/${p.slug}` })),
              ...(a.links ?? []).map((l) => ({ label: l.label, href: href(l.href, vars) })),
            ];
            return (
              <li class="audience" data-gel={a.gel}>
                <span class="tape">{a.label}</span>
                <p set:html={rich(a.body, vars)} />
                {links.length > 0 && (
                  <p class="audience__links">
                    {links.map((l, i) => (
                      <>
                        {i > 0 && <span aria-hidden="true"> · </span>}
                        <a href={l.href}>{l.label}</a>
                      </>
                    ))}
                  </p>
                )}
              </li>
            );
          })
        }
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="mission-title">
    <div class="wrap">
      <div class="section-head">
        {page.beliefs.eyebrow && <p class="eyebrow">{page.beliefs.eyebrow}</p>}
        <h2 id="mission-title">{page.beliefs.heading}</h2>
        {page.beliefs.lede && <p class="lede" set:html={rich(page.beliefs.lede, vars)} />}
      </div>
      <h3 class="values__title">{page.beliefs.valuesHeading}</h3>
      <ul class="values">
        {
          page.beliefs.values.map((v) => (
            <li class="value" data-gel={v.gel}>
              <h4>{v.title}</h4>
              <p set:html={rich(v.body, vars)} />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section more-about-band" aria-label="More about us">
    <div class="wrap more-about">
      {
        [
          { part: teamPage.team, href: '/about/team', label: 'Meet the team', gel: 'teal' },
          { part: schoolsPage.schools, href: '/about/schools', label: 'Schools & partners', gel: 'purple' },
        ].map((c) => (
          <article class="more-card" data-gel={c.gel}>
            {c.part.eyebrow && <p class="eyebrow">{c.part.eyebrow}</p>}
            <h2>
              <a href={c.href}>{c.part.heading}</a>
            </h2>
            {c.part.lede && <p set:html={rich(c.part.lede, vars)} />}
            <span class="link-arrow" aria-hidden="true">
              {c.label} →
            </span>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section section--hall" aria-labelledby="how-title">
    <div class="wrap">
      <div class="section-head">
        {page.how.eyebrow && <p class="eyebrow">{page.how.eyebrow}</p>}
        <h2 id="how-title">{page.how.heading}</h2>
      </div>
      <JourneySteps />
      <ul class="how-notes">
        {
          page.how.notes.map((n) => (
            <li>
              <h3>{n.title}</h3>
              <p set:html={rich(n.body, vars)} />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="facts-title">
    <div class="wrap facts-wrap">
      <div class="section-head">
        {page.facts.eyebrow && <p class="eyebrow">{page.facts.eyebrow}</p>}
        <h2 id="facts-title">{page.facts.heading}</h2>
      </div>
      <dl class="key-facts">
        {
          page.facts.items.map((f) => (
            <div>
              <dt>{f.label}</dt>
              <dd set:html={rich(f.text, vars)} />
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  {
    aboutFaqs.length > 0 && (
      <section class="section section--hall" aria-labelledby="about-faq-title">
        <div class="wrap">
          <div class="section-head section-head--split">
            <h2 id="about-faq-title">{page.faq.heading}</h2>
            <a class="link-arrow" href="/faq">
              All questions <span aria-hidden="true">→</span>
            </a>
          </div>
          <div class="about-faqs">
            {aboutFaqs.map((f) => (
              <div>
                <h3>{f.q}</h3>
                <p set:html={rich(f.a, vars)} />
              </div>
            ))}
          </div>
        </div>
      </section>
    )
  }
</Base>

<style>
  .about-hero { padding-block: var(--space-2xl); }
  .about-hero__grid { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr); gap: var(--space-2xl); align-items: center; }
  .about-hero :global(.about-hero__photo) { width: 100%; max-width: 400px; justify-self: end; }
  .about-hero__what { font-size: var(--step-1); line-height: 1.5; max-width: var(--measure); padding-left: var(--space-m); border-left: 6px solid var(--red); }
  .lede-prose p { font-size: var(--step-1); line-height: 1.55; color: var(--ink-soft); }

  .services { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr)); gap: var(--space-m); }
  .service { display: grid; grid-template-rows: auto 1fr auto; gap: 0.6rem; padding: var(--space-l); background: var(--paper); border-radius: var(--r-md); border-top: 8px solid var(--gel); }
  .service h3 { font-size: var(--step-1); font-stretch: 92%; }
  .service p { color: var(--ink-soft); }
  .service .link-arrow { justify-self: start; margin-top: 0.4rem; }

  .different { display: grid; grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr); gap: var(--space-2xl); align-items: start; }
  .different__side { position: sticky; top: calc(76px + var(--space-l)); }
  .different__side .section-head { margin-bottom: var(--space-l); }
  .differences { list-style: none; margin: 0; padding: 0; counter-reset: diff; display: grid; gap: var(--space-l); }
  .differences li { counter-increment: diff; display: grid; grid-template-columns: 2.6rem 1fr; column-gap: var(--space-m); row-gap: 0.35rem; padding-bottom: var(--space-l); border-bottom: 1.5px solid var(--line-strong); }
  .differences li:last-child { border-bottom: 0; padding-bottom: 0; }
  .differences li::before {
    content: counter(diff);
    grid-row: span 2;
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 50%;
    background: var(--ink);
    color: var(--paper);
    font-family: var(--font-display);
    font-weight: 750;
  }
  .differences h3 { font-size: var(--step-1); font-stretch: 92%; align-self: center; }
  .differences p { color: var(--ink-soft); }

  .audiences { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr)); gap: var(--space-m); }
  .audience { display: grid; grid-template-rows: auto 1fr auto; gap: 0.7rem; align-content: start; padding: var(--space-l); background: var(--paper); border-radius: var(--r-md); }
  .audience p { color: var(--ink-soft); }
  .audience__links { font-family: var(--font-display); font-weight: 700; font-stretch: 92%; }
  .audience__links a { color: var(--ink); text-decoration-color: var(--gel); text-decoration-thickness: 2px; text-underline-offset: 3px; }

  .values__title { font-size: var(--step-2); margin-bottom: var(--space-l); }
  .values { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--space-m); }
  .value { flex: 1 1 12rem; display: grid; gap: 0.5rem; align-content: start; padding: var(--space-l); background: var(--hall); border-radius: var(--r-md); border-top: 8px solid var(--gel); }
  .value h4 { font-size: var(--step-1); font-stretch: 90%; }
  .value p { color: var(--ink-soft); font-size: var(--step--1); }

  .more-about { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr)); gap: var(--space-l); }
  .more-about-band { padding-top: 0; }
  .more-card { position: relative; display: grid; gap: 0.6rem; align-content: start; padding: var(--space-xl); background: var(--hall); border-radius: var(--r-lg); border-top: 8px solid var(--gel); }
  .more-card h2 { font-size: var(--step-3); }
  .more-card h2 a { color: var(--ink); text-decoration: none; }
  .more-card h2 a::after { content: ''; position: absolute; inset: 0; border-radius: inherit; }
  .more-card h2 a:focus-visible { outline: none; }
  .more-card:has(h2 a:focus-visible) { outline: 3px solid var(--focus); outline-offset: 3px; }
  .more-card:hover { box-shadow: var(--shadow-lift); }
  .more-card p:not(.eyebrow) { color: var(--ink-soft); }
  .more-card .link-arrow { justify-self: start; margin-top: 0.4rem; }

  .how-notes { list-style: none; margin: var(--space-2xl) 0 0; padding: var(--space-xl) 0 0; border-top: 2px solid var(--ink); display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr)); gap: var(--space-l); }
  .how-notes li { display: grid; gap: 0.4rem; align-content: start; }
  .how-notes h3 { font-size: var(--step-1); font-stretch: 92%; }
  .how-notes p { color: var(--ink-soft); }

  .key-facts { margin: 0; border-top: 2px solid var(--ink); }
  .key-facts > div { display: grid; grid-template-columns: minmax(8rem, 0.3fr) 1fr; gap: var(--space-m); padding: 0.85rem 0.25rem; border-bottom: 1.5px solid var(--line-strong); }
  .key-facts dt { font-family: var(--font-display); font-weight: 700; font-stretch: 92%; }
  .key-facts dd { margin: 0; color: var(--ink-soft); }

  .about-faqs { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 26rem), 1fr)); gap: var(--space-xl) var(--space-2xl); }
  .about-faqs div { display: grid; gap: 0.5rem; align-content: start; }
  .about-faqs h3 { font-size: var(--step-1); font-stretch: 92%; }
  .about-faqs p { color: var(--ink-soft); }

  @media (max-width: 960px) {
    .about-hero__grid, .different { grid-template-columns: 1fr; }
    .about-hero :global(.about-hero__photo) { justify-self: start; max-width: 300px; order: -1; }
    .different__side { position: static; }
  }
  @media (max-width: 520px) {
    .key-facts > div { grid-template-columns: 1fr; gap: 0.2rem; }
  }
</style>
