---
import Base from '@/layouts/Base.astro';
import Character from '@/components/Character.astro';
import { site } from '@/config/site';

// What a gift covers, using real Fall 2026 prices.
const impact = [
  { amount: '$30', what: 'A student’s performance fee, so they can be in the show', gel: 'yellow' },
  { amount: '$95', what: 'A month of Intro to Theater or Yes, And… Improv', gel: 'teal' },
  { amount: '$160', what: 'All 8 weeks of Stories and Songs for a 4- to 6-year-old', gel: 'red' },
  { amount: '$250', what: 'A full week of summer camp, snacks and materials included', gel: 'purple' },
] as const;

// "How can I support LC?", from the FAQ page.
const ways = [
  { title: 'Volunteer', body: 'Help with classes, camps, shows or events.', href: `mailto:${site.contact.email}?subject=Volunteering`, label: 'Email us' },
  { title: 'Donate costumes & props', body: 'Costumes, props and set pieces all find a home on our stage.', href: `mailto:${site.contact.email}?subject=Donation`, label: 'Email us' },
  { title: 'Shop our wish list', body: 'Pick up something we need from our Amazon Wish List.', href: site.wishListUrl, label: 'See the wish list' },
  { title: 'Become a sponsor', body: 'Local businesses help keep our programs going. Let’s talk.', href: '/contact?topic=general', label: 'Get in touch' },
];
---

<Base title="Give" description="Support the Little Characters scholarship fund so any kid in Athens can take the stage.">
  <section class="give-hero">
    <div class="wrap give-hero__grid">
      <div class="stack" style="--stack: var(--space-l)">
        <p class="eyebrow">The scholarship fund</p>
        <h1>Help a kid take the stage.</h1>
        <p class="lede">
          Donations to Little Characters go directly to supporting our programs. Your gift gives kids in the Athens area a safe place to express themselves and step into the world of theater, and lets us offer pay-what-you-can rates to any family who needs them.
        </p>
        <div class="give-hero__ctas">
          <a class="btn btn--primary" href={site.givingUrl} rel="noopener">Give now <span class="arrow" aria-hidden="true">→</span></a>
          <a class="btn btn--outline" href="/contact?topic=scholarship">Ask about a scholarship</a>
        </div>
      </div>
      <div class="give-hero__cast" aria-hidden="true">
        <Character name="royal" size={130} />
        <Character name="dancer" size={100} />
      </div>
    </div>
  </section>

  <section class="section section--hall" aria-labelledby="impact-title">
    <div class="wrap">
      <h2 id="impact-title" class="impact__title">What your gift covers</h2>
      <ul class="impact">
        {
          impact.map((x) => (
            <li data-gel={x.gel}>
              <span class="impact__amount">{x.amount}</span>
              <span>{x.what}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="ways-title">
    <div class="wrap">
      <h2 id="ways-title" class="impact__title">Other ways to help</h2>
      <ul class="ways">
        {
          ways.map((w) => (
            <li>
              <h3>{w.title}</h3>
              <p>{w.body}</p>
              <a class="link-arrow" href={w.href} rel={w.href.startsWith('http') ? 'noopener' : undefined}>{w.label}</a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section section--tight section--hall">
    <div class="wrap wrap--narrow stack" style="--stack: var(--space-l)">
      <h2>Need a scholarship?</h2>
      <p class="lede">
        We never want cost to keep a student from joining our programs, and we’re happy to arrange a pay-what-you-can rate. Email <a href={`mailto:${site.contact.email}?subject=Scholarship`}>{site.contact.email}</a> for the scholarship application.
      </p>
    </div>
  </section>
</Base>

<style>
  .give-hero { padding-block: var(--space-3xl) var(--space-2xl); background: linear-gradient(180deg, var(--red-tint), var(--paper)); overflow: hidden; }
  .give-hero__grid { display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(0, 0.7fr); gap: var(--space-2xl); align-items: end; }
  .give-hero__ctas { display: flex; flex-wrap: wrap; gap: 0.75rem; }
  .give-hero__cast { display: flex; justify-content: center; align-items: flex-end; gap: 0.5rem; }
  .impact__title { font-size: var(--step-3); margin-bottom: var(--space-xl); }
  .impact { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--space-m); }
  .impact li { display: grid; gap: 0.5rem; align-content: start; padding: var(--space-l); background: var(--paper); border-radius: var(--r-lg); border-bottom: 8px solid var(--gel); color: var(--ink-soft); }
  .impact__amount { font-family: var(--font-display); font-weight: 800; font-stretch: 75%; font-size: var(--step-4); line-height: 1; color: var(--gel-ink); }
  .ways { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--space-l); }
  .ways li { display: grid; gap: 0.5rem; align-content: start; padding-top: var(--space-m); border-top: 2px solid var(--ink); }
  .ways h3 { font-size: var(--step-1); }
  .ways p { color: var(--ink-soft); }
  .ways .link-arrow { justify-self: start; }
  @media (max-width: 900px) {
    .give-hero__grid { grid-template-columns: 1fr; }
    .give-hero__cast { justify-content: flex-start; }
    .impact, .ways { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 480px) { .impact, .ways { grid-template-columns: 1fr; } }
</style>
