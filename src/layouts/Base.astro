---
import '@/styles/global.css';
import SiteHeader from '@/components/SiteHeader.astro';
import SiteFooter from '@/components/SiteFooter.astro';
import StaffBar from '@/components/StaffBar.astro';
import { href, rich } from '@/content/rich';
import type { ImageRef, Seo } from '@/content/types';
import { shareImage } from '@/lib/media';
import { jsonLd, organizationLd, pageTitle } from '@/lib/seo';

interface Props {
  title?: string;
  description?: string;
  /** Search-engine title, description and share photo set in the editor; they win over the page's own. */
  seo?: Seo;
  /** The page's main photo, for link previews. Pages without one use the home page's photo. */
  image?: ImageRef;
  /** More structured data for this page (see src/lib/seo.ts). */
  structuredData?: unknown[];
  /** Pages that paint their own first band set this to skip the default top spacing. */
  bleed?: boolean;
  /** Keep portal pages out of search engines. */
  noindex?: boolean;
  /** Where staff edit this page's content (shows an "Edit this page" button to them). */
  edit?: string;
  /** Staff pages have their own navigation. */
  staffBar?: boolean;
}

const { site, vars, locations, locationById, pages, uploads } = Astro.locals.content;
const { seo, noindex = false, edit, staffBar = true, structuredData = [] } = Astro.props;
const title = seo?.title || Astro.props.title;
const description = seo?.description || Astro.props.description || site.description;
const hq = locationById('hq');
const announcement = site.announcement?.show && site.announcement.text ? site.announcement : undefined;
const fullTitle = pageTitle(title, site);
const origin = Astro.site ?? site.url;
const canonical = new URL(Astro.url.pathname, origin).href;
// The site's default photo: the home page's, or the cast photo it started with.
const fallbackPhoto: ImageRef = { src: 'builtin:photos/cast-silly-faces', alt: 'A cast of campers and counselors making silly faces after a show', position: '45% 40%' };
const siteImage = shareImage(pages.home.hero.photo, uploads) ?? shareImage(fallbackPhoto, uploads);
const ogImage = shareImage(seo?.image, uploads) ?? shareImage(Astro.props.image, uploads) ?? siteImage;
const ogImageUrl = ogImage && new URL(ogImage.src, origin).href;
const organization = organizationLd({
  site,
  locations,
  hq,
  logo: new URL('/apple-touch-icon.png', site.url).href,
  image: siteImage && new URL(siteImage.src, site.url).href,
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#ffffff" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_US" />
    {
      ogImage && (
        <>
          <meta property="og:image" content={ogImageUrl} />
          <meta property="og:image:type" content="image/jpeg" />
          <meta property="og:image:width" content={String(ogImage.width)} />
          <meta property="og:image:height" content={String(ogImage.height)} />
          {ogImage.alt && <meta property="og:image:alt" content={ogImage.alt} />}
        </>
      )
    }
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <script type="application/ld+json" set:html={jsonLd(organization)} />
    {structuredData.map((data) => <script type="application/ld+json" set:html={jsonLd(data)} />)}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    {staffBar && <StaffBar edit={edit} />}
    {
      announcement && (
        <div class="announce" data-gel={announcement.gel ?? 'yellow'} role="note">
          <p>
            <span set:html={rich(announcement.text, vars)} />
            {announcement.link?.label && (
              <a href={href(announcement.link.href, vars)}>
                {announcement.link.label} <span aria-hidden="true">→</span>
              </a>
            )}
          </p>
        </div>
      )
    }
    {
      site.preview && (
        <div class="preview-banner" role="note">
          <span class="tape tape--ink" data-tilt="flat">Design preview</span>
          <span>
            Preview of the new site<span class="preview-banner__long">, with classes, prices and dates copied from littlecharacters.org on Sep 25, 2026</span>.
          </span>
        </div>
      )
    }
    <SiteHeader />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>

<script>
  // Lead forms (contact, signups, "notify me"): send in the background and show
  // the confirmation right where the form was. Without JavaScript they post
  // normally and land on /thanks.
  for (const form of document.querySelectorAll<HTMLFormElement>('form[data-lead-form]')) {
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      let error = form.querySelector<HTMLElement>('[data-lead-error]');
      if (!error) {
        error = document.createElement('p');
        error.dataset.leadError = '';
        error.className = 'lead-error';
        error.setAttribute('role', 'alert');
        form.append(error);
      }
      error.textContent = '';
      if (button) button.disabled = true;
      try {
        const res = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { accept: 'application/json' } });
        const data = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(data.message || 'Sorry, that didn’t go through. Please try again, or email us directly.');
        const done = document.createElement('div');
        done.className = 'lead-done';
        done.setAttribute('role', 'status');
        done.tabIndex = -1;
        const title = document.createElement('strong');
        title.textContent = form.dataset.successTitle ?? 'Thank you!';
        const body = document.createElement('span');
        body.textContent = form.dataset.successBody ?? 'We got it.';
        done.append(title, body);
        form.replaceChildren(done);
        form.classList.add('lead-form--done');
        done.focus();
      } catch (e) {
        error.textContent = (e as Error).message;
        if (button) button.disabled = false;
      }
    });
  }
</script>

<style>
  .announce {
    padding: 0.55rem var(--gutter);
    background: var(--gel);
    color: var(--gel-on);
    text-align: center;
    font-weight: 600;
  }
  .announce p { margin: 0 auto; max-width: 70ch; display: flex; flex-wrap: wrap; justify-content: center; gap: 0.25rem 0.75rem; }
  .announce :global(a) { color: inherit; font-weight: 700; text-underline-offset: 0.2em; }
  .preview-banner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.4rem 0.8rem;
    padding: 0.5rem var(--gutter);
    background: var(--orange);
    color: var(--ink);
    font-size: var(--step--1);
    text-align: center;
  }
  .preview-banner .tape { --tape: var(--ink); color: var(--orange); }
  @media (max-width: 640px) {
    .preview-banner { font-size: 0.78rem; flex-wrap: nowrap; text-align: left; padding-block: 0.4rem; }
    .preview-banner__long { display: none; }
  }
</style>
