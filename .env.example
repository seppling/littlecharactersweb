# Copy to .env for local development. Never commit real values.
# In production, set these in your host's environment settings.

# Anything other than "development" is treated as production (the safe default).
APP_ENV=development

SITE_URL=http://localhost:4321

# Postgres (Neon recommended). Leave empty in dev to use embedded PGlite in .data/
DATABASE_URL=

# openssl rand -base64 32
BETTER_AUTH_SECRET=
# openssl rand -base64 32  (encrypts allergy/medical notes at rest)
DATA_ENCRYPTION_KEY=

# Emails that can see the admin roster
ADMIN_EMAILS=littlecharacterstheater@gmail.com

# Stripe TEST keys while building (sk_test_…, pk_test_…). Without them, checkout
# uses a clearly labeled local test-payment step.
STRIPE_SECRET_KEY=
PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Transactional email (sign-in codes, confirmations). Without it, emails go to
# the dev mailbox at /dev/mailbox.
RESEND_API_KEY=
EMAIL_FROM="Little Characters <hello@littlecharacters.org>"
# Where replies to portal emails go.
EMAIL_REPLY_TO=littlecharacterstheater@gmail.com
